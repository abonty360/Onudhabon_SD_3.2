@model Onudhabon_ISD.Models.DonationInitiateViewModel

@{
    ViewData["Title"] = "Donate to Onudhabon - Support Underprivileged Education in Bangladesh";
    var recentDonations = (List<Onudhabon_ISD.Models.Donation>?)ViewBag.RecentDonations ?? new List<Onudhabon_ISD.Models.Donation>();
    decimal totalDonated = (decimal)(ViewBag.TotalDonated ?? 0m);
    int totalDonorsCount = (int)(ViewBag.TotalDonorsCount ?? 0);
}

<!-- Hero Section -->
<section class="py-5 text-white position-relative" style="background: linear-gradient(135deg, #0b1329 0%, #0f172a 45%, #1e3a8a 100%);">
    <div class="container py-4">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1.5 rounded-pill bg-white bg-opacity-10 border border-white border-opacity-15 text-white small fw-semibold mb-3">
                    <i class="bi bi-shield-check text-info"></i>
                    <span>Onudhabon Educational Philanthropy & Welfare Foundation</span>
                </div>
                <h1 class="display-5 fw-bold mb-3 tracking-tight" style="letter-spacing: -0.02em;">Support Educational Equity Across Bangladesh</h1>
                <p class="lead text-light mb-4" style="opacity: 0.92; font-size: 1.05rem; line-height: 1.65;">
                    Your philanthropic contributions directly finance accredited textbooks, certified educator stipends, community classroom infrastructure, and digital learning devices for underprivileged students.
                </p>
                <div class="d-flex flex-wrap gap-3 text-white-50 small">
                    <div class="d-flex align-items-center gap-2 bg-white bg-opacity-10 px-3 py-2 rounded-pill border border-white border-opacity-10">
                        <i class="bi bi-bank text-info fs-6"></i>
                        <span class="text-white fw-semibold">৳@totalDonated.ToString("N0") BDT Contributed</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 bg-white bg-opacity-10 px-3 py-2 rounded-pill border border-white border-opacity-10">
                        <i class="bi bi-people-fill text-info fs-6"></i>
                        <span class="text-white fw-semibold">@totalDonorsCount Verified Benefactors</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 bg-white bg-opacity-10 px-3 py-2 rounded-pill border border-white border-opacity-10">
                        <i class="bi bi-shield-lock-fill text-info fs-6"></i>
                        <span class="text-white fw-semibold">256-Bit SSL Encrypted</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="bg-white text-dark p-4 p-md-5 rounded-4 shadow-lg border text-center position-relative overflow-hidden">
                    <div class="d-inline-flex p-3 rounded-circle mb-3 bg-primary-subtle text-primary">
                        <i class="bi bi-wallet2 fs-2"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-1">Make an Official Contribution</h4>
                    <p class="text-muted small mb-4">Complete your secure transaction via the official bKash Merchant Gateway. Instant electronic voucher and tax receipt generated.</p>
                    <a href="#donation-form-card" class="btn btn-primary btn-lg w-100 rounded-pill fw-semibold shadow-sm d-inline-flex align-items-center justify-content-center gap-2 py-2.5">
                        <i class="bi bi-arrow-down-circle"></i>
                        <span>Proceed to Contribution Form</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Main Donation Form & Impact Details Container -->
<div class="container py-5" id="donation-form-card">
    <div class="row g-4 justify-content-center">
        <!-- Left: Donation Form -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-3 p-2.5 d-flex align-items-center justify-content-center text-white bg-primary" style="width: 44px; height: 44px;">
                            <i class="bi bi-cash-stack fs-5"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold text-dark mb-0">Contribution & Sponsorship Portal</h4>
                            <p class="text-muted small mb-0">Select your contribution tier and allocate funds to specific educational programs.</p>
                        </div>
                    </div>
                    <span class="badge bg-light text-secondary border px-3 py-1.5 rounded-pill small d-none d-sm-inline-block">
                        <i class="bi bi-lock-fill me-1 text-primary"></i> Secure Portal
                    </span>
                </div>

                <form id="donationForm">
                    @Html.AntiForgeryToken()

                    <div id="formErrorMessage" class="alert alert-danger rounded-3 mb-3 d-none"></div>

                    <!-- Step 1: Select Amount -->
                    <div class="mb-4">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="badge bg-primary text-white rounded-pill px-2.5 py-1" style="font-size: 0.75rem;">01</span>
                            <label class="form-label fw-bold text-dark mb-0">Contribution Amount (BDT) *</label>
                        </div>
                        
                        <div class="row g-2 mb-3" id="presetAmountsContainer">
                            <div class="col-4 col-sm-4 col-md-2">
                                <button type="button" class="btn btn-outline-secondary w-100 py-2.5 rounded-3 fw-semibold preset-btn font-monospace" data-amount="100">
                                    ৳100
                                </button>
                            </div>
                            <div class="col-4 col-sm-4 col-md-2">
                                <button type="button" class="btn btn-outline-secondary w-100 py-2.5 rounded-3 fw-semibold preset-btn active btn-primary text-white border-primary font-monospace" data-amount="500">
                                    ৳500
                                </button>
                            </div>
                            <div class="col-4 col-sm-4 col-md-2">
                                <button type="button" class="btn btn-outline-secondary w-100 py-2.5 rounded-3 fw-semibold preset-btn font-monospace" data-amount="1000">
                                    ৳1,000
                                </button>
                            </div>
                            <div class="col-4 col-sm-4 col-md-2">
                                <button type="button" class="btn btn-outline-secondary w-100 py-2.5 rounded-3 fw-semibold preset-btn font-monospace" data-amount="2500">
                                    ৳2,500
                                </button>
                            </div>
                            <div class="col-4 col-sm-4 col-md-2">
                                <button type="button" class="btn btn-outline-secondary w-100 py-2.5 rounded-3 fw-semibold preset-btn font-monospace" data-amount="5000">
                                    ৳5,000
                                </button>
                            </div>
                            <div class="col-4 col-sm-4 col-md-2">
                                <button type="button" class="btn btn-outline-secondary w-100 py-2.5 rounded-3 fw-semibold preset-btn font-monospace" data-amount="10000">
                                    ৳10,000
                                </button>
                            </div>
                        </div>

                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-light text-dark fw-bold border-end-0 rounded-start-3" style="font-size: 0.95rem;">BDT (৳)</span>
                            <input asp-for="Amount" type="number" id="customAmountInput" class="form-control form-control-lg border-start-0 rounded-end-3 fw-bold text-dark font-monospace" min="10" max="500000" placeholder="Enter custom amount (Minimum ৳10)" value="500" required />
                        </div>
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                        <div class="form-text small text-muted mt-1.5">
                            <i class="bi bi-info-circle me-1"></i> A contribution of ৳500 finances study supplies and workbooks for one student for a full academic month.
                        </div>
                    </div>

                    <!-- Step 2: Choose Purpose / Cause -->
                    <div class="mb-4">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="badge bg-primary text-white rounded-pill px-2.5 py-1" style="font-size: 0.75rem;">02</span>
                            <label asp-for="Purpose" class="form-label fw-bold text-dark mb-0">Program Allocation *</label>
                        </div>
                        <select asp-for="Purpose" id="purposeSelect" class="form-select form-select-lg rounded-3 fs-6">
                            <option value="General Education & Child Support Fund">General Education & Student Welfare Fund (Highest Priority)</option>
                            <option value="Student Learning Materials & Textbooks">Core Curriculum Textbooks, Stationery & Learning Kits</option>
                            <option value="Community Classrooms & Educator Support">Community Learning Centers & Educator Stipends</option>
                            <option value="Digital Learning & Video Lecture Hardware">Digital Learning Infrastructure & Media Hardware</option>
                            <option value="Nutritional & Healthcare Welfare">Student Nutrition & Health Assistance Program</option>
                        </select>
                        <span asp-validation-for="Purpose" class="text-danger small"></span>
                    </div>

                    <!-- Step 3: Donor Information -->
                    <div class="mb-4 p-4 bg-light bg-opacity-50 rounded-4 border">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="badge bg-primary text-white rounded-pill px-2 py-1" style="font-size: 0.75rem;">03</span>
                            <h5 class="fw-bold text-dark mb-0" style="font-size: 1.05rem;">Donor Contact & Verification Details</h5>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="DonorName" class="form-label fw-semibold text-dark small">Full Name *</label>
                                <input asp-for="DonorName" id="donorNameInput" class="form-control rounded-3" placeholder="e.g. Tanvir Ahmed" required />
                                <span asp-validation-for="DonorName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="DonorPhone" class="form-label fw-semibold text-dark small">Mobile Number *</label>
                                <input asp-for="DonorPhone" id="donorPhoneInput" class="form-control rounded-3" placeholder="e.g. 017XXXXXXXX" required />
                                <span class="text-muted" style="font-size: 0.72rem;">Required for transaction SMS and receipt validation</span>
                                <span asp-validation-for="DonorPhone" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="DonorEmail" class="form-label fw-semibold text-dark small">Email Address (Optional)</label>
                                <input asp-for="DonorEmail" id="donorEmailInput" class="form-control rounded-3" placeholder="e.g. name@organization.org" />
                                <span class="text-muted" style="font-size: 0.72rem;">An electronic receipt for tax exemption will be dispatched to this address</span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Message" class="form-label fw-semibold text-dark small">Dedication or Program Note (Optional)</label>
                                <textarea asp-for="Message" id="donorMessageInput" rows="2" class="form-control rounded-3" placeholder="e.g. Dedicated to community educator development..."></textarea>
                            </div>

                            <div class="col-12">
                                <div class="form-check form-switch mt-1">
                                    <input asp-for="IsAnonymous" class="form-check-input" type="checkbox" id="isAnonymousSwitch" />
                                    <label class="form-check-label fw-semibold text-secondary small" for="isAnonymousSwitch">
                                        Record contribution anonymously on public benefactor ledgers
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Payment Gateway Banner -->
                    <div class="p-3 rounded-4 mb-4 bg-white border shadow-sm">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-3">
                                <div class="p-2 rounded-3 bg-light border d-flex align-items-center justify-content-center" style="width: 58px; height: 38px;">
                                    <span class="fw-bold font-monospace" style="color: #e2136e; font-size: 1.05rem; letter-spacing: -0.02em;">bKash</span>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark small">Official bKash Payment Gateway</div>
                                    <div class="text-muted" style="font-size: 0.76rem;">Merchant: <strong>Onudhabon Foundation</strong> • 0% Transaction Surcharge</div>
                                </div>
                            </div>
                            <div>
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1.5 fw-semibold d-inline-flex align-items-center gap-1.5" style="font-size: 0.75rem;">
                                    <i class="bi bi-shield-check"></i>
                                    <span>Verified Gateway</span>
                                </span>
                            </div>
                        </div>
                    </div>

                    <button type="button" id="openBkashModalBtn" class="btn btn-primary btn-lg w-100 rounded-pill text-white fw-bold shadow py-3 d-flex align-items-center justify-content-center gap-2" style="background-color: #0f172a; border-color: #0f172a; font-size: 1.05rem;">
                        <i class="bi bi-shield-lock-fill"></i>
                        <span>Authorize Payment of ৳<span id="btnAmountDisplay">500</span> via bKash</span>
                    </button>
                    <p class="text-center text-muted small mt-2.5 mb-0" style="font-size: 0.76rem;">
                        By authorizing payment, you confirm agreement with Onudhabon's charitable governance and transparent fund disbursement policies.
                    </p>
                </form>
            </div>
        </div>

        <!-- Right Sidebar: Impact & Live Donors -->
        <div class="col-lg-4">
            <!-- Impact Card -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
                <h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2" style="font-size: 1.05rem;">
                    <i class="bi bi-journal-check text-primary"></i>
                    <span>Fund Allocation & Impact</span>
                </h5>
                <div class="d-flex flex-column gap-3 small text-muted">
                    <div class="d-flex gap-3">
                        <div class="rounded-3 bg-primary-subtle text-primary p-2 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 36px; height: 36px;">
                            <i class="bi bi-book-half"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark">৳100 — Academic Essentials</div>
                            <div class="text-muted">Standard stationery kits, writing workbooks, and geometry instruments for one student.</div>
                        </div>
                    </div>
                    <div class="d-flex gap-3">
                        <div class="rounded-3 bg-success-subtle text-success p-2 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 36px; height: 36px;">
                            <i class="bi bi-mortarboard-fill"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark">৳500 — Monthly Student Sponsorship</div>
                            <div class="text-muted">Comprehensive curriculum materials, local educator mentorship, and examination support.</div>
                        </div>
                    </div>
                    <div class="d-flex gap-3">
                        <div class="rounded-3 bg-info-subtle text-info p-2 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 36px; height: 36px;">
                            <i class="bi bi-display"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark">৳2,500 — Digital Learning Hub</div>
                            <div class="text-muted">Equips community study hubs with offline media hardware, video lectures, and learning tablets.</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Donors Live Feed -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2" style="font-size: 1.05rem;">
                        <i class="bi bi-people-fill text-primary"></i>
                        <span>Recent Contributions</span>
                    </h5>
                    <span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1 small">Verified</span>
                </div>

                <div id="recentDonorsList" class="d-flex flex-column gap-2.5">
                    @if (recentDonations.Any())
                    {
                        @foreach (var d in recentDonations)
                        {
                            <div class="p-2.5 bg-light bg-opacity-75 rounded-3 d-flex justify-content-between align-items-center small border">
                                <div>
                                    <div class="fw-bold text-dark">@(d.IsAnonymous ? "Anonymous Benefactor" : d.DonorName)</div>
                                    <div class="text-muted" style="font-size: 0.72rem;">@d.Purpose</div>
                                </div>
                                <div class="text-end">
                                    <span class="badge rounded-pill px-2.5 py-1 text-white bg-primary font-monospace">
                                        ৳@d.Amount.ToString("N0")
                                    </span>
                                    <div class="text-muted mt-0.5" style="font-size: 0.68rem;">@d.CreatedAt.ToString("MMM dd, yyyy")</div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-3 small">No recent public contributions recorded.</div>
                    }
                </div>
            </div>

            <!-- Governance & Transparency Card -->
            <div class="card border-0 shadow-sm rounded-4 p-3 mt-4 bg-white border">
                <div class="d-flex align-items-start gap-2">
                    <i class="bi bi-patch-check-fill text-primary fs-5 mt-0.5"></i>
                    <div>
                        <div class="fw-bold text-dark small">Institutional Transparency</div>
                        <div class="text-muted" style="font-size: 0.75rem; line-height: 1.5;">
                            All disbursements undergo quarterly compliance reviews and are audited under non-profit educational development standards.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= BKASH PAYMENT GATEWAY MODAL ================= -->
<div class="modal fade" id="bkashPaymentModal" tabindex="-1" aria-labelledby="bkashModalTitle" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 450px;">
        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden bg-white">
            
            <!-- bKash Brand Header -->
            <div class="text-white d-flex justify-content-between align-items-center" style="padding: 16px 20px; background: linear-gradient(135deg, #0b1329 0%, #1e293b 100%); border-bottom: 3px solid #e2136e;">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-white rounded-3 shadow-sm d-flex align-items-center justify-content-center flex-shrink-0" style="padding: 5px 12px; height: 36px;">
                        <span class="fw-bold font-monospace" style="color: #e2136e; font-size: 1.1rem; line-height: 1; letter-spacing: -0.02em;">bKash</span>
                    </div>
                    <div>
                        <div class="fw-bold text-white fs-6 mb-0 lh-sm">Onudhabon Foundation</div>
                        <div class="text-white-50 small" style="font-size: 0.75rem;">Merchant Checkout • Verified Gateway</div>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="modal" aria-label="Close" id="closeBkashModalBtn"></button>
            </div>

            <!-- Amount Card inside modal -->
            <div class="bg-light px-4 py-3 border-bottom d-flex justify-content-between align-items-center" style="background-color: #f8fafc !important;">
                <div>
                    <div class="text-muted text-uppercase fw-semibold" style="font-size: 0.72rem; letter-spacing: 0.05em;">Payable Amount</div>
                    <div class="h5 fw-bold text-dark mb-0 font-monospace">৳ <span id="modalAmountDisplay">500.00</span> BDT</div>
                </div>
                <div class="text-end">
                    <span class="badge bg-white text-secondary border rounded-pill px-3 py-1.5 font-monospace small" id="modalInvoiceDisplay">INV-@DateTime.UtcNow.ToString("yyyyMMdd")</span>
                </div>
            </div>

            <!-- Step 1: Wallet Number -->
            <div id="bkashStep1" class="p-4 bg-white text-center">
                <div class="mb-3">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 mb-2" style="font-size: 0.75rem;">Step 1 of 3: Authorization</span>
                    <h5 class="fw-bold text-dark mb-1">bKash Account Number</h5>
                    <div class="text-muted small" style="font-size: 0.8rem;">Enter your 11-digit registered bKash personal or agent mobile wallet number</div>
                </div>

                <div class="mb-3">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-light text-muted border-end-0 fw-bold font-monospace px-3" style="font-size: 0.95rem;">+88</span>
                        <input type="tel" id="bkashWalletInput" class="form-control form-control-lg border-start-0 text-start fw-bold text-dark font-monospace px-3" style="font-size: 1.15rem; letter-spacing: 0.04em;" placeholder="01XXXXXXXXX" maxlength="11" />
                    </div>
                    <div id="bkashWalletError" class="text-danger small mt-1 text-center d-none" style="font-size: 0.78rem;"></div>
                </div>

                <div class="form-check small text-muted my-3 text-start">
                    <input class="form-check-input" type="checkbox" id="bkashAgreeTerms" checked />
                    <label class="form-check-label ms-1 text-secondary" for="bkashAgreeTerms" style="font-size: 0.78rem;">
                        I agree to the <a href="https://www.bkash.com/terms-and-conditions" target="_blank" class="text-decoration-none fw-semibold text-primary">terms and conditions</a> of bKash payment gateway.
                    </label>
                </div>

                <div class="d-flex gap-2 pt-1">
                    <button type="button" class="btn btn-outline-secondary w-50 py-2.5 rounded-pill fw-semibold" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="btnProceedToOtp" class="btn btn-primary w-50 py-2.5 rounded-pill fw-bold" style="background-color: #0f172a; border-color: #0f172a;">
                        Proceed to OTP →
                    </button>
                </div>
            </div>

            <!-- Step 2: OTP Verification -->
            <div id="bkashStep2" class="p-4 bg-white text-center d-none">
                <div class="mb-3">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 mb-2" style="font-size: 0.75rem;">Step 2 of 3: Verification</span>
                    <h5 class="fw-bold text-dark mb-1">One-Time Password (OTP)</h5>
                    <div class="text-muted small" style="font-size: 0.8rem;">
                        A 6-digit verification code was dispatched to <strong id="displayWalletForOtp" class="text-dark font-monospace">017XXXXXXXX</strong>
                    </div>
                </div>

                <div class="mb-3">
                    <input type="text" id="bkashOtpInput" class="form-control form-control-lg text-center fw-bold fs-4 font-monospace py-2" style="letter-spacing: 0.25em;" placeholder="123456" maxlength="6" value="123456" />
                    <div id="bkashOtpError" class="text-danger small mt-1 text-center d-none" style="font-size: 0.78rem;"></div>
                    <div class="text-center text-muted small mt-2" style="font-size: 0.76rem;">
                        (Demo Code: <code class="text-primary font-monospace">123456</code> is pre-filled for evaluation)
                    </div>
                </div>

                <div class="d-flex gap-2 pt-1">
                    <button type="button" id="btnBackToStep1" class="btn btn-outline-secondary w-50 py-2.5 rounded-pill fw-semibold">← Back</button>
                    <button type="button" id="btnProceedToPin" class="btn btn-primary w-50 py-2.5 rounded-pill fw-bold" style="background-color: #0f172a; border-color: #0f172a;">
                        Verify Code →
                    </button>
                </div>
            </div>

            <!-- Step 3: bKash PIN -->
            <div id="bkashStep3" class="p-4 bg-white text-center d-none">
                <div class="mb-3">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 mb-2" style="font-size: 0.75rem;">Step 3 of 3: PIN Confirmation</span>
                    <h5 class="fw-bold text-dark mb-1">Authorize Transaction</h5>
                    <div class="text-muted small" style="font-size: 0.8rem;">
                        Enter your 5-digit secret bKash PIN to authorize <strong class="text-dark font-monospace">৳ <span id="pinStepAmount">500</span> BDT</strong>
                    </div>
                </div>

                <div class="mb-3">
                    <input type="password" id="bkashPinInput" class="form-control form-control-lg text-center fw-bold fs-4 font-monospace py-2" style="letter-spacing: 0.35em;" placeholder="•••••" maxlength="5" value="12345" />
                    <div id="bkashPinError" class="text-danger small mt-1 text-center d-none" style="font-size: 0.78rem;"></div>
                    <div class="text-center text-muted small mt-2" style="font-size: 0.76rem;">
                        (Demo PIN: <code class="text-primary font-monospace">12345</code> pre-filled)
                    </div>
                </div>

                <div class="d-flex gap-2 pt-1">
                    <button type="button" id="btnBackToStep2" class="btn btn-outline-secondary w-50 py-2.5 rounded-pill fw-semibold">← Back</button>
                    <button type="button" id="btnConfirmFinalPayment" class="btn btn-primary w-50 py-2.5 rounded-pill fw-bold" style="background-color: #0f172a; border-color: #0f172a;">
                        <span>Confirm Payment</span>
                    </button>
                </div>
            </div>

            <!-- Processing Loader Screen -->
            <div id="bkashProcessing" class="p-5 bg-white text-center d-none">
                <div class="spinner-border text-primary mb-3" style="width: 3.5rem; height: 3.5rem;" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <h5 class="fw-bold text-dark mb-1">Authorizing Payment...</h5>
                <p class="text-muted small mb-0">Communicating with the bKash payment gateway API. Please do not refresh or navigate away from this window.</p>
            </div>

            <!-- Footer Note -->
            <div class="text-center bg-light border-top text-muted" style="padding: 10px 16px; font-size: 0.75rem;">
                bKash Helpline: <strong>16247</strong> • Onudhabon ISD Foundation
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const customAmountInput = document.getElementById('customAmountInput');
            const presetButtons = document.querySelectorAll('.preset-btn');
            const btnAmountDisplay = document.getElementById('btnAmountDisplay');
            const openBkashModalBtn = document.getElementById('openBkashModalBtn');
            const modalAmountDisplay = document.getElementById('modalAmountDisplay');
            const pinStepAmount = document.getElementById('pinStepAmount');
            const modalInvoiceDisplay = document.getElementById('modalInvoiceDisplay');
            
            // Modal Steps
            const bkashModal = new bootstrap.Modal(document.getElementById('bkashPaymentModal'));
            const bkashStep1 = document.getElementById('bkashStep1');
            const bkashStep2 = document.getElementById('bkashStep2');
            const bkashStep3 = document.getElementById('bkashStep3');
            const bkashProcessing = document.getElementById('bkashProcessing');
            
            const bkashWalletInput = document.getElementById('bkashWalletInput');
            const bkashWalletError = document.getElementById('bkashWalletError');
            const bkashOtpInput = document.getElementById('bkashOtpInput');
            const bkashOtpError = document.getElementById('bkashOtpError');
            const bkashPinInput = document.getElementById('bkashPinInput');
            const bkashPinError = document.getElementById('bkashPinError');
            const displayWalletForOtp = document.getElementById('displayWalletForOtp');
            const formErrorMessage = document.getElementById('formErrorMessage');

            // Handle Preset Amount Clicks
            presetButtons.forEach(btn => {
                btn.addEventListener('click', function () {
                    presetButtons.forEach(b => {
                        b.classList.remove('active', 'btn-primary', 'text-white', 'border-primary');
                        b.classList.add('btn-outline-secondary');
                    });
                    this.classList.remove('btn-outline-secondary');
                    this.classList.add('active', 'btn-primary', 'text-white', 'border-primary');
                    
                    const amt = this.getAttribute('data-amount');
                    customAmountInput.value = amt;
                    btnAmountDisplay.textContent = Number(amt).toLocaleString();
                });
            });

            // Handle Custom Amount Input
            customAmountInput.addEventListener('input', function () {
                const val = parseFloat(this.value) || 0;
                btnAmountDisplay.textContent = val.toLocaleString();
                presetButtons.forEach(b => {
                    if (b.getAttribute('data-amount') === this.value) {
                        b.classList.remove('btn-outline-secondary');
                        b.classList.add('active', 'btn-primary', 'text-white', 'border-primary');
                    } else {
                        b.classList.remove('active', 'btn-primary', 'text-white', 'border-primary');
                        b.classList.add('btn-outline-secondary');
                    }
                });
            });

            function resetModalSteps() {
                bkashStep1.classList.remove('d-none');
                bkashStep2.classList.add('d-none');
                bkashStep3.classList.add('d-none');
                bkashProcessing.classList.add('d-none');
                bkashWalletError.classList.add('d-none');
                bkashOtpError.classList.add('d-none');
                bkashPinError.classList.add('d-none');
            }

            // Open bKash Checkout Modal with Validation
            openBkashModalBtn.addEventListener('click', function () {
                formErrorMessage.classList.add('d-none');
                
                const donorName = document.getElementById('donorNameInput').value.trim();
                const donorPhone = document.getElementById('donorPhoneInput').value.trim();
                const amount = parseFloat(customAmountInput.value);

                if (!donorName) {
                    formErrorMessage.textContent = 'Please enter your Full Name before proceeding.';
                    formErrorMessage.classList.remove('d-none');
                    document.getElementById('donorNameInput').focus();
                    return;
                }

                if (!donorPhone) {
                    formErrorMessage.textContent = 'Please enter your mobile phone number.';
                    formErrorMessage.classList.remove('d-none');
                    document.getElementById('donorPhoneInput').focus();
                    return;
                }

                if (!amount || amount < 10) {
                    formErrorMessage.textContent = 'Minimum donation amount is ৳10.';
                    formErrorMessage.classList.remove('d-none');
                    customAmountInput.focus();
                    return;
                }

                // Populate modal amounts
                modalAmountDisplay.textContent = amount.toFixed(2);
                pinStepAmount.textContent = amount.toLocaleString();
                modalInvoiceDisplay.textContent = 'INV-' + Math.floor(100000 + Math.random() * 900000);
                
                // Pre-fill wallet number from donor phone if valid
                if (donorPhone.length === 11 && donorPhone.startsWith('01')) {
                    bkashWalletInput.value = donorPhone;
                }

                resetModalSteps();
                bkashModal.show();
            });

            // Step 1 -> Step 2
            document.getElementById('btnProceedToOtp').addEventListener('click', function () {
                const wallet = bkashWalletInput.value.trim();
                const agree = document.getElementById('bkashAgreeTerms').checked;

                if (!agree) {
                    bkashWalletError.textContent = 'Please agree to the bKash payment terms.';
                    bkashWalletError.classList.remove('d-none');
                    return;
                }

                if (!wallet || wallet.length !== 11 || !wallet.startsWith('01')) {
                    bkashWalletError.textContent = 'Please enter a valid 11-digit bKash account number (e.g. 017XXXXXXXX).';
                    bkashWalletError.classList.remove('d-none');
                    return;
                }

                bkashWalletError.classList.add('d-none');
                displayWalletForOtp.textContent = wallet;

                bkashStep1.classList.add('d-none');
                bkashStep2.classList.remove('d-none');
                bkashOtpInput.focus();
            });

            // Step 2 -> Step 1
            document.getElementById('btnBackToStep1').addEventListener('click', function () {
                bkashStep2.classList.add('d-none');
                bkashStep1.classList.remove('d-none');
            });

            // Step 2 -> Step 3
            document.getElementById('btnProceedToPin').addEventListener('click', function () {
                const otp = bkashOtpInput.value.trim();
                if (!otp || otp.length < 4) {
                    bkashOtpError.textContent = 'Please enter the 6-digit OTP verification code.';
                    bkashOtpError.classList.remove('d-none');
                    return;
                }

                bkashOtpError.classList.add('d-none');
                bkashStep2.classList.add('d-none');
                bkashStep3.classList.remove('d-none');
                bkashPinInput.focus();
            });

            // Step 3 -> Step 2
            document.getElementById('btnBackToStep2').addEventListener('click', function () {
                bkashStep3.classList.add('d-none');
                bkashStep2.classList.remove('d-none');
            });

            // Step 3 -> Final Payment Execution
            document.getElementById('btnConfirmFinalPayment').addEventListener('click', function () {
                const pin = bkashPinInput.value.trim();
                if (!pin || pin.length !== 5 || isNaN(pin)) {
                    bkashPinError.textContent = 'Please enter your 5-digit bKash PIN.';
                    bkashPinError.classList.remove('d-none');
                    return;
                }

                bkashPinError.classList.add('d-none');
                bkashStep3.classList.add('d-none');
                bkashProcessing.classList.remove('d-none');

                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const payload = {
                    donorName: document.getElementById('donorNameInput').value.trim(),
                    donorEmail: document.getElementById('donorEmailInput').value.trim() || null,
                    donorPhone: document.getElementById('donorPhoneInput').value.trim(),
                    amount: parseFloat(customAmountInput.value),
                    purpose: document.getElementById('purposeSelect').value,
                    message: document.getElementById('donorMessageInput').value.trim() || null,
                    isAnonymous: document.getElementById('isAnonymousSwitch').checked,
                    bkashWalletNumber: bkashWalletInput.value.trim(),
                    otpCode: bkashOtpInput.value.trim(),
                    pin: pin
                };

                fetch('/Donation/ProcessBkashPayment', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(payload)
                })
                .then(response => response.json())
                .then(data => {
                    if (data && data.success) {
                        // Redirect to receipt
                        setTimeout(function () {
                            window.location.href = data.redirectUrl;
                        }, 1200);
                    } else {
                        bkashProcessing.classList.add('d-none');
                        bkashStep3.classList.remove('d-none');
                        bkashPinError.textContent = data.message || 'Payment failed. Please try again.';
                        bkashPinError.classList.remove('d-none');
                    }
                })
                .catch(err => {
                    console.error('Payment execution error:', err);
                    bkashProcessing.classList.add('d-none');
                    bkashStep3.classList.remove('d-none');
                    bkashPinError.textContent = 'Network error occurred. Please try again.';
                    bkashPinError.classList.remove('d-none');
                });
            });
        });
    </script>
}
