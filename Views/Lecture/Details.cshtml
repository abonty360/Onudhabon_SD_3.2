@model Onudhabon_ISD.Models.Lecture
@inject Onudhabon_ISD.Services.ICloudinaryService CloudinaryService

@{
    ViewData["Title"] = $"{Model.Title} - Lecture Details";
}

<div class="container py-4">
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3 rounded-pill d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i>
            <span>Back to Lectures</span>
        </a>
    </div>

    <div class="row g-4">
        <!-- Video Player Column -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-black mb-4">
                @if (!string.IsNullOrWhiteSpace(Model.VideoUrl))
                {
                    <div class="ratio ratio-16x9">
                        <video controls 
                               playsinline 
                               preload="metadata" 
                               poster="@(Model.Thumbnail ?? CloudinaryService.GetVideoThumbnailUrl(Model.VideoUrl, 640, 360))" 
                               class="w-100 h-100" 
                               style="object-fit: contain; background: #000;">
                            <!-- Auto-optimized adaptive streaming source -->
                            <source src="@CloudinaryService.GetOptimizedVideoUrl(Model.VideoUrl)" type="video/mp4" />
                            <!-- Direct fallback source -->
                            <source src="@Model.VideoUrl" type="video/mp4" />
                            Your browser does not support HTML5 video playback.
                        </video>
                    </div>
                }
                else
                {
                    <div class="p-5 text-center text-white">
                        <p class="mb-0">No video stream URL available for this lecture.</p>
                    </div>
                }
            </div>

            <!-- Lecture Info Card -->
                @{
                    var isAuthenticated = User.Identity != null && User.Identity.IsAuthenticated;
                    var isAdmin = isAuthenticated && (User.IsInRole("Admin") || User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value == "Admin");
                    var isOwner = isAuthenticated && !string.IsNullOrWhiteSpace(Model.Instructor) && (
                        string.Equals(Model.Instructor.Trim(), User.Identity?.Name, StringComparison.OrdinalIgnoreCase) ||
                        string.Equals(Model.Instructor.Trim(), User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value, StringComparison.OrdinalIgnoreCase)
                    );
                    var isPending = string.Equals(Model.Status, "pending", StringComparison.OrdinalIgnoreCase);
                    var isDeclined = string.Equals(Model.Status, "declined", StringComparison.OrdinalIgnoreCase);
                    var showStatus = isAdmin || isOwner || isPending || isDeclined;
                }
                <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1 rounded-pill">
                        Class @Model.ClassLevel
                    </span>
                    <span class="badge bg-info-subtle text-info border border-info-subtle px-2.5 py-1 rounded-pill">
                        @Model.Subject
                    </span>
                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2.5 py-1 rounded-pill">
                        Topic: @Model.Topic
                    </span>
                    @if (showStatus)
                    {
                        <span class="badge @(isPending ? "bg-warning-subtle text-warning border-warning-subtle" : (isDeclined ? "bg-danger-subtle text-danger border-danger-subtle" : "bg-success-subtle text-success border-success-subtle")) border px-2.5 py-1 rounded-pill ms-auto">
                            Status: @Model.Status
                        </span>
                    }
                </div>

                <h3 class="fw-bold text-dark mt-2 mb-3">@Model.Title</h3>
                <p class="text-muted leading-relaxed mb-4">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "No detailed description provided." : Model.Description)
                </p>

                <div class="d-flex align-items-center justify-content-between border-top pt-3 text-muted small flex-wrap gap-2">
                    <div>
                        <strong>Instructor:</strong> @(Model.Instructor ?? "Educator")
                    </div>
                    <div>
                        <strong>Uploaded:</strong> @Model.CreatedAt.ToString("MMMM dd, yyyy")
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar Column -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h5 class="fw-bold mb-3">Lecture Summary</h5>
                <ul class="list-unstyled mb-0 small">
                    <li class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Class Level:</span>
                        <span class="fw-semibold">Class @Model.ClassLevel</span>
                    </li>
                    <li class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Subject:</span>
                        <span class="fw-semibold">@Model.Subject</span>
                    </li>
                    <li class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Topic:</span>
                        <span class="fw-semibold">@Model.Topic</span>
                    </li>
                    <li class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Medium:</span>
                        <span class="fw-semibold">@Model.Version</span>
                    </li>
                    <li class="d-flex justify-content-between py-2">
                        <span class="text-muted">Status:</span>
                        <span class="fw-semibold text-capitalize">@Model.Status</span>
                    </li>
                </ul>
            </div>

            @if (User.Identity != null && User.Identity.IsAuthenticated && (User.IsInRole("Educator") || User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value == "Educator"))
            {
                <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-light">
                    <h6 class="fw-bold mb-2">Want to contribute lectures?</h6>
                    <p class="text-muted small mb-3">Upload lecture videos and supplementary notes for learners.</p>
                    <a asp-action="Upload" class="btn btn-primary btn-sm rounded-pill px-4">
                        Upload Lecture
                    </a>
                </div>
            }
        </div>
    </div>
</div>
