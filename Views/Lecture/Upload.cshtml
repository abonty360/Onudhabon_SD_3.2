@model Onudhabon_ISD.Models.LectureUploadViewModel

@{
    ViewData["Title"] = "Upload Lecture Video - Onudhabon";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3 rounded-pill">
                    ← Back to Lectures
                </a>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="rounded-circle bg-primary-subtle text-primary d-inline-flex p-3 mb-2">
                        <svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                    </div>
                    <h3 class="fw-bold text-dark">Upload Lecture Video</h3>
                    <p class="text-muted">Videos are stored in <code>onudhabon/lectures</code> with eager thumbnail generation.</p>
                </div>

                <form asp-action="Upload" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-3"></div>

                    <!-- Title -->
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Lecture Title *</label>
                        <input asp-for="Title" class="form-control form-control-lg rounded-3" placeholder="e.g. Chapter 3: Force and Motion - Part 1" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <!-- Class & Subject & Topic -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="ClassLevel" class="form-label fw-semibold">Class Level *</label>
                            <select asp-for="ClassLevel" class="form-select rounded-3">
                                <option value="">Select Class</option>
                                @for (int i = 1; i <= 12; i++)
                                {
                                    <option value="@i">Class @i</option>
                                }
                            </select>
                            <span asp-validation-for="ClassLevel" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Subject" class="form-label fw-semibold">Subject *</label>
                            <input asp-for="Subject" class="form-control rounded-3" placeholder="e.g. Physics, Math..." />
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Topic" class="form-label fw-semibold">Topic *</label>
                            <input asp-for="Topic" class="form-control rounded-3" placeholder="e.g. Newton's Laws" />
                            <span asp-validation-for="Topic" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Medium & Instructor -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Version" class="form-label fw-semibold">Medium / Version</label>
                            <select asp-for="Version" class="form-select rounded-3">
                                <option value="Bangla">Bangla Medium</option>
                                <option value="English">English Medium</option>
                                <option value="English Version">English Version</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Instructor" class="form-label fw-semibold">Instructor Name</label>
                            <input asp-for="Instructor" class="form-control rounded-3" placeholder="e.g. Prof. Rahman" />
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Lecture Summary / Outline</label>
                        <textarea asp-for="Description" rows="3" class="form-control rounded-3" placeholder="Outline of learning objectives covered in this lecture video..."></textarea>
                    </div>

                    <!-- Video File Upload (Cloudinary) -->
                    <div class="mb-4">
                        <label asp-for="VideoFile" class="form-label fw-semibold">Select Video File (MP4, MKV, WebM) *</label>
                        <input asp-for="VideoFile" type="file" accept="video/*" class="form-control form-control-lg rounded-3" />
                        <span class="text-muted small d-block mt-1">Eager 300x200 crop-fill thumbnail will be generated automatically upon upload.</span>
                        <span asp-validation-for="VideoFile" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill shadow-sm">
                        Upload & Submit Lecture (Status: Pending)
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
