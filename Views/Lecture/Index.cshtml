@model IEnumerable<Onudhabon_ISD.Models.Lecture>
@inject Onudhabon_ISD.Services.ICloudinaryService CloudinaryService

@{
    ViewData["Title"] = "Recorded Video Lectures - Onudhabon";

    var classLevels = Model
        .Where(l => !string.IsNullOrWhiteSpace(l.ClassLevel))
        .Select(l => l.ClassLevel!)
        .Distinct()
        .OrderBy(x => x)
        .ToList();

    var subjects = Model
        .Where(l => !string.IsNullOrWhiteSpace(l.Subject))
        .Select(l => l.Subject!)
        .Distinct()
        .OrderBy(x => x)
        .ToList();

    var topics = Model
        .Where(l => !string.IsNullOrWhiteSpace(l.Topic))
        .Select(l => l.Topic!)
        .Distinct()
        .OrderBy(x => x)
        .ToList();
}

<div class="lecture-page">
    <section class="lecture-hero">
        <div class="lecture-hero-overlay"></div>
        <div class="lecture-hero-content">
            <div class="hero-label">Home/Lectures</div>
            <h1>Inspiring Minds, One Lecture at a Time</h1>
            <p>
                Dive into a world of knowledge where passionate educators and volunteers share their expertise.
                Our lectures are designed to spark curiosity, build skills, and empower learners to reach their full potential — no matter where they are.
            </p>
        </div>
    </section>

    <div class="lecture-inner">
        <h2 class="lecture-title">Video Lectures</h2>

        @if (User.Identity != null && User.Identity.IsAuthenticated && (User.IsInRole("Educator") || User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value == "Educator"))
        {
            <div class="lecture-actions">
                <a asp-action="Upload" class="upload-btn">Upload Lecture</a>
            </div>
        }

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4 mt-2" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4 mt-2" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form method="get" asp-action="Index" class="lecture-filters" id="lectureFilters">
            <div class="filter-field search-field">
                <label for="search">Search</label>
                <input id="search" name="search" type="text" placeholder="Search lectures, instructors, or topics" value="@Context.Request.Query["search"]" />
            </div>

            <div class="filter-field">
                <label for="classLevel">Class</label>
                <select id="classLevel" name="classLevel">
                    <option value="">All Classes</option>
                    @foreach (var item in classLevels)
                    {
                        <option value="@item" selected="@(Context.Request.Query["classLevel"] == item)">
                            @item
                        </option>
                    }
                </select>
            </div>

            <div class="filter-field">
                <label for="subject">Subject</label>
                <select id="subject" name="subject">
                    <option value="">All Subjects</option>
                    @foreach (var item in subjects)
                    {
                        <option value="@item" selected="@(Context.Request.Query["subject"] == item)">
                            @item
                        </option>
                    }
                </select>
            </div>

            <div class="filter-field">
                <label for="topic">Topic</label>
                <select id="topic" name="topic">
                    <option value="">Select subject</option>
                    @foreach (var item in topics)
                    {
                        <option value="@item" selected="@(Context.Request.Query["topic"] == item)">
                            @item
                        </option>
                    }
                </select>
            </div>

            <div class="filter-field">
                <label for="version">Version</label>
                <select id="version" name="version">
                    <option value="">Both Versions</option>
                    <option value="Bangla">Bangla</option>
                    <option value="English">English</option>
                </select>
            </div>
        </form>

        @if (!Model.Any())
        {
            <div class="no-lectures">
                <p>No lectures available for this filter.</p>
            </div>
        }
        else
        {
            <div class="lecture-grid" id="lectureGrid">
                @foreach (var lecture in Model)
                {
                    <article class="lecture-card"
                             data-title="@lecture.Title"
                             data-instructor="@lecture.Instructor"
                             data-class="@lecture.ClassLevel"
                             data-subject="@lecture.Subject"
                             data-topic="@lecture.Topic"
                             data-version="@lecture.Version">
                        <a asp-action="Details" asp-route-id="@lecture.Id" class="text-decoration-none text-dark d-block">
                            <div class="video-frame">
                                @if (!string.IsNullOrWhiteSpace(lecture.VideoUrl))
                                {
                                    <video class="lecture-video-preview"
                                           preload="metadata"
                                           muted
                                           playsinline
                                           disablepictureinpicture
                                           src="@(lecture.VideoUrl)#t=0.5">
                                    </video>
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center h-100 text-muted bg-dark">
                                        <span>No Video</span>
                                    </div>
                                }
                                <div class="video-overlay">
                                    <span class="play-icon d-inline-flex align-items-center justify-content-center">
                                        <i class="bi bi-play-fill fs-5"></i>
                                    </span>
                                    <span class="time-label" style="display: none;">0:00</span>
                                </div>
                            </div>

                            <div class="lecture-card-body">
                                <div class="meta-row d-flex align-items-center flex-wrap gap-1">
                                    <span class="grade-pill">Class @lecture.ClassLevel</span>
                                    <span class="subject-pill">@lecture.Subject</span>
                                    @if (lecture.Status?.ToLower() == "pending")
                                    {
                                        <span class="badge bg-warning text-dark border border-warning-subtle rounded-pill px-2 py-0.5 ms-auto d-inline-flex align-items-center gap-1" style="font-size: 0.75rem;">
                                            <i class="bi bi-clock-history"></i>
                                            <span>Pending Approval</span>
                                        </span>
                                    }
                                    else if (lecture.Status?.ToLower() == "declined")
                                    {
                                        <span class="badge bg-danger text-white border rounded-pill px-2 py-0.5 ms-auto d-inline-flex align-items-center gap-1" style="font-size: 0.75rem;">
                                            <i class="bi bi-x-circle-fill"></i>
                                            <span>Declined</span>
                                        </span>
                                    }
                                </div>

                                <h3>@lecture.Title</h3>
                                <p>@(string.IsNullOrWhiteSpace(lecture.Description) ? "Recorded video lecture for students." : lecture.Description)</p>
                                <div class="author-row d-inline-flex align-items-center gap-1.5 text-muted small">
                                    <i class="bi bi-person-video3"></i>
                                    <span>@(lecture.Instructor ?? "Educator")</span>
                                </div>
                            </div>
                        </a>
                    </article>
                }
            </div>
        }
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // 1. Calculate & display static total duration for each video card (fixed, never increases)
        function formatDuration(seconds) {
            if (!seconds || isNaN(seconds) || !isFinite(seconds)) return '0:00';
            const totalSecs = Math.round(seconds);
            const hrs = Math.floor(totalSecs / 3600);
            const mins = Math.floor((totalSecs % 3600) / 60);
            const secs = totalSecs % 60;
            
            if (hrs > 0) {
                return `${hrs}:${mins < 10 ? '0' : ''}${mins}:${secs < 10 ? '0' : ''}${secs}`;
            }
            return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
        }

        const cards = Array.from(document.querySelectorAll('.lecture-card'));

        cards.forEach(function (card) {
            const video = card.querySelector('video.lecture-video-preview');
            const timeLabel = card.querySelector('.time-label');

            if (video && timeLabel) {
                function updateDuration() {
                    if (video.duration && !isNaN(video.duration) && isFinite(video.duration)) {
                        timeLabel.textContent = formatDuration(video.duration);
                        timeLabel.style.display = 'inline-block';
                    }
                }

                if (video.readyState >= 1) {
                    updateDuration();
                } else {
                    video.addEventListener('loadedmetadata', updateDuration, { once: true });
                }

                // Optional smooth hover preview without affecting static total duration
                card.addEventListener('mouseenter', function () {
                    if (video.readyState >= 2) {
                        video.play().catch(function() {});
                    }
                });

                card.addEventListener('mouseleave', function () {
                    video.pause();
                    video.currentTime = 0.5;
                });
            }
        });

        // 2. Search & filter logic
        const searchInput = document.getElementById('search');
        const classSelect = document.getElementById('classLevel');
        const subjectSelect = document.getElementById('subject');
        const topicSelect = document.getElementById('topic');
        const versionSelect = document.getElementById('version');

        function getValue(element) {
            return element ? element.value.trim().toLowerCase() : '';
        }

        function applyFilters() {
            const search = getValue(searchInput);
            const classFilter = getValue(classSelect);
            const subjectFilter = getValue(subjectSelect);
            const topicFilter = getValue(topicSelect);
            const versionFilter = getValue(versionSelect);

            cards.forEach(function (card) {
                const title = (card.dataset.title || '').toLowerCase();
                const instructor = (card.dataset.instructor || '').toLowerCase();
                const className = (card.dataset.class || '').toLowerCase();
                const subject = (card.dataset.subject || '').toLowerCase();
                const topic = (card.dataset.topic || '').toLowerCase();
                const version = (card.dataset.version || '').toLowerCase();

                const matchesSearch = !search || title.includes(search) || instructor.includes(search) || topic.includes(search);
                const matchesClass = !classFilter || className === classFilter;
                const matchesSubject = !subjectFilter || subject === subjectFilter;
                const matchesTopic = !topicFilter || topic === topicFilter;
                const matchesVersion = !versionFilter || version === versionFilter;

                const visible = matchesSearch && matchesClass && matchesSubject && matchesTopic && matchesVersion;
                card.style.display = visible ? '' : 'none';
            });
        }

        [searchInput, classSelect, subjectSelect, topicSelect, versionSelect].forEach(function (element) {
            if (element) {
                element.addEventListener('input', applyFilters);
                element.addEventListener('change', applyFilters);
            }
        });
    });
</script>
