@model IEnumerable<Onudhabon_ISD.Models.Lecture>
@inject Onudhabon_ISD.Services.ICloudinaryService CloudinaryService

@{
    ViewData["Title"] = "Recorded Video Lectures - Onudhabon";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1" style="color: #1e293b;">Recorded Video Lectures</h2>
            <p class="text-muted mb-0">Browse and stream educational lectures powered by Cloudinary adaptive streaming.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Upload" class="btn btn-primary px-3 py-2 rounded-pill">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="me-1 align-text-bottom">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
                Upload Lecture Video
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 text-center p-5" style="background-color: #f8fafc;">
            <div class="card-body">
                <div class="mb-3 text-muted">
                    <svg width="54" height="54" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                </div>
                <h5 class="fw-bold text-dark">No lectures uploaded yet</h5>
                <p class="text-muted">Start uploading lecture videos to build the digital classroom archive.</p>
                <a asp-action="Upload" class="btn btn-outline-primary px-4 rounded-pill">Upload First Lecture</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var lecture in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                        <div class="position-relative bg-dark" style="height: 190px; overflow: hidden;">
                            <img src="@(lecture.Thumbnail ?? CloudinaryService.GetVideoThumbnailUrl(lecture.VideoUrl, 480, 270))"
                                 alt="@lecture.Title"
                                 class="w-100 h-100 object-fit-cover"
                                 onerror="this.src='https://via.placeholder.com/480x270?text=Lecture+Video';" />
                            <a asp-action="Details" asp-route-id="@lecture.Id" class="position-absolute top-50 start-50 translate-middle btn btn-light rounded-circle shadow p-3 d-flex align-items-center justify-content-center text-primary" style="width: 50px; height: 50px;" aria-label="Play video">
                                <svg width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="m11.596 8.697-6.363 3.692c-.54.313-1.233-.066-1.233-.697V4.308c0-.63.692-1.01 1.233-.696l6.363 3.692a.802.802 0 0 1 0 1.393z" />
                                </svg>
                            </a>
                            <span class="position-absolute top-0 end-0 m-2.5 badge @(lecture.Status?.ToLower() == "pending" ? "bg-warning text-dark" : "bg-success text-white") rounded-pill">
                                @lecture.Status
                            </span>
                        </div>

                        <!-- Card Content -->
                        <div class="card-body p-3.5 d-flex flex-column">
                            <div class="d-flex align-items-center gap-1.5 mb-2">
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill small">Class @lecture.ClassLevel</span>
                                <span class="badge bg-light text-secondary border rounded-pill small">@lecture.Subject</span>
                            </div>

                            <h6 class="fw-bold text-dark mb-1 text-truncate-2">
                                <a asp-action="Details" asp-route-id="@lecture.Id" class="text-decoration-none text-dark">
                                    @lecture.Title
                                </a>
                            </h6>

                            <p class="text-muted small text-truncate-2 mb-3">
                                @(string.IsNullOrWhiteSpace(lecture.Description) ? "No description." : lecture.Description)
                            </p>

                            <div class="mt-auto d-flex justify-content-between align-items-center border-top pt-2.5 text-muted small">
                                <span>Topic: <strong>@lecture.Topic</strong></span>
                                <a asp-action="Details" asp-route-id="@lecture.Id" class="btn btn-sm btn-primary rounded-pill px-3">
                                    Watch Video
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>