@{
    ViewData["Title"] = "Home - Onudhabon";
}

<!-- HERO -->
<section class="onudhabon-hero">

    <div class="hero-overlay"></div>

    <div class="hero-content">
        <h1>Exploring Education Through Community</h1>

        <p>
            Connecting volunteers, educators, and communities all across
            Bangladesh to provide quality education for underprivileged children.
        </p>

        <div class="hero-quote">
            "One book, one pen, one child, and one volunteer can change the world."
        </div>
    </div>

</section>


<!-- STATISTICS -->
<section class="stats-wrapper">

    <div class="stats-container">

        <div class="stat-card">
            <div class="stat-icon">
                <i class="bi bi-people"></i>
            </div>
            <div class="stat-number">10,000+</div>
            <div class="stat-label">Students Reached</div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">
                <i class="bi bi-lightbulb"></i>
            </div>
            <div class="stat-number">2,500+</div>
            <div class="stat-label">Learning Materials</div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">
                <i class="bi bi-graph-up"></i>
            </div>
            <div class="stat-number">850+</div>
            <div class="stat-label">Active Volunteers</div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">
                <i class="bi bi-award"></i>
            </div>
            <div class="stat-number">1,200+</div>
            <div class="stat-label">Success Stories</div>
        </div>

    </div>

</section>


<!-- LATEST UPDATES -->
<section class="latest-updates">

    <div class="updates-heading">

        <h2>Latest Updates</h2>

        <a asp-controller="Forum"
           asp-action="Index"
           class="view-all-btn">
            View All Posts
        </a>

    </div>


    <div class="updates-grid">

        <div class="update-card">
            <img src="~/images/update1.jpg"
                 alt="Community education">

            <div class="update-card-body">
                <h3>Community Education Program</h3>

                <p>
                    Discover our latest community education initiatives
                    and activities.
                </p>
            </div>
        </div>


        <div class="update-card">
            <img src="~/images/update2.jpg"
                 alt="Volunteer activities">

            <div class="update-card-body">
                <h3>Volunteer Activities</h3>

                <p>
                    See how our volunteers are helping students
                    and communities.
                </p>
            </div>
        </div>


        <div class="update-card">
            <img src="~/images/update3.jpg"
                 alt="Educational resources">

            <div class="update-card-body">
                <h3>New Learning Materials</h3>

                <p>
                    Explore the latest educational resources
                    available on Onudhabon.
                </p>
            </div>
        </div>

    </div>

</section>