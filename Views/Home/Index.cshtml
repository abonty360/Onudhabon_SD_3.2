@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center py-5">
    <h1 class="display-4 fw-bold text-primary mb-3">Onudhabon</h1>
    <h3 class="fw-semibold text-secondary mb-3">Exploring Education</h3>
    <p class="lead text-muted mb-4">Join our mission to explore education as an Educator, Local Guardian, or Student.</p>
    <div class="d-flex justify-content-center gap-3">
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg px-4">Sign In</a>
        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-lg px-4">Register</a>
    </div>
</div>
