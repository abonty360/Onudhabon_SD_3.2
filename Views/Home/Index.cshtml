@{
    ViewData["Title"] = "Home Page - Onudhabon";
}

<div class="text-center py-5">
    <div class="mb-3">
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1.5 rounded-pill fs-6">
            Exploring Education
        </span>
    </div>
    <h1 class="display-5 fw-bold text-dark mb-3">Welcome to Onudhabon</h1>
    <p class="lead text-muted mb-4 mx-auto" style="max-width: 600px;">
        An open digital education initiative offering recorded video lectures, comprehensive study materials, and community volunteer empowerment.
    </p>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <div class="card mx-auto shadow-sm p-4 border-0 rounded-4 text-start" style="max-width: 540px; background-color: #f8fafc;">
            <div class="card-body p-0">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1.5 rounded-pill">
                        ✓ Authenticated
                    </span>
                    @if (User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role) != null)
                    {
                        var role = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value;
                        <span class="badge @(role == "Admin" ? "bg-danger" : "bg-primary") text-white px-3 py-1.5 rounded-pill">
                            @role
                        </span>
                    }
                </div>
                <h4 class="card-title fw-bold text-dark mb-1">Hello, @(User.Identity.Name)!</h4>
                <p class="card-text text-muted mb-3 small">
                    Email: @(User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Email)?.Value)
                </p>

                <div class="p-3 bg-white rounded-3 border mb-3">
                    <div class="row g-2 small">
                        <div class="col-6">
                            <span class="text-muted d-block">City:</span>
                            <span class="fw-semibold text-dark">@(User.Claims.FirstOrDefault(c => c.Type == "City")?.Value ?? "N/A")</span>
                        </div>
                        <div class="col-6">
                            <span class="text-muted d-block">Region / Area:</span>
                            <span class="fw-semibold text-dark">@(User.Claims.FirstOrDefault(c => c.Type == "Area")?.Value ?? "N/A")</span>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-primary rounded-pill flex-fill">
                        👤 My Profile
                    </a>
                    @if (User.IsInRole("Admin") || User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value == "Admin")
                    {
                        <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-danger rounded-pill flex-fill">
                            🛡️ Admin Dashboard
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Lecture" asp-action="Index" class="btn btn-primary rounded-pill flex-fill">
                            🎥 Browse Lectures
                        </a>
                    }
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger rounded-pill px-3">Sign Out</button>
                    </form>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-center flex-wrap gap-3 mb-4">
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg px-4 rounded-pill">Sign In</a>
            <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-lg px-4 rounded-pill">Register as Volunteer</a>
            <a asp-controller="Lecture" asp-action="Index" class="btn btn-light border btn-lg px-4 rounded-pill">🎥 Recorded Lectures</a>
            <a asp-controller="Material" asp-action="Index" class="btn btn-light border btn-lg px-4 rounded-pill">📄 Study Materials</a>
        </div>
    }
</div>