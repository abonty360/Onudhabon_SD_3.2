@{
    ViewData["Title"] = "About Us - Onudhabon";
}

<div class="container py-5" style="max-width: 960px;">
    <!-- Header Banner Card -->
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 mb-4 text-white" style="background: linear-gradient(135deg, #0b1329 0%, #1e293b 50%, #1d4ed8 100%);">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-white bg-opacity-10 text-white small fw-semibold mb-3">
            <i class="bi bi-building"></i>
            <span>About Onudhabon</span>
        </div>
        <h1 class="fw-bold display-6 mb-3">Exploring Education Through Community</h1>
        <p class="fs-6 text-white text-opacity-75 mb-0" style="max-width: 750px; line-height: 1.7;">
            Onudhabon is a non-profit educational initiative dedicated to bridging the educational divide across Bangladesh. 
            We connect volunteer educators, local guardians, and underprivileged students to deliver high-quality digital learning resources completely free of cost.
        </p>
    </div>

    <!-- Mission & Vision Row -->
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="rounded-circle bg-primary-subtle text-primary d-inline-flex align-items-center justify-content-center p-3 mb-3" style="width: 54px; height: 54px; font-size: 1.5rem;">
                    <i class="bi bi-bullseye"></i>
                </div>
                <h4 class="fw-bold text-dark mb-2">Our Mission</h4>
                <p class="text-secondary mb-0" style="line-height: 1.6;">
                    To democratize access to quality education by providing structured, curriculum-aligned video lectures and comprehensive study materials to every student regardless of geographic or financial boundaries.
                </p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="rounded-circle bg-success-subtle text-success d-inline-flex align-items-center justify-content-center p-3 mb-3" style="width: 54px; height: 54px; font-size: 1.5rem;">
                    <i class="bi bi-compass"></i>
                </div>
                <h4 class="fw-bold text-dark mb-2">Our Vision</h4>
                <p class="text-secondary mb-0" style="line-height: 1.6;">
                    A future where every child in Bangladesh has the mentorship, learning resources, and community encouragement needed to unlock their full academic potential and thrive.
                </p>
            </div>
        </div>
    </div>

    <!-- Core Pillars -->
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white mb-4">
        <h3 class="fw-bold text-dark mb-4 text-center">What We Provide</h3>
        <div class="row g-4">
            <div class="col-md-6 col-lg-3 text-center">
                <div class="rounded-circle bg-primary-subtle text-primary d-inline-flex align-items-center justify-content-center p-3 mb-3" style="width: 60px; height: 60px; font-size: 1.6rem;">
                    <i class="bi bi-play-circle-fill"></i>
                </div>
                <h5 class="fw-bold text-dark mb-2">Video Lectures</h5>
                <p class="text-muted small mb-0">High quality, topic-wise video lessons for Classes 1 to 12.</p>
            </div>
            <div class="col-md-6 col-lg-3 text-center">
                <div class="rounded-circle bg-info-subtle text-info d-inline-flex align-items-center justify-content-center p-3 mb-3" style="width: 60px; height: 60px; font-size: 1.6rem;">
                    <i class="bi bi-file-earmark-pdf-fill"></i>
                </div>
                <h5 class="fw-bold text-dark mb-2">Study Materials</h5>
                <p class="text-muted small mb-0">Downloadable worksheets, notes, and exam practice sheets.</p>
            </div>
            <div class="col-md-6 col-lg-3 text-center">
                <div class="rounded-circle bg-warning-subtle text-warning d-inline-flex align-items-center justify-content-center p-3 mb-3" style="width: 60px; height: 60px; font-size: 1.6rem;">
                    <i class="bi bi-chat-quote-fill"></i>
                </div>
                <h5 class="fw-bold text-dark mb-2">Community Forum</h5>
                <p class="text-muted small mb-0">Open discussions between educators, guardians, and students.</p>
            </div>
            <div class="col-md-6 col-lg-3 text-center">
                <div class="rounded-circle bg-danger-subtle text-danger d-inline-flex align-items-center justify-content-center p-3 mb-3" style="width: 60px; height: 60px; font-size: 1.6rem;">
                    <i class="bi bi-people-fill"></i>
                </div>
                <h5 class="fw-bold text-dark mb-2">Local Guardians</h5>
                <p class="text-muted small mb-0">Grassroots mentors facilitating student learning & enrollment.</p>
            </div>
        </div>
    </div>

    <!-- Quick Action / Get Involved -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-light text-center">
        <h4 class="fw-bold text-dark mb-2">Join Our Mission</h4>
        <p class="text-muted mb-3" style="max-width: 600px; margin: 0 auto;">
            Whether you want to contribute lectures as a volunteer educator or register underprivileged students as a local guardian, Onudhabon welcomes you.
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a asp-controller="Lecture" asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2">
                Watch Lectures
            </a>
            <a asp-controller="Material" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4 py-2">
                Browse Materials
            </a>
            <a asp-controller="Forum" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                Visit Forum
            </a>
        </div>
    </div>
</div>
