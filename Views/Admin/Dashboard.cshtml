@model Onudhabon_ISD.Models.AdminDashboardViewModel
@inject Onudhabon_ISD.Services.ICloudinaryService CloudinaryService

@{
    ViewData["Title"] = "Admin Dashboard - Onudhabon";
    var activeTab = (string)(ViewBag.ActiveTab ?? "volunteers");
}

<div class="container-fluid px-lg-4 py-4">
    <!-- Top Dashboard Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3 border-bottom pb-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-danger px-3 py-1.5 rounded-pill fs-6">Administrator Portal</span>
                <span class="text-muted small">System Governance & Content Verification</span>
            </div>
            <h2 class="fw-bold mb-0 text-dark">Administrative Dashboard</h2>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Dashboard" asp-route-tab="@activeTab" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-2">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="me-1 align-text-bottom">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                Refresh Data
            </a>
        </div>
    </div>

    <!-- Feedback Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm" role="alert">
            <strong>Success:</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm" role="alert">
            <strong>Error:</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Modern SaaS Metric Cards Section -->
    <div class="mb-4">
        <!-- Top Primary KPI Highlights -->
        <div class="row g-3 mb-3">
            <div class="col-sm-6 col-xl-3">
                <div class="saas-metric-card highlight-primary">
                    <div>
                        <div class="metric-header">
                            <span class="metric-title">Total Users</span>
                            <div class="metric-icon-badge bg-primary-subtle text-primary">
                                <i class="bi bi-people-fill"></i>
                            </div>
                        </div>
                        <div class="metric-value">@Model.TotalUsers</div>
                    </div>
                    <div class="metric-subtext">
                        <i class="bi bi-person-check text-primary"></i>
                        <span>Registered accounts</span>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="saas-metric-card highlight-success">
                    <div>
                        <div class="metric-header">
                            <span class="metric-title">Active Volunteers</span>
                            <div class="metric-icon-badge bg-success-subtle text-success">
                                <i class="bi bi-patch-check-fill"></i>
                            </div>
                        </div>
                        <div class="metric-value text-success">@Model.ActiveVolunteersCount</div>
                    </div>
                    <div class="metric-subtext">
                        <span class="badge bg-success-subtle text-success rounded-pill px-2 py-0.5">
                            <i class="bi bi-check-circle-fill me-1"></i>Verified Active
                        </span>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="saas-metric-card highlight-rose">
                    <div>
                        <div class="metric-header">
                            <span class="metric-title">bKash Donations</span>
                            <div class="metric-icon-badge" style="background-color: #fdf2f8; color: #e2136e;">
                                <i class="bi bi-cash-stack"></i>
                            </div>
                        </div>
                        <div class="metric-value" style="color: #be185d;">৳@Model.TotalDonationsAmount.ToString("N0")</div>
                    </div>
                    <div class="metric-subtext">
                        <i class="bi bi-heart-fill text-danger"></i>
                        <span>@Model.CompletedDonationsCount gifts (@Model.TotalDonorsCount donors)</span>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="saas-metric-card highlight-warning">
                    <div>
                        <div class="metric-header">
                            <span class="metric-title">Review Queue</span>
                            <div class="metric-icon-badge bg-warning-subtle text-warning">
                                <i class="bi bi-hourglass-split"></i>
                            </div>
                        </div>
                        <div class="metric-value text-warning-emphasis">
                            @(Model.PendingVolunteersCount + Model.PendingLecturesCount + Model.PendingMaterialsCount + Model.PendingForumPostsCount + Model.PendingStudentsCount)
                        </div>
                    </div>
                    <div class="metric-subtext">
                        <span class="badge bg-warning text-dark rounded-pill px-2 py-0.5">
                            <i class="bi bi-clock-history me-1"></i>Total Pending Tasks
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Secondary Moderation Queue Metric Row -->
        <div class="row row-cols-2 row-cols-md-3 row-cols-xl-6 g-3">
            <div class="col">
                <div class="saas-metric-card p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-semibold">Pending Users</span>
                        <div class="metric-icon-badge bg-warning-subtle text-warning" style="width: 34px; height: 34px; font-size: 1rem; border-radius: 9px;">
                            <i class="bi bi-person-plus-fill"></i>
                        </div>
                    </div>
                    <div class="h4 fw-bold text-dark mb-0">@Model.PendingVolunteersCount</div>
                    <div class="text-muted" style="font-size: 0.75rem;">Volunteers review</div>
                </div>
            </div>

            <div class="col">
                <div class="saas-metric-card p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-semibold">Pending Lectures</span>
                        <div class="metric-icon-badge bg-primary-subtle text-primary" style="width: 34px; height: 34px; font-size: 1rem; border-radius: 9px;">
                            <i class="bi bi-camera-video-fill"></i>
                        </div>
                    </div>
                    <div class="h4 fw-bold text-dark mb-0">@Model.PendingLecturesCount</div>
                    <div class="text-muted" style="font-size: 0.75rem;">Videos review</div>
                </div>
            </div>

            <div class="col">
                <div class="saas-metric-card p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-semibold">Pending Materials</span>
                        <div class="metric-icon-badge bg-info-subtle text-info" style="width: 34px; height: 34px; font-size: 1rem; border-radius: 9px;">
                            <i class="bi bi-file-earmark-text-fill"></i>
                        </div>
                    </div>
                    <div class="h4 fw-bold text-dark mb-0">@Model.PendingMaterialsCount</div>
                    <div class="text-muted" style="font-size: 0.75rem;">Docs review</div>
                </div>
            </div>

            <div class="col">
                <div class="saas-metric-card p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-semibold">Pending Posts</span>
                        <div class="metric-icon-badge text-white" style="width: 34px; height: 34px; font-size: 1rem; border-radius: 9px; background-color: #9333ea;">
                            <i class="bi bi-chat-dots-fill"></i>
                        </div>
                    </div>
                    <div class="h4 fw-bold text-dark mb-0">@Model.PendingForumPostsCount</div>
                    <div class="text-muted" style="font-size: 0.75rem;">Forum topics</div>
                </div>
            </div>

            <div class="col">
                <div class="saas-metric-card p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-semibold">Pending Students</span>
                        <div class="metric-icon-badge text-white" style="width: 34px; height: 34px; font-size: 1rem; border-radius: 9px; background-color: #d97706;">
                            <i class="bi bi-mortarboard-fill"></i>
                        </div>
                    </div>
                    <div class="h4 fw-bold text-dark mb-0">@Model.PendingStudentsCount</div>
                    <div class="text-muted" style="font-size: 0.75rem;">Enrollments review</div>
                </div>
            </div>

            <div class="col">
                <div class="saas-metric-card p-3 @(Model.RestrictedUsersCount > 0 ? "border-danger-subtle bg-danger-subtle bg-opacity-25" : "")">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-semibold">Restricted</span>
                        <div class="metric-icon-badge bg-danger-subtle text-danger" style="width: 34px; height: 34px; font-size: 1rem; border-radius: 9px;">
                            <i class="bi bi-slash-circle-fill"></i>
                        </div>
                    </div>
                    <div class="h4 fw-bold @(Model.RestrictedUsersCount > 0 ? "text-danger" : "text-dark") mb-0">@Model.RestrictedUsersCount</div>
                    <div class="text-muted" style="font-size: 0.75rem;">Blocked accounts</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Navigation Tabs -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-white border-bottom p-3">
            <ul class="nav nav-pills card-header-pills gap-2 flex-wrap" id="adminTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill px-4 py-2 @(activeTab == "volunteers" ? "active fw-semibold" : "text-dark")" 
                            id="volunteers-tab" data-bs-toggle="tab" data-bs-target="#volunteers-tab-pane" type="button" role="tab">
                        <i class="bi bi-people me-1.5"></i> Registered Users & Volunteers
                        @if (Model.PendingVolunteersCount > 0)
                        {
                            <span class="badge bg-warning text-dark rounded-pill ms-1.5">@Model.PendingVolunteersCount</span>
                        }
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill px-4 py-2 @(activeTab == "lectures" ? "active fw-semibold" : "text-dark")" 
                            id="lectures-tab" data-bs-toggle="tab" data-bs-target="#lectures-tab-pane" type="button" role="tab">
                        <i class="bi bi-camera-video me-1.5"></i> Lectures Moderation
                        @if (Model.PendingLecturesCount > 0)
                        {
                            <span class="badge bg-primary text-white rounded-pill ms-1.5">@Model.PendingLecturesCount</span>
                        }
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill px-4 py-2 @(activeTab == "materials" ? "active fw-semibold" : "text-dark")" 
                            id="materials-tab" data-bs-toggle="tab" data-bs-target="#materials-tab-pane" type="button" role="tab">
                        <i class="bi bi-file-earmark-text me-1.5"></i> Materials Moderation
                        @if (Model.PendingMaterialsCount > 0)
                        {
                            <span class="badge bg-info text-dark rounded-pill ms-1.5">@Model.PendingMaterialsCount</span>
                        }
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill px-4 py-2 @(activeTab == "forum" ? "active fw-semibold" : "text-dark")" 
                            id="forum-tab" data-bs-toggle="tab" data-bs-target="#forum-tab-pane" type="button" role="tab">
                        <i class="bi bi-chat-dots me-1.5"></i> Forum Moderation
                        @if (Model.PendingForumPostsCount > 0)
                        {
                            <span class="badge rounded-pill ms-1.5" style="background-color: #7e22ce; color: #fff;">@Model.PendingForumPostsCount</span>
                        }
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill px-4 py-2 @(activeTab == "students" ? "active fw-semibold" : "text-dark")" 
                            id="students-tab" data-bs-toggle="tab" data-bs-target="#students-tab-pane" type="button" role="tab">
                        <i class="bi bi-mortarboard me-1.5"></i> Student Enrollments
                        @if (Model.PendingStudentsCount > 0)
                        {
                            <span class="badge bg-warning text-dark rounded-pill ms-1.5">@Model.PendingStudentsCount</span>
                        }
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill px-4 py-2 @(activeTab == "donations" ? "active fw-semibold" : "text-dark")" 
                            id="donations-tab" data-bs-toggle="tab" data-bs-target="#donations-tab-pane" type="button" role="tab">
                        <i class="bi bi-cash-stack me-1.5"></i> Donations & bKash
                        <span class="badge bg-success text-white rounded-pill ms-1.5">@Model.CompletedDonationsCount</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill px-4 py-2 @(activeTab == "rankings" ? "active fw-semibold" : "text-dark")" 
                            id="rankings-tab" data-bs-toggle="tab" data-bs-target="#rankings-tab-pane" type="button" role="tab">
                        <i class="bi bi-trophy me-1.5"></i> Monthly Rankings
                    </button>
                </li>
            </ul>
        </div>

        <div class="card-body p-4">
            <div class="tab-content" id="adminTabContent">

                <!-- ================= TAB 1: VOLUNTEERS & USERS ================= -->
                <div class="tab-pane fade @(activeTab == "volunteers" ? "show active" : "")" id="volunteers-tab-pane" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <div>
                            <h5 class="fw-bold text-dark mb-0">Volunteer Registrations & Users</h5>
                            <p class="text-muted small mb-0">Review volunteer applications, approve/decline status, and manage restrictions.</p>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle border rounded-3 overflow-hidden">
                            <thead class="table-light small text-muted text-uppercase">
                                <tr>
                                    <th>User Info</th>
                                    <th>Role</th>
                                    <th>Contributions & Activity</th>
                                    <th>Location</th>
                                    <th>Verification</th>
                                    <th>Restricted</th>
                                    <th>Joined</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var currentMonth = DateTime.UtcNow.Month;
                                    var currentYear = DateTime.UtcNow.Year;
                                }
                                @foreach (var user in Model.Users)
                                {
                                    // Educator metrics
                                    var educatorLectures = Model.Lectures.Where(l => !string.IsNullOrEmpty(l.Instructor) &&
                                        (l.Instructor.Equals(user.FullName, StringComparison.OrdinalIgnoreCase) || l.Instructor.Equals(user.Email, StringComparison.OrdinalIgnoreCase))).ToList();
                                    var activeLecturesCount = educatorLectures.Count(l => l.Status == "Active" || l.Status == "Approved");

                                    var educatorMaterials = Model.Materials.Where(m => !string.IsNullOrEmpty(m.Instructor) &&
                                        (m.Instructor.Equals(user.FullName, StringComparison.OrdinalIgnoreCase) || m.Instructor.Equals(user.Email, StringComparison.OrdinalIgnoreCase))).ToList();
                                    var activeMaterialsCount = educatorMaterials.Count(m => m.Status == "Active" || m.Status == "Approved");
                                    var totalDownloadsCount = educatorMaterials.Sum(m => m.Downloads);

                                    var monthlyActiveContentCount = educatorLectures.Count(l => (l.Status == "Active" || l.Status == "Approved") && l.CreatedAt.Month == currentMonth && l.CreatedAt.Year == currentYear)
                                        + educatorMaterials.Count(m => (m.Status == "Active" || m.Status == "Approved") && m.Date.Month == currentMonth && m.Date.Year == currentYear);

                                    // Local Guardian metrics
                                    var guardianStudents = Model.Students.Where(s => 
                                        (!string.IsNullOrEmpty(s.GuardianId) && (s.GuardianId == user.Id.ToString() || s.GuardianId.Equals(user.Email, StringComparison.OrdinalIgnoreCase))) ||
                                        (!string.IsNullOrEmpty(s.GuardianName) && (s.GuardianName.Equals(user.FullName, StringComparison.OrdinalIgnoreCase) || s.GuardianName.Equals(user.Email, StringComparison.OrdinalIgnoreCase)))).ToList();

                                    var totalStudentsAssigned = guardianStudents.Count;
                                    var activeStudentsCount = guardianStudents.Count(s => s.Status == "Active" || s.Status == "Approved");
                                    var avgStudentProgress = totalStudentsAssigned > 0 ? (int)Math.Round(guardianStudents.Average(s => s.ProgressPercentage)) : 0;
                                    var totalCompletedStudentLectures = guardianStudents.Sum(s => s.CompletedClasses);

                                    // Community Forum metrics
                                    var userForumPosts = Model.ForumPosts.Where(f => !string.IsNullOrEmpty(f.Author) &&
                                        (f.Author.Equals(user.FullName, StringComparison.OrdinalIgnoreCase) || f.Author.Equals(user.Email, StringComparison.OrdinalIgnoreCase))).ToList();
                                    var forumPostsCount = userForumPosts.Count;
                                    var forumLikesCount = userForumPosts.Sum(f => f.Likes);

                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2.5">
                                                @if (!string.IsNullOrWhiteSpace(user.Picture))
                                                {
                                                    <img src="@CloudinaryService.GetAvatarUrl(user.Picture, 60)" 
                                                         alt="@user.FullName" 
                                                         class="rounded-circle border" 
                                                         style="width: 38px; height: 38px; object-fit: cover;" />
                                                }
                                                else
                                                {
                                                    <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center" 
                                                         style="width: 38px; height: 38px; font-size: 0.85rem;">
                                                        @(string.IsNullOrEmpty(user.FullName) ? "U" : user.FullName.Substring(0, 1).ToUpper())
                                                    </div>
                                                }
                                                <div>
                                                    <button type="button" class="btn btn-link text-decoration-none p-0 fw-bold text-dark text-start" data-bs-toggle="modal" data-bs-target="#userModal-@user.Id">
                                                        @user.FullName
                                                    </button>
                                                    <div class="text-muted small">@user.Email</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            @if (user.Role == "Educator")
                                            {
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">Educator</span>
                                            }
                                            else if (user.Role == "Local Guardian")
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Local Guardian</span>
                                            }
                                            else if (user.Role == "Admin")
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill">Admin</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary rounded-pill">@user.Role</span>
                                            }
                                        </td>
                                        <td>
                                            @if (user.Role == "Educator")
                                            {
                                                <div class="small">
                                                    <div class="d-flex align-items-center gap-1.5 mb-1">
                                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-0.5">
                                                            <i class="bi bi-camera-video me-1"></i><strong>@activeLecturesCount</strong> Lectures
                                                        </span>
                                                        <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-2 py-0.5">
                                                            <i class="bi bi-file-earmark-text me-1"></i><strong>@activeMaterialsCount</strong> Docs
                                                        </span>
                                                    </div>
                                                    <div class="text-muted small d-flex align-items-center gap-2">
                                                        <span><i class="bi bi-calendar-event me-0.5"></i><strong>@monthlyActiveContentCount</strong> this month</span>
                                                        @if (totalDownloadsCount > 0)
                                                        {
                                                            <span>• <i class="bi bi-download me-0.5"></i><strong>@totalDownloadsCount</strong> DLs</span>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                            else if (user.Role == "Local Guardian")
                                            {
                                                <div class="small">
                                                    <div class="d-flex align-items-center gap-1.5 mb-1">
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-0.5">
                                                            <i class="bi bi-mortarboard me-1"></i><strong>@totalStudentsAssigned</strong> Students (@activeStudentsCount active)
                                                        </span>
                                                    </div>
                                                    <div class="text-muted small d-flex align-items-center gap-2">
                                                        <span><i class="bi bi-graph-up me-0.5"></i>Avg Progress: <strong>@avgStudentProgress%</strong></span>
                                                        <span>• <i class="bi bi-check2-circle me-0.5"></i><strong>@totalCompletedStudentLectures</strong> classes done</span>
                                                    </div>
                                                </div>
                                            }
                                            else if (user.Role == "Admin")
                                            {
                                                <div class="text-muted small">
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-0.5">
                                                        <i class="bi bi-shield-lock me-1"></i>System Governance
                                                    </span>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="text-muted small">
                                                    @if (forumPostsCount > 0)
                                                    {
                                                        <span><i class="bi bi-chat-dots me-0.5"></i>@forumPostsCount posts (@forumLikesCount likes)</span>
                                                    }
                                                    else
                                                    {
                                                        <span>Standard Member</span>
                                                    }
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <div class="small fw-semibold text-dark">@user.City</div>
                                            <div class="text-muted small">@user.Area</div>
                                        </td>
                                        <td>
                                            @if (user.VerificationStatus == "Active" || user.VerificationStatus == "Approved")
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1">
                                                    Active
                                                </span>
                                            }
                                            else if (user.VerificationStatus == "Declined")
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1">
                                                    Declined
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2.5 py-1">
                                                    Pending
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            @if (user.IsRestricted)
                                            {
                                                <span class="badge bg-danger rounded-pill px-2.5">Restricted</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border rounded-pill">No</span>
                                            }
                                        </td>
                                        <td class="small text-muted">@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                                        <td class="text-end">
                                            <div class="d-inline-flex gap-1.5">
                                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2.5" data-bs-toggle="modal" data-bs-target="#userModal-@user.Id" title="View Full Profile Preview">
                                                    Preview
                                                </button>

                                                @if (user.Role != "Admin")
                                                {
                                                    @if (user.VerificationStatus != "Active" && user.VerificationStatus != "Approved")
                                                    {
                                                        <form asp-action="ApproveUser" asp-route-id="@user.Id" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-sm btn-success rounded-pill px-2.5 d-inline-flex align-items-center gap-1" title="Approve Volunteer (Sets Active)">
                                                                <i class="bi bi-check-lg"></i>
                                                                <span>Approve</span>
                                                            </button>
                                                        </form>
                                                    }

                                                    @if (user.VerificationStatus != "Declined")
                                                    {
                                                        <form asp-action="DeclineUser" asp-route-id="@user.Id" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2.5 d-inline-flex align-items-center gap-1" title="Decline Volunteer">
                                                                <i class="bi bi-x-lg"></i>
                                                                <span>Decline</span>
                                                            </button>
                                                        </form>
                                                    }

                                                    <form asp-action="ToggleRestrictUser" asp-route-id="@user.Id" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm @(user.IsRestricted ? "btn-warning" : "btn-outline-dark") rounded-pill px-2.5 d-inline-flex align-items-center gap-1" title="@(user.IsRestricted ? "Unrestrict User" : "Restrict User (Blocks Login)")">
                                                            <i class="bi @(user.IsRestricted ? "bi-unlock" : "bi-slash-circle")"></i>
                                                            <span>@(user.IsRestricted ? "Unrestrict" : "Restrict")</span>
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>

                                    <!-- User Detail Preview Modal -->
                                    <div class="modal fade" id="userModal-@user.Id" tabindex="-1" aria-labelledby="userModalLabel-@user.Id" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered modal-lg">
                                            <div class="modal-content rounded-4 border-0 shadow">
                                                <div class="modal-header border-bottom-0 pb-0">
                                                    <div class="d-flex align-items-center gap-3">
                                                        @if (!string.IsNullOrWhiteSpace(user.Picture))
                                                        {
                                                            <img src="@CloudinaryService.GetAvatarUrl(user.Picture, 100)" alt="@user.FullName" class="rounded-circle border" style="width: 54px; height: 54px; object-fit: cover;" />
                                                        }
                                                        else
                                                        {
                                                            <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center" style="width: 54px; height: 54px; font-size: 1.3rem;">
                                                                @(string.IsNullOrEmpty(user.FullName) ? "U" : user.FullName.Substring(0, 1).ToUpper())
                                                            </div>
                                                        }
                                                        <div>
                                                            <h5 class="modal-title fw-bold text-dark mb-0" id="userModalLabel-@user.Id">@user.FullName</h5>
                                                            <span class="badge bg-secondary-subtle text-secondary rounded-pill me-1">@user.Role</span>
                                                            <span class="badge @(user.VerificationStatus == "Active" ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning") rounded-pill">Status: @(user.VerificationStatus ?? "Pending")</span>
                                                            @if (user.IsRestricted)
                                                            {
                                                                <span class="badge bg-danger rounded-pill">RESTRICTED</span>
                                                            }
                                                        </div>
                                                    </div>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body py-4">
                                                    <div class="row g-3 small">
                                                        <div class="col-sm-6">
                                                            <div class="text-muted">Email:</div>
                                                            <div class="fw-semibold text-dark">@user.Email</div>
                                                        </div>
                                                        <div class="col-sm-6">
                                                            <div class="text-muted">Phone:</div>
                                                            <div class="fw-semibold text-dark">@user.PhoneNumber</div>
                                                        </div>
                                                        <div class="col-sm-6">
                                                            <div class="text-muted">City / Region:</div>
                                                            <div class="fw-semibold text-dark">@user.City, @user.Area</div>
                                                        </div>
                                                        <div class="col-sm-6">
                                                            <div class="text-muted">Detailed Address:</div>
                                                            <div class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(user.Location) ? "—" : user.Location)</div>
                                                        </div>
                                                        <div class="col-sm-6">
                                                            <div class="text-muted">Age / NID:</div>
                                                            <div class="fw-semibold text-dark">Age: @(user.Age?.ToString() ?? "—"), NID: @(user.NidNumber ?? "—")</div>
                                                        </div>
                                                        <div class="col-sm-6">
                                                            <div class="text-muted">Registration Date:</div>
                                                            <div class="fw-semibold text-dark">@user.CreatedAt.ToString("f")</div>
                                                        </div>

                                                        <div class="col-12 border-top pt-2 mt-2">
                                                            <h6 class="fw-bold text-dark mb-2">Educational Qualifications</h6>
                                                            <div class="row g-2">
                                                                <div class="col-sm-6"><strong>Highest Level:</strong> @(user.EducationLevel ?? "—")</div>
                                                                <div class="col-sm-6"><strong>Major:</strong> @(user.Major ?? "—")</div>
                                                                <div class="col-sm-6"><strong>University:</strong> @(user.UniversityName ?? "—") @(!string.IsNullOrWhiteSpace(user.UniversityPassingYear) ? $"({user.UniversityPassingYear})" : "")</div>
                                                                <div class="col-sm-6"><strong>HSC:</strong> @(user.HscInstitute ?? "—") @(!string.IsNullOrWhiteSpace(user.HscPassingYear) ? $"({user.HscPassingYear})" : "")</div>
                                                                <div class="col-sm-6"><strong>SSC:</strong> @(user.SscInstitute ?? "—") @(!string.IsNullOrWhiteSpace(user.SscPassingYear) ? $"({user.SscPassingYear})" : "")</div>
                                                            </div>
                                                        </div>

                                                        @if (!string.IsNullOrWhiteSpace(user.CertificatePicture))
                                                        {
                                                            <div class="col-12 border-top pt-2">
                                                                <div class="text-muted mb-1">Attached Certificate Document:</div>
                                                                <a href="@user.CertificatePicture" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill d-inline-flex align-items-center gap-1.5">
                                                                    <i class="bi bi-file-earmark-pdf"></i>
                                                                    <span>Open Uploaded Document on Cloudinary</span>
                                                                </a>
                                                            </div>
                                                        }

                                                        @if (user.Role == "Educator")
                                                        {
                                                            <div class="col-12 border-top pt-2 mt-2">
                                                                <h6 class="fw-bold text-dark mb-2 d-flex align-items-center gap-1.5">
                                                                    <i class="bi bi-graph-up-arrow text-primary"></i> Educator Contributions & Activity
                                                                </h6>
                                                                <div class="row g-2">
                                                                    <div class="col-sm-6">
                                                                        <div class="p-2.5 rounded-3 bg-light border">
                                                                            <div class="text-muted small">Approved Video Lectures:</div>
                                                                            <div class="fw-bold fs-6 text-primary">@activeLecturesCount <span class="text-muted fw-normal small">(@educatorLectures.Count total uploaded)</span></div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-sm-6">
                                                                        <div class="p-2.5 rounded-3 bg-light border">
                                                                            <div class="text-muted small">Approved Study Materials:</div>
                                                                            <div class="fw-bold fs-6 text-info">@activeMaterialsCount <span class="text-muted fw-normal small">(@educatorMaterials.Count total uploaded)</span></div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-sm-6">
                                                                        <div class="p-2.5 rounded-3 bg-light border">
                                                                            <div class="text-muted small">This Month's Uploads:</div>
                                                                            <div class="fw-bold fs-6 text-dark">@monthlyActiveContentCount content files</div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-sm-6">
                                                                        <div class="p-2.5 rounded-3 bg-light border">
                                                                            <div class="text-muted small">Total Material Downloads:</div>
                                                                            <div class="fw-bold fs-6 text-dark">@totalDownloadsCount downloads</div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }
                                                        else if (user.Role == "Local Guardian")
                                                        {
                                                            <div class="col-12 border-top pt-2 mt-2">
                                                                <h6 class="fw-bold text-dark mb-2 d-flex align-items-center gap-1.5">
                                                                    <i class="bi bi-graph-up-arrow text-success"></i> Local Guardian Student Oversight
                                                                </h6>
                                                                <div class="row g-2">
                                                                    <div class="col-sm-6">
                                                                        <div class="p-2.5 rounded-3 bg-light border">
                                                                            <div class="text-muted small">Total Assigned Students:</div>
                                                                            <div class="fw-bold fs-6 text-success">@totalStudentsAssigned <span class="text-muted fw-normal small">(@activeStudentsCount active verified)</span></div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-sm-6">
                                                                        <div class="p-2.5 rounded-3 bg-light border">
                                                                            <div class="text-muted small">Average Student Progress:</div>
                                                                            <div class="fw-bold fs-6 text-success">@avgStudentProgress%</div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-sm-6">
                                                                        <div class="p-2.5 rounded-3 bg-light border">
                                                                            <div class="text-muted small">Total Completed Classes:</div>
                                                                            <div class="fw-bold fs-6 text-dark">@totalCompletedStudentLectures lectures completed</div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-sm-6">
                                                                        <div class="p-2.5 rounded-3 bg-light border">
                                                                            <div class="text-muted small">Community Engagement:</div>
                                                                            <div class="fw-bold fs-6 text-dark">@forumPostsCount forum posts (@forumLikesCount likes)</div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }

                                                        @if (!string.IsNullOrWhiteSpace(user.Bio))
                                                        {
                                                            <div class="col-12 border-top pt-2">
                                                                <div class="text-muted">Bio:</div>
                                                                <p class="mb-0 text-dark">@user.Bio</p>
                                                            </div>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(user.VolunteerReason))
                                                        {
                                                            <div class="col-12 border-top pt-2">
                                                                <div class="text-muted">Volunteer Motivation:</div>
                                                                <p class="mb-0 text-dark">@user.VolunteerReason</p>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="modal-footer border-top-0 pt-0 d-flex justify-content-between">
                                                    <div>
                                                        @if (user.Role != "Admin")
                                                        {
                                                            <form asp-action="ToggleRestrictUser" asp-route-id="@user.Id" method="post" class="d-inline">
                                                                @Html.AntiForgeryToken()
                                                                <button type="submit" class="btn btn-sm @(user.IsRestricted ? "btn-warning" : "btn-danger") rounded-pill px-3 d-inline-flex align-items-center gap-1.5">
                                                                    <i class="bi @(user.IsRestricted ? "bi-unlock" : "bi-slash-circle")"></i>
                                                                    <span>@(user.IsRestricted ? "Unrestrict User" : "Restrict User")</span>
                                                                </button>
                                                            </form>
                                                        }
                                                    </div>
                                                    <div class="d-flex gap-2">
                                                        @if (user.Role != "Admin" && user.VerificationStatus != "Active")
                                                        {
                                                            <form asp-action="ApproveUser" asp-route-id="@user.Id" method="post" class="d-inline">
                                                                @Html.AntiForgeryToken()
                                                                <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 d-inline-flex align-items-center gap-1.5">
                                                                    <i class="bi bi-check-lg"></i>
                                                                    <span>Approve Volunteer</span>
                                                                </button>
                                                            </form>
                                                        }
                                                        @if (user.Role != "Admin" && user.VerificationStatus != "Declined")
                                                        {
                                                            <form asp-action="DeclineUser" asp-route-id="@user.Id" method="post" class="d-inline">
                                                                @Html.AntiForgeryToken()
                                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3 d-inline-flex align-items-center gap-1.5">
                                                                    <i class="bi bi-x-lg"></i>
                                                                    <span>Decline</span>
                                                                </button>
                                                            </form>
                                                        }
                                                        <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Close</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- ================= TAB 2: LECTURES MODERATION ================= -->
                <div class="tab-pane fade @(activeTab == "lectures" ? "show active" : "")" id="lectures-tab-pane" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <div>
                            <h5 class="fw-bold text-dark mb-0">Lecture Moderation & Approvals</h5>
                            <p class="text-muted small mb-0">Preview pending video lectures, verify educators, approve/decline uploads, and restrict educators if necessary.</p>
                        </div>
                    </div>

                    @if (!Model.Lectures.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <p>No video lectures in catalog yet.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle border rounded-3 overflow-hidden">
                                <thead class="table-light small text-muted text-uppercase">
                                    <tr>
                                        <th>Lecture</th>
                                        <th>Class & Subject</th>
                                        <th>Educator</th>
                                        <th>Status</th>
                                        <th>Uploaded</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var lecture in Model.Lectures)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-2.5">
                                                    <img src="@(lecture.Thumbnail ?? CloudinaryService.GetVideoThumbnailUrl(lecture.VideoUrl, 80, 50))" 
                                                         alt="@lecture.Title" 
                                                         class="rounded border bg-dark" 
                                                         style="width: 60px; height: 38px; object-fit: cover;" 
                                                         onerror="this.src='https://via.placeholder.com/60x38?text=Video';" />
                                                    <div>
                                                        <button type="button" class="btn btn-link text-decoration-none p-0 fw-bold text-dark text-start text-truncate d-inline-block" style="max-width: 280px;" data-bs-toggle="modal" data-bs-target="#lectureModal-@lecture.Id">
                                                            @lecture.Title
                                                        </button>
                                                        <div class="text-muted small text-truncate" style="max-width: 280px;">Topic: @lecture.Topic</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-primary-subtle text-primary border rounded-pill">Class @lecture.ClassLevel</span>
                                                <div class="small text-muted mt-0.5">@lecture.Subject</div>
                                            </td>
                                            <td>
                                                <span class="fw-semibold text-dark">@(lecture.Instructor ?? "Educator")</span>
                                            </td>
                                            <td>
                                                @if (lecture.Status == "Active" || lecture.Status == "Approved")
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1">Active</span>
                                                }
                                                else if (lecture.Status == "Declined")
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1">Declined</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2.5 py-1">Pending</span>
                                                }
                                            </td>
                                            <td class="small text-muted">@lecture.CreatedAt.ToString("MMM dd, yyyy")</td>
                                            <td class="text-end">
                                                <div class="d-inline-flex gap-1.5">
                                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2.5" data-bs-toggle="modal" data-bs-target="#lectureModal-@lecture.Id">
                                                        Preview & Verify
                                                    </button>

                                                    @if (lecture.Status != "Active" && lecture.Status != "Approved")
                                                    {
                                                        <form asp-action="ApproveLecture" asp-route-id="@lecture.Id" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-sm btn-success rounded-pill px-2.5 d-inline-flex align-items-center gap-1">
                                                                <i class="bi bi-check-lg"></i>
                                                                <span>Approve</span>
                                                            </button>
                                                        </form>
                                                    }
                                                    @if (lecture.Status != "Declined")
                                                    {
                                                        <form asp-action="DeclineLecture" asp-route-id="@lecture.Id" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2.5 d-inline-flex align-items-center gap-1">
                                                                <i class="bi bi-x-lg"></i>
                                                                <span>Decline</span>
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            </td>
                                        </tr>

                                        <!-- Lecture Preview Modal with Educator Restriction Button -->
                                        <div class="modal fade" id="lectureModal-@lecture.Id" tabindex="-1" aria-labelledby="lectureModalLabel-@lecture.Id" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered modal-lg">
                                                <div class="modal-content rounded-4 border-0 shadow">
                                                    <div class="modal-header border-bottom-0 pb-0">
                                                        <div>
                                                            <h5 class="modal-title fw-bold text-dark mb-0" id="lectureModalLabel-@lecture.Id">@lecture.Title</h5>
                                                            <div class="text-muted small">Instructor: <strong>@(lecture.Instructor ?? "Educator")</strong> | Class: @lecture.ClassLevel | Subject: @lecture.Subject</div>
                                                        </div>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body py-3">
                                                        @if (!string.IsNullOrWhiteSpace(lecture.VideoUrl))
                                                        {
                                                            <div class="ratio ratio-16x9 rounded-3 overflow-hidden bg-black mb-3 border">
                                                                <video controls playsinline preload="metadata" poster="@lecture.Thumbnail" class="w-100 h-100" style="object-fit: contain;">
                                                                    <source src="@lecture.VideoUrl" type="video/mp4" />
                                                                    Your browser does not support HTML5 video playback.
                                                                </video>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="p-4 bg-light rounded text-center text-muted mb-3">No video URL available.</div>
                                                        }

                                                        <div class="p-3 bg-light rounded-3 small mb-3 border">
                                                            <div class="mb-1"><strong>Topic:</strong> @lecture.Topic</div>
                                                            <div class="mb-1"><strong>Description:</strong> @(string.IsNullOrWhiteSpace(lecture.Description) ? "No description provided." : lecture.Description)</div>
                                                            <div><strong>Status:</strong> <span class="badge @(lecture.Status == "Active" || lecture.Status == "Approved" ? "bg-success" : (lecture.Status == "Declined" ? "bg-danger" : "bg-warning text-dark")) rounded-pill">@lecture.Status</span></div>
                                                        </div>

                                                        @{
                                                            var lectureInstructor = Model.Users.FirstOrDefault(u => !string.IsNullOrEmpty(lecture.Instructor) && 
                                                                (u.FullName.Equals(lecture.Instructor, StringComparison.OrdinalIgnoreCase) || 
                                                                 u.Email.Equals(lecture.Instructor, StringComparison.OrdinalIgnoreCase)));
                                                        }
                                                        <div class="p-3 rounded-3 border bg-white small">
                                                            <div class="fw-bold text-dark mb-2 d-flex align-items-center gap-2">
                                                                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                                                </svg>
                                                                Instructor / Uploader Details
                                                            </div>
                                                            @if (lectureInstructor != null)
                                                            {
                                                                <div class="row g-2">
                                                                    <div class="col-sm-6"><strong>Name:</strong> @lectureInstructor.FullName</div>
                                                                    <div class="col-sm-6"><strong>Email:</strong> @lectureInstructor.Email</div>
                                                                    <div class="col-sm-6"><strong>Phone:</strong> @lectureInstructor.PhoneNumber</div>
                                                                    <div class="col-sm-6"><strong>Location:</strong> @lectureInstructor.City, @lectureInstructor.Area</div>
                                                                    <div class="col-sm-6"><strong>Role / Status:</strong> <span class="badge bg-secondary-subtle text-secondary rounded-pill">@lectureInstructor.Role</span> <span class="badge @(lectureInstructor.VerificationStatus == "Active" ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning") rounded-pill">@(lectureInstructor.VerificationStatus ?? "Pending")</span></div>
                                                                    <div class="col-sm-6"><strong>Account:</strong> @(lectureInstructor.IsRestricted ? "Restricted" : "Active")</div>
                                                                    @if (!string.IsNullOrEmpty(lectureInstructor.EducationLevel))
                                                                    {
                                                                        <div class="col-12"><strong>Education:</strong> @lectureInstructor.EducationLevel @(!string.IsNullOrEmpty(lectureInstructor.Major) ? $"in {lectureInstructor.Major}" : "") @(!string.IsNullOrEmpty(lectureInstructor.UniversityName) ? $"({lectureInstructor.UniversityName})" : "")</div>
                                                                    }
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="text-muted">Instructor: <strong>@(lecture.Instructor ?? "Educator")</strong> <em>(No registered user profile found matching '@(lecture.Instructor)')</em></div>
                                                            }
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer border-top-0 pt-0 d-flex justify-content-between">
                                                        <!-- Restrict Educator button within preview -->
                                                        <div>
                                                            @if (!string.IsNullOrWhiteSpace(lecture.Instructor))
                                                            {
                                                                <form asp-action="RestrictEducator" method="post" class="d-inline">
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden" name="educatorName" value="@lecture.Instructor" />
                                                                    <input type="hidden" name="returnTab" value="lectures" />
                                                                    <button type="submit" class="btn btn-danger btn-sm rounded-pill px-3 d-inline-flex align-items-center gap-1.5" onclick="return confirm('Are you sure you want to restrict educator @lecture.Instructor? They will be blocked from logging in.');">
                                                                        <i class="bi bi-slash-circle"></i>
                                                                        <span>Restrict Educator (@lecture.Instructor)</span>
                                                                    </button>
                                                                </form>
                                                            }
                                                        </div>
                                                        <div class="d-flex gap-2">
                                                            @if (lecture.Status != "Active" && lecture.Status != "Approved")
                                                            {
                                                                <form asp-action="ApproveLecture" asp-route-id="@lecture.Id" method="post" class="d-inline">
                                                                    @Html.AntiForgeryToken()
                                                                    <button type="submit" class="btn btn-success btn-sm rounded-pill px-3 d-inline-flex align-items-center gap-1.5">
                                                                        <i class="bi bi-check-lg"></i>
                                                                        <span>Approve Lecture</span>
                                                                    </button>
                                                                </form>
                                                            }
                                                            @if (lecture.Status != "Declined")
                                                            {
                                                                <form asp-action="DeclineLecture" asp-route-id="@lecture.Id" method="post" class="d-inline">
                                                                    @Html.AntiForgeryToken()
                                                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 d-inline-flex align-items-center gap-1.5">
                                                                        <i class="bi bi-x-lg"></i>
                                                                        <span>Decline</span>
                                                                    </button>
                                                                </form>
                                                            }
                                                            <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Close</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <!-- ================= TAB 3: MATERIALS MODERATION ================= -->
                <div class="tab-pane fade @(activeTab == "materials" ? "show active" : "")" id="materials-tab-pane" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <div>
                            <h5 class="fw-bold text-dark mb-0">Study Materials Moderation</h5>
                            <p class="text-muted small mb-0">Preview documents, verify authors, approve/decline PDF resources, and restrict educators if necessary.</p>
                        </div>
                    </div>

                    @if (!Model.Materials.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <p>No study materials in catalog yet.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle border rounded-3 overflow-hidden">
                                <thead class="table-light small text-muted text-uppercase">
                                    <tr>
                                        <th>Material</th>
                                        <th>Class & Subject</th>
                                        <th>Author / Educator</th>
                                        <th>Size</th>
                                        <th>Status</th>
                                        <th>Uploaded</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var material in Model.Materials)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-2.5">
                                                    <div class="rounded-3 bg-primary-subtle text-primary p-2">
                                                        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                                        </svg>
                                                    </div>
                                                    <div>
                                                        <button type="button" class="btn btn-link text-decoration-none p-0 fw-bold text-dark text-start text-truncate d-inline-block" style="max-width: 280px;" data-bs-toggle="modal" data-bs-target="#materialModal-@material.Id">
                                                            @material.Title
                                                        </button>
                                                        <div class="text-muted small text-truncate" style="max-width: 280px;">Topic: @material.Topic</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-primary-subtle text-primary border rounded-pill">Class @material.ClassLevel</span>
                                                <div class="small text-muted mt-0.5">@material.Subject</div>
                                            </td>
                                            <td>
                                                <span class="fw-semibold text-dark">@(material.Instructor ?? "Educator")</span>
                                            </td>
                                            <td class="small">@(material.Size ?? "N/A")</td>
                                            <td>
                                                @if (material.Status == "Active" || material.Status == "Approved")
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1">Active</span>
                                                }
                                                else if (material.Status == "Declined")
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1">Declined</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2.5 py-1">Pending</span>
                                                }
                                            </td>
                                            <td class="small text-muted">@material.Date.ToString("MMM dd, yyyy")</td>
                                            <td class="text-end">
                                                <div class="d-inline-flex gap-1.5">
                                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2.5" data-bs-toggle="modal" data-bs-target="#materialModal-@material.Id">
                                                        Preview & Verify
                                                    </button>

                                                    @if (material.Status != "Active" && material.Status != "Approved")
                                                    {
                                                        <form asp-action="ApproveMaterial" asp-route-id="@material.Id" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-sm btn-success rounded-pill px-2.5 d-inline-flex align-items-center gap-1">
                                                                <i class="bi bi-check-lg"></i>
                                                                <span>Approve</span>
                                                            </button>
                                                        </form>
                                                    }
                                                    @if (material.Status != "Declined")
                                                    {
                                                        <form asp-action="DeclineMaterial" asp-route-id="@material.Id" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2.5 d-inline-flex align-items-center gap-1">
                                                                <i class="bi bi-x-lg"></i>
                                                                <span>Decline</span>
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            </td>
                                        </tr>

                                        <!-- Material Preview Modal with Educator Restriction Button -->
                                        <div class="modal fade" id="materialModal-@material.Id" tabindex="-1" aria-labelledby="materialModalLabel-@material.Id" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered modal-lg">
                                                <div class="modal-content rounded-4 border-0 shadow">
                                                    <div class="modal-header border-bottom-0 pb-0">
                                                        <div>
                                                            <h5 class="modal-title fw-bold text-dark mb-0" id="materialModalLabel-@material.Id">@material.Title</h5>
                                                            <div class="text-muted small">Author: <strong>@(material.Instructor ?? "Educator")</strong> | Class: @material.ClassLevel | Subject: @material.Subject</div>
                                                        </div>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body py-3">
                                                        @if (!string.IsNullOrWhiteSpace(material.FileUrl))
                                                        {
                                                            <div class="ratio ratio-4x3 rounded-3 overflow-hidden bg-white mb-3 border">
                                                                <iframe src="@material.FileUrl" class="w-100 h-100" title="@material.Title"></iframe>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="p-4 bg-light rounded text-center text-muted mb-3">No document URL available.</div>
                                                        }

                                                        <div class="p-3 bg-light rounded-3 small mb-3 border">
                                                            <div class="mb-1"><strong>Topic:</strong> @material.Topic</div>
                                                            <div class="mb-1"><strong>File Size:</strong> @(material.Size ?? "N/A")</div>
                                                            <div class="mb-1"><strong>Description:</strong> @(string.IsNullOrWhiteSpace(material.Description) ? "No description provided." : material.Description)</div>
                                                            <div><strong>Status:</strong> <span class="badge @(material.Status == "Active" || material.Status == "Approved" ? "bg-success" : (material.Status == "Declined" ? "bg-danger" : "bg-warning text-dark")) rounded-pill">@material.Status</span></div>
                                                        </div>

                                                        @{
                                                            var materialAuthor = Model.Users.FirstOrDefault(u => !string.IsNullOrEmpty(material.Instructor) && 
                                                                (u.FullName.Equals(material.Instructor, StringComparison.OrdinalIgnoreCase) || 
                                                                 u.Email.Equals(material.Instructor, StringComparison.OrdinalIgnoreCase)));
                                                        }
                                                        <div class="p-3 rounded-3 border bg-white small">
                                                            <div class="fw-bold text-dark mb-2 d-flex align-items-center gap-2">
                                                                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                                                </svg>
                                                                Author / Educator Details
                                                            </div>
                                                            @if (materialAuthor != null)
                                                            {
                                                                <div class="row g-2">
                                                                    <div class="col-sm-6"><strong>Name:</strong> @materialAuthor.FullName</div>
                                                                    <div class="col-sm-6"><strong>Email:</strong> @materialAuthor.Email</div>
                                                                    <div class="col-sm-6"><strong>Phone:</strong> @materialAuthor.PhoneNumber</div>
                                                                    <div class="col-sm-6"><strong>Location:</strong> @materialAuthor.City, @materialAuthor.Area</div>
                                                                    <div class="col-sm-6"><strong>Role / Status:</strong> <span class="badge bg-secondary-subtle text-secondary rounded-pill">@materialAuthor.Role</span> <span class="badge @(materialAuthor.VerificationStatus == "Active" ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning") rounded-pill">@(materialAuthor.VerificationStatus ?? "Pending")</span></div>
                                                                    <div class="col-sm-6"><strong>Account:</strong> @(materialAuthor.IsRestricted ? "Restricted" : "Active")</div>
                                                                    @if (!string.IsNullOrEmpty(materialAuthor.EducationLevel))
                                                                    {
                                                                        <div class="col-12"><strong>Education:</strong> @materialAuthor.EducationLevel @(!string.IsNullOrEmpty(materialAuthor.Major) ? $"in {materialAuthor.Major}" : "") @(!string.IsNullOrEmpty(materialAuthor.UniversityName) ? $"({materialAuthor.UniversityName})" : "")</div>
                                                                    }
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="text-muted">Author: <strong>@(material.Instructor ?? "Educator")</strong> <em>(No registered user profile found matching '@(material.Instructor)')</em></div>
                                                            }
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer border-top-0 pt-0 d-flex justify-content-between">
                                                        <!-- Restrict Educator button within preview -->
                                                        <div>
                                                            @if (!string.IsNullOrWhiteSpace(material.Instructor))
                                                            {
                                                                <form asp-action="RestrictEducator" method="post" class="d-inline">
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden" name="educatorName" value="@material.Instructor" />
                                                                    <input type="hidden" name="returnTab" value="materials" />
                                                                    <button type="submit" class="btn btn-danger btn-sm rounded-pill px-3 d-inline-flex align-items-center gap-1.5" onclick="return confirm('Are you sure you want to restrict educator @material.Instructor? They will be blocked from logging in.');">
                                                                        <i class="bi bi-slash-circle"></i>
                                                                        <span>Restrict Educator (@material.Instructor)</span>
                                                                    </button>
                                                                </form>
                                                            }
                                                        </div>
                                                        <div class="d-flex gap-2">
                                                            @if (!string.IsNullOrWhiteSpace(material.FileUrl))
                                                            {
                                                                <a href="@material.FileUrl" target="_blank" class="btn btn-outline-secondary btn-sm rounded-pill px-3 d-inline-flex align-items-center gap-1.5">
                                                                    <i class="bi bi-box-arrow-up-right"></i>
                                                                    <span>Open in Tab</span>
                                                                </a>
                                                            }
                                                            @if (material.Status != "Active" && material.Status != "Approved")
                                                            {
                                                                <form asp-action="ApproveMaterial" asp-route-id="@material.Id" method="post" class="d-inline">
                                                                    @Html.AntiForgeryToken()
                                                                    <button type="submit" class="btn btn-success btn-sm rounded-pill px-3 d-inline-flex align-items-center gap-1.5">
                                                                        <i class="bi bi-check-lg"></i>
                                                                        <span>Approve Material</span>
                                                                    </button>
                                                                </form>
                                                            }
                                                            @if (material.Status != "Declined")
                                                            {
                                                                <form asp-action="DeclineMaterial" asp-route-id="@material.Id" method="post" class="d-inline">
                                                                    @Html.AntiForgeryToken()
                                                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 d-inline-flex align-items-center gap-1.5">
                                                                        <i class="bi bi-x-lg"></i>
                                                                        <span>Decline</span>
                                                                    </button>
                                                                </form>
                                                            }
                                                            <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Close</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <!-- ================= TAB 4: FORUM POSTS MODERATION ================= -->
                <div class="tab-pane fade @(activeTab == "forum" ? "show active" : "")" id="forum-tab-pane" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <div>
                            <h5 class="fw-bold text-dark mb-0">Forum Discussions Moderation</h5>
                            <p class="text-muted small mb-0">Review submitted community discussions, inspect poster details, approve/decline posts, and restrict users if necessary.</p>
                        </div>
                    </div>

                    @if (!Model.ForumPosts.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <p>No forum discussions in community yet.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle border rounded-3 overflow-hidden">
                                <thead class="table-light small text-muted text-uppercase">
                                    <tr>
                                        <th>Discussion</th>
                                        <th>Category & Tags</th>
                                        <th>Author / Poster</th>
                                        <th>Engagement</th>
                                        <th>Status</th>
                                        <th>Posted</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var post in Model.ForumPosts)
                                    {
                                        var authorUser = Model.Users.FirstOrDefault(u => !string.IsNullOrEmpty(post.Author) && 
                                            (u.FullName.Equals(post.Author, StringComparison.OrdinalIgnoreCase) || 
                                             u.Email.Equals(post.Author, StringComparison.OrdinalIgnoreCase)));

                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-2.5">
                                                    <div class="rounded-3 p-2" style="background-color: #f3e8ff; color: #7e22ce;">
                                                        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                                                        </svg>
                                                    </div>
                                                    <div>
                                                        <button type="button" class="btn btn-link text-decoration-none p-0 fw-bold text-dark text-start text-truncate d-inline-block" style="max-width: 260px;" data-bs-toggle="modal" data-bs-target="#forumModal-@post.Id">
                                                            @post.Title
                                                        </button>
                                                        <div class="text-muted small text-truncate" style="max-width: 260px;">@(post.Content ?? "No content preview")</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary-subtle text-secondary border rounded-pill">@(post.Category ?? "General")</span>
                                                @if (!string.IsNullOrEmpty(post.Tags))
                                                {
                                                    <div class="small text-muted mt-0.5 text-truncate" style="max-width: 140px;">@post.Tags</div>
                                                }
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    @if (authorUser != null && !string.IsNullOrWhiteSpace(authorUser.Picture))
                                                    {
                                                        <img src="@CloudinaryService.GetAvatarUrl(authorUser.Picture, 60)" 
                                                             alt="@post.Author" 
                                                             class="rounded-circle border" 
                                                             style="width: 32px; height: 32px; object-fit: cover;" />
                                                    }
                                                    else
                                                    {
                                                        <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center" 
                                                             style="width: 32px; height: 32px; font-size: 0.75rem;">
                                                            @(string.IsNullOrEmpty(post.Author) ? "U" : post.Author.Substring(0, 1).ToUpper())
                                                        </div>
                                                    }
                                                    <div>
                                                        <div class="fw-semibold text-dark small">@(post.Author ?? "Anonymous")</div>
                                                        <span class="badge bg-light text-muted border rounded-pill px-1.5" style="font-size: 0.7rem;">@(post.AuthorRole ?? "User")</span>
                                                        @if (authorUser != null && authorUser.IsRestricted)
                                                        {
                                                            <span class="badge bg-danger rounded-pill ms-1" style="font-size: 0.65rem;">Restricted</span>
                                                        }
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="small">
                                                <span class="text-success fw-medium"><i class="bi bi-hand-thumbs-up me-1"></i>@post.Likes</span>
                                                <span class="text-muted mx-1">/</span>
                                                <span class="text-danger fw-medium"><i class="bi bi-hand-thumbs-down me-1"></i>@post.Dislikes</span>
                                                <div class="text-muted mt-0.5"><i class="bi bi-chat-dots me-1"></i>@post.Replies replies</div>
                                            </td>
                                            <td>
                                                @if (post.Status == "Active" || post.Status == "Approved" || post.Status == "approved")
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1">Active</span>
                                                }
                                                else if (post.Status == "Declined" || post.Status == "declined")
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1">Declined</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2.5 py-1">Pending</span>
                                                }
                                            </td>
                                            <td class="small text-muted">@post.CreatedAt.ToString("MMM dd, yyyy")</td>
                                            <td class="text-end">
                                                <div class="d-inline-flex gap-1.5">
                                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2.5" data-bs-toggle="modal" data-bs-target="#forumModal-@post.Id">
                                                        Preview & Verify
                                                    </button>

                                                    @if (post.Status != "Active" && post.Status != "Approved")
                                                    {
                                                        <form asp-action="ApproveForumPost" asp-route-id="@post.Id" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-sm btn-success rounded-pill px-2.5 d-inline-flex align-items-center gap-1" title="Approve Post">
                                                                <i class="bi bi-check-lg"></i>
                                                                <span>Approve</span>
                                                            </button>
                                                        </form>
                                                    }
                                                    @if (post.Status != "Declined")
                                                    {
                                                        <form asp-action="DeclineForumPost" asp-route-id="@post.Id" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2.5 d-inline-flex align-items-center gap-1" title="Decline Post">
                                                                <i class="bi bi-x-lg"></i>
                                                                <span>Decline</span>
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            </td>
                                        </tr>

                                        <!-- Forum Post Preview Modal with Uploader's Details and Restriction -->
                                        <div class="modal fade" id="forumModal-@post.Id" tabindex="-1" aria-labelledby="forumModalLabel-@post.Id" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered modal-lg">
                                                <div class="modal-content rounded-4 border-0 shadow">
                                                    <div class="modal-header border-bottom-0 pb-0">
                                                        <div>
                                                            <h5 class="modal-title fw-bold text-dark mb-0" id="forumModalLabel-@post.Id">@post.Title</h5>
                                                            <div class="text-muted small">
                                                                Category: <strong>@(post.Category ?? "General")</strong> | 
                                                                Posted: @post.CreatedAt.ToString("f") |
                                                                Status: <span class="badge @(post.Status == "Active" || post.Status == "Approved" ? "bg-success" : (post.Status == "Declined" ? "bg-danger" : "bg-warning text-dark")) rounded-pill">@(post.Status ?? "Pending")</span>
                                                            </div>
                                                        </div>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body py-3">
                                                        <!-- Discussion Content Section -->
                                                        <div class="p-3 bg-light rounded-3 mb-3 border">
                                                            <h6 class="fw-bold text-dark mb-2">Discussion Content</h6>
                                                            <p class="text-dark mb-2" style="white-space: pre-line; line-height: 1.6;">@post.Content</p>
                                                            @if (!string.IsNullOrEmpty(post.Tags))
                                                            {
                                                                <div class="d-flex flex-wrap gap-1 mt-2">
                                                                    @foreach (var tag in post.Tags.Split(' ', StringSplitOptions.RemoveEmptyEntries))
                                                                    {
                                                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-2">@tag</span>
                                                                    }
                                                                </div>
                                                            }
                                                            <div class="d-flex gap-3 text-muted small mt-2 pt-2 border-top">
                                                                <span><i class="bi bi-hand-thumbs-up me-1"></i> Likes: <strong>@post.Likes</strong></span>
                                                                <span><i class="bi bi-hand-thumbs-down me-1"></i> Dislikes: <strong>@post.Dislikes</strong></span>
                                                                <span><i class="bi bi-chat-dots me-1"></i> Replies: <strong>@post.Replies</strong></span>
                                                            </div>
                                                        </div>

                                                        <!-- Uploader Details Section -->
                                                        <div class="p-3 rounded-3 border bg-white shadow-sm">
                                                            <h6 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                                                                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                                                </svg>
                                                                Author / Uploader Details
                                                            </h6>
                                                            
                                                            @if (authorUser != null)
                                                            {
                                                                <div class="d-flex align-items-start gap-3 mb-3">
                                                                    @if (!string.IsNullOrWhiteSpace(authorUser.Picture))
                                                                    {
                                                                        <img src="@CloudinaryService.GetAvatarUrl(authorUser.Picture, 80)" alt="@authorUser.FullName" class="rounded-circle border" style="width: 48px; height: 48px; object-fit: cover;" />
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; font-size: 1.1rem;">
                                                                            @(string.IsNullOrEmpty(authorUser.FullName) ? "U" : authorUser.FullName.Substring(0, 1).ToUpper())
                                                                        </div>
                                                                    }
                                                                    <div class="flex-grow-1">
                                                                        <div class="fw-bold text-dark">@authorUser.FullName</div>
                                                                        <div class="text-muted small">@authorUser.Email | @authorUser.PhoneNumber</div>
                                                                        <div class="mt-1 d-flex flex-wrap gap-1">
                                                                            <span class="badge bg-secondary-subtle text-secondary rounded-pill">@authorUser.Role</span>
                                                                            <span class="badge @(authorUser.VerificationStatus == "Active" ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning") rounded-pill">Verification: @(authorUser.VerificationStatus ?? "Pending")</span>
                                                                            @if (authorUser.IsRestricted)
                                                                            {
                                                                                <span class="badge bg-danger rounded-pill">RESTRICTED</span>
                                                                            }
                                                                            else
                                                                            {
                                                                                <span class="badge bg-success-subtle text-success rounded-pill">Active Account</span>
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                </div>

                                                                <div class="row g-2 small border-top pt-2">
                                                                    <div class="col-sm-6">
                                                                        <span class="text-muted">Location:</span> 
                                                                        <span class="fw-semibold text-dark">@authorUser.City, @authorUser.Area</span>
                                                                    </div>
                                                                    <div class="col-sm-6">
                                                                        <span class="text-muted">Education:</span> 
                                                                        <span class="fw-semibold text-dark">@(authorUser.EducationLevel ?? "—") @(!string.IsNullOrEmpty(authorUser.Major) ? $"in {authorUser.Major}" : "")</span>
                                                                    </div>
                                                                    @if (!string.IsNullOrEmpty(authorUser.UniversityName))
                                                                    {
                                                                        <div class="col-12">
                                                                            <span class="text-muted">Institution:</span> 
                                                                            <span class="fw-semibold text-dark">@authorUser.UniversityName</span>
                                                                        </div>
                                                                    }
                                                                    @if (!string.IsNullOrWhiteSpace(authorUser.Bio))
                                                                    {
                                                                        <div class="col-12 mt-1">
                                                                            <span class="text-muted">Bio:</span> 
                                                                            <span class="text-dark">@authorUser.Bio</span>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="row g-2 small">
                                                                    <div class="col-sm-6">
                                                                        <span class="text-muted">Author Name:</span> 
                                                                        <span class="fw-semibold text-dark">@(post.Author ?? "Anonymous")</span>
                                                                    </div>
                                                                    <div class="col-sm-6">
                                                                        <span class="text-muted">Author Role:</span> 
                                                                        <span class="fw-semibold text-dark">@(post.AuthorRole ?? "User")</span>
                                                                    </div>
                                                                    <div class="col-12 text-muted">
                                                                        <em>(No registered user profile found matching '@(post.Author)' in the database)</em>
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer border-top-0 pt-0 d-flex justify-content-between">
                                                        <!-- Restrict User Button -->
                                                        <div>
                                                            @if (!string.IsNullOrWhiteSpace(post.Author))
                                                            {
                                                                <form asp-action="RestrictEducator" method="post" class="d-inline">
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden" name="educatorName" value="@post.Author" />
                                                                    <input type="hidden" name="returnTab" value="forum" />
                                                                    <button type="submit" class="btn btn-danger btn-sm rounded-pill px-3 d-inline-flex align-items-center gap-1.5" onclick="return confirm('Are you sure you want to restrict user @post.Author? They will be blocked from logging in.');">
                                                                        <i class="bi bi-slash-circle"></i>
                                                                        <span>Restrict User (@post.Author)</span>
                                                                    </button>
                                                                </form>
                                                            }
                                                        </div>
                                                        <div class="d-flex gap-2">
                                                            @if (post.Status != "Active" && post.Status != "Approved")
                                                            {
                                                                <form asp-action="ApproveForumPost" asp-route-id="@post.Id" method="post" class="d-inline">
                                                                    @Html.AntiForgeryToken()
                                                                    <button type="submit" class="btn btn-success btn-sm rounded-pill px-3 d-inline-flex align-items-center gap-1.5">
                                                                        <i class="bi bi-check-lg"></i>
                                                                        <span>Approve Post</span>
                                                                    </button>
                                                                </form>
                                                            }
                                                            @if (post.Status != "Declined")
                                                            {
                                                                <form asp-action="DeclineForumPost" asp-route-id="@post.Id" method="post" class="d-inline">
                                                                    @Html.AntiForgeryToken()
                                                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 d-inline-flex align-items-center gap-1.5">
                                                                        <i class="bi bi-x-lg"></i>
                                                                        <span>Decline Post</span>
                                                                    </button>
                                                                </form>
                                                            }
                                                            <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Close</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <!-- ================= TAB 5: STUDENT ENROLLMENTS MODERATION ================= -->
                <div class="tab-pane fade @(activeTab == "students" ? "show active" : "")" id="students-tab-pane" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <div>
                            <h5 class="fw-bold text-dark mb-0">Student Enrollment Approvals</h5>
                            <p class="text-muted small mb-0">Verify student enrollments submitted by Local Guardians, inspect parent consent letters, approve/decline applications, and restrict accounts if needed.</p>
                        </div>
                    </div>

                    @if (!Model.Students.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <p>No student enrollment applications in the database yet.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle border rounded-3 overflow-hidden">
                                <thead class="table-light small text-muted text-uppercase">
                                    <tr>
                                        <th>Student & ID</th>
                                        <th>Class & Subjects</th>
                                        <th>Parents & Address</th>
                                        <th>Local Guardian</th>
                                        <th>Consent Letter</th>
                                        <th>Status</th>
                                        <th>Enrolled</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var student in Model.Students)
                                    {
                                        var guardianUser = Model.Users.FirstOrDefault(u => 
                                            (!string.IsNullOrEmpty(student.GuardianId) && (u.Id.ToString() == student.GuardianId || u.Email.Equals(student.GuardianId, StringComparison.OrdinalIgnoreCase))) ||
                                            (!string.IsNullOrEmpty(student.GuardianName) && (u.FullName.Equals(student.GuardianName, StringComparison.OrdinalIgnoreCase) || u.Email.Equals(student.GuardianName, StringComparison.OrdinalIgnoreCase))));

                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-2.5">
                                                    <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center" 
                                                         style="width: 36px; height: 36px; font-size: 0.9rem;">
                                                        @(string.IsNullOrEmpty(student.FullName) ? "S" : student.FullName.Substring(0, 1).ToUpper())
                                                    </div>
                                                    <div>
                                                        <button type="button" class="btn btn-link text-decoration-none p-0 fw-bold text-dark text-start text-truncate d-inline-block" style="max-width: 200px;" data-bs-toggle="modal" data-bs-target="#studentModal-@student.Id">
                                                            @student.FullName
                                                        </button>
                                                        <div class="text-muted small">
                                                            ID: @(string.IsNullOrWhiteSpace(student.BirthCertificateId) ? "N/A" : student.BirthCertificateId)
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-primary-subtle text-primary border rounded-pill">Class @student.ClassLevel</span>
                                                @if (!string.IsNullOrEmpty(student.Subjects))
                                                {
                                                    <div class="small text-muted mt-0.5 text-truncate" style="max-width: 150px;" title="@student.Subjects">@student.Subjects</div>
                                                }
                                            </td>
                                            <td class="small">
                                                <div><strong>F:</strong> @(student.FatherName ?? "—") | <strong>M:</strong> @(student.MotherName ?? "—")</div>
                                                <div class="text-muted text-truncate" style="max-width: 180px;" title="@student.Address">@(student.Address ?? "No address")</div>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    @if (guardianUser != null && !string.IsNullOrWhiteSpace(guardianUser.Picture))
                                                    {
                                                        <img src="@CloudinaryService.GetAvatarUrl(guardianUser.Picture, 60)" 
                                                             alt="@student.GuardianName" 
                                                             class="rounded-circle border" 
                                                             style="width: 32px; height: 32px; object-fit: cover;" />
                                                    }
                                                    else
                                                    {
                                                        <div class="rounded-circle bg-success-subtle text-success fw-bold d-flex align-items-center justify-content-center" 
                                                             style="width: 32px; height: 32px; font-size: 0.75rem;">
                                                            @(string.IsNullOrEmpty(student.GuardianName) ? "G" : student.GuardianName.Substring(0, 1).ToUpper())
                                                        </div>
                                                    }
                                                    <div>
                                                        <div class="fw-semibold text-dark small">@(student.GuardianName ?? "Local Guardian")</div>
                                                        @if (guardianUser != null)
                                                        {
                                                            <span class="badge bg-light text-muted border rounded-pill px-1.5" style="font-size: 0.7rem;">@guardianUser.Role</span>
                                                            @if (guardianUser.IsRestricted)
                                                            {
                                                                <span class="badge bg-danger rounded-pill ms-1" style="font-size: 0.65rem;">Restricted</span>
                                                            }
                                                        }
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(student.ConsentLetterUrl))
                                                {
                                                    <a href="@student.ConsentLetterUrl" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 d-inline-flex align-items-center gap-1" title="View Consent Letter">
                                                        <i class="bi bi-file-earmark-text"></i>
                                                        <span>View Letter</span>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-muted border rounded-pill">No file</span>
                                                }
                                            </td>
                                            <td>
                                                @if (student.Status == "Active" || student.Status == "Approved" || student.Status == "approved")
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1">Active</span>
                                                }
                                                else if (student.Status == "Declined" || student.Status == "declined")
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1">Declined</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2.5 py-1">Pending</span>
                                                }
                                            </td>
                                            <td class="small text-muted">@student.CreatedAt.ToString("MMM dd, yyyy")</td>
                                            <td class="text-end">
                                                <div class="d-inline-flex gap-1.5">
                                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2.5" data-bs-toggle="modal" data-bs-target="#studentModal-@student.Id">
                                                        Preview & Verify
                                                    </button>

                                                    @if (student.Status != "Active" && student.Status != "Approved")
                                                    {
                                                        <form asp-action="ApproveStudent" asp-route-id="@student.Id" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-sm btn-success rounded-pill px-2.5 d-inline-flex align-items-center gap-1" title="Approve Student">
                                                                <i class="bi bi-check-lg"></i>
                                                                <span>Approve</span>
                                                            </button>
                                                        </form>
                                                    }
                                                    @if (student.Status != "Declined")
                                                    {
                                                        <form asp-action="DeclineStudent" asp-route-id="@student.Id" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2.5 d-inline-flex align-items-center gap-1" title="Decline Student">
                                                                <i class="bi bi-x-lg"></i>
                                                                <span>Decline</span>
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            </td>
                                        </tr>

                                        <!-- Student Verification & Preview Modal -->
                                        <div class="modal fade" id="studentModal-@student.Id" tabindex="-1" aria-labelledby="studentModalLabel-@student.Id" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered modal-lg">
                                                <div class="modal-content rounded-4 border-0 shadow">
                                                    <div class="modal-header border-bottom-0 pb-0">
                                                        <div>
                                                            <h5 class="modal-title fw-bold text-dark mb-0" id="studentModalLabel-@student.Id">@student.FullName</h5>
                                                            <div class="text-muted small">
                                                                Class Level: <strong>Class @student.ClassLevel</strong> | 
                                                                Enrolled: @student.CreatedAt.ToString("f") |
                                                                Status: <span class="badge @(student.Status == "Active" || student.Status == "Approved" ? "bg-success" : (student.Status == "Declined" ? "bg-danger" : "bg-warning text-dark")) rounded-pill">@(student.Status ?? "Pending")</span>
                                                            </div>
                                                        </div>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body py-3">
                                                        <!-- Student Profile Card -->
                                                        <div class="p-3 bg-light rounded-3 mb-3 border">
                                                            <h6 class="fw-bold text-dark mb-3">Student Information</h6>
                                                            <div class="row g-2 small">
                                                                <div class="col-sm-6"><strong>Full Name:</strong> @student.FullName</div>
                                                                <div class="col-sm-6"><strong>Birth Certificate ID:</strong> @(student.BirthCertificateId ?? "N/A")</div>
                                                                <div class="col-sm-6"><strong>Class Level:</strong> Class @student.ClassLevel</div>
                                                                <div class="col-sm-6"><strong>Enrollment Year:</strong> @(student.EnrollmentYear ?? "2026")</div>
                                                                <div class="col-sm-6"><strong>Father's Name:</strong> @(student.FatherName ?? "N/A")</div>
                                                                <div class="col-sm-6"><strong>Mother's Name:</strong> @(student.MotherName ?? "N/A")</div>
                                                                <div class="col-12"><strong>Residential Address:</strong> @(student.Address ?? "N/A")</div>
                                                                <div class="col-12"><strong>Enrolled Subjects:</strong> @(student.Subjects ?? "General Curriculum")</div>
                                                            </div>
                                                        </div>

                                                        <!-- Consent Letter Section -->
                                                        <div class="p-3 rounded-3 border bg-white mb-3 shadow-sm">
                                                            <h6 class="fw-bold text-dark mb-2 d-flex align-items-center gap-2">
                                                                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                                                </svg>
                                                                Legal Guardian Consent Letter
                                                            </h6>
                                                            @if (!string.IsNullOrWhiteSpace(student.ConsentLetterUrl))
                                                            {
                                                                <div class="d-flex justify-content-between align-items-center p-2.5 bg-light rounded-3 border">
                                                                    <div class="text-truncate me-2 small d-flex align-items-center gap-1" style="max-width: 440px;">
                                                                        <i class="bi bi-file-earmark-text text-muted"></i>
                                                                        <span>@student.ConsentLetterUrl</span>
                                                                    </div>
                                                                    <a href="@student.ConsentLetterUrl" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill px-3 d-inline-flex align-items-center gap-1">
                                                                        <span>Open Document</span>
                                                                        <i class="bi bi-box-arrow-up-right"></i>
                                                                    </a>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="text-muted small">No consent letter file uploaded.</div>
                                                            }
                                                        </div>

                                                        <!-- Local Guardian Profile Section -->
                                                        <div class="p-3 rounded-3 border bg-white shadow-sm">
                                                            <h6 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                                                                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                                                </svg>
                                                                Enrolling Local Guardian Details
                                                            </h6>
                                                            
                                                            @if (guardianUser != null)
                                                            {
                                                                <div class="d-flex align-items-start gap-3 mb-3">
                                                                    @if (!string.IsNullOrWhiteSpace(guardianUser.Picture))
                                                                    {
                                                                        <img src="@CloudinaryService.GetAvatarUrl(guardianUser.Picture, 80)" alt="@guardianUser.FullName" class="rounded-circle border" style="width: 48px; height: 48px; object-fit: cover;" />
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="rounded-circle bg-success-subtle text-success fw-bold d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; font-size: 1.1rem;">
                                                                            @(string.IsNullOrEmpty(guardianUser.FullName) ? "G" : guardianUser.FullName.Substring(0, 1).ToUpper())
                                                                        </div>
                                                                    }
                                                                    <div class="flex-grow-1">
                                                                        <div class="fw-bold text-dark">@guardianUser.FullName</div>
                                                                        <div class="text-muted small">@guardianUser.Email | @guardianUser.PhoneNumber</div>
                                                                        <div class="mt-1 d-flex flex-wrap gap-1">
                                                                            <span class="badge bg-secondary-subtle text-secondary rounded-pill">@guardianUser.Role</span>
                                                                            <span class="badge @(guardianUser.VerificationStatus == "Active" ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning") rounded-pill">Verification: @(guardianUser.VerificationStatus ?? "Pending")</span>
                                                                            @if (guardianUser.IsRestricted)
                                                                            {
                                                                                <span class="badge bg-danger rounded-pill">RESTRICTED</span>
                                                                            }
                                                                            else
                                                                            {
                                                                                <span class="badge bg-success-subtle text-success rounded-pill">Active Account</span>
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                </div>

                                                                <div class="row g-2 small border-top pt-2">
                                                                    <div class="col-sm-6">
                                                                        <span class="text-muted">Location:</span> 
                                                                        <span class="fw-semibold text-dark">@guardianUser.City, @guardianUser.Area</span>
                                                                    </div>
                                                                    <div class="col-sm-6">
                                                                        <span class="text-muted">Education:</span> 
                                                                        <span class="fw-semibold text-dark">@(guardianUser.EducationLevel ?? "—") @(!string.IsNullOrEmpty(guardianUser.Major) ? $"in {guardianUser.Major}" : "")</span>
                                                                    </div>
                                                                    @if (!string.IsNullOrWhiteSpace(guardianUser.Bio))
                                                                    {
                                                                        <div class="col-12 mt-1">
                                                                            <span class="text-muted">Bio:</span> 
                                                                            <span class="text-dark">@guardianUser.Bio</span>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="row g-2 small">
                                                                    <div class="col-sm-6">
                                                                        <span class="text-muted">Guardian Name:</span> 
                                                                        <span class="fw-semibold text-dark">@(student.GuardianName ?? "Local Guardian")</span>
                                                                    </div>
                                                                    <div class="col-sm-6">
                                                                        <span class="text-muted">Guardian ID:</span> 
                                                                        <span class="fw-semibold text-dark">@(student.GuardianId ?? "N/A")</span>
                                                                    </div>
                                                                    <div class="col-12 text-muted">
                                                                        <em>(No registered user profile found matching '@(student.GuardianName ?? student.GuardianId)' in database)</em>
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer border-top-0 pt-0 d-flex justify-content-between">
                                                        <!-- Restrict Guardian Button -->
                                                        <div>
                                                            @if (!string.IsNullOrWhiteSpace(student.GuardianName))
                                                            {
                                                                <form asp-action="RestrictEducator" method="post" class="d-inline">
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden" name="educatorName" value="@student.GuardianName" />
                                                                    <input type="hidden" name="returnTab" value="students" />
                                                                    <button type="submit" class="btn btn-danger btn-sm rounded-pill px-3 d-inline-flex align-items-center gap-1.5" onclick="return confirm('Are you sure you want to restrict guardian @student.GuardianName? They will be blocked from logging in.');">
                                                                        <i class="bi bi-slash-circle"></i>
                                                                        <span>Restrict Guardian (@student.GuardianName)</span>
                                                                    </button>
                                                                </form>
                                                            }
                                                        </div>
                                                        <div class="d-flex gap-2">
                                                            @if (student.Status != "Active" && student.Status != "Approved")
                                                            {
                                                                <form asp-action="ApproveStudent" asp-route-id="@student.Id" method="post" class="d-inline">
                                                                    @Html.AntiForgeryToken()
                                                                    <button type="submit" class="btn btn-success btn-sm rounded-pill px-3 d-inline-flex align-items-center gap-1.5">
                                                                        <i class="bi bi-check-lg"></i>
                                                                        <span>Approve Student</span>
                                                                    </button>
                                                                </form>
                                                            }
                                                            @if (student.Status != "Declined")
                                                            {
                                                                <form asp-action="DeclineStudent" asp-route-id="@student.Id" method="post" class="d-inline">
                                                                    @Html.AntiForgeryToken()
                                                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 d-inline-flex align-items-center gap-1.5">
                                                                        <i class="bi bi-x-lg"></i>
                                                                        <span>Decline Student</span>
                                                                    </button>
                                                                </form>
                                                            }
                                                            <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Close</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <!-- ================= TAB 6: DONATIONS & BKASH TRANSACTIONS ================= -->
                <div class="tab-pane fade @(activeTab == "donations" ? "show active" : "")" id="donations-tab-pane" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <div>
                            <h5 class="fw-bold text-dark mb-0">Donations & bKash Transaction History</h5>
                            <p class="text-muted small mb-0">Track all incoming charitable donations, inspect bKash TRX IDs, and view transaction vouchers.</p>
                        </div>
                        <div class="d-flex gap-2">
                            <span class="badge px-3 py-2 rounded-pill text-white fw-bold d-flex align-items-center gap-1.5" style="background-color: #e2136e;">
                                <span>৳ Total Raised:</span>
                                <span>৳@Model.TotalDonationsAmount.ToString("N2") BDT</span>
                            </span>
                        </div>
                    </div>

                    @if (!Model.Donations.Any())
                    {
                        <div class="p-5 text-center bg-light rounded-4">
                            <div class="text-muted fs-1 mb-2"><i class="bi bi-wallet2 text-secondary"></i></div>
                            <h5 class="fw-bold text-dark">No Donations Recorded Yet</h5>
                            <p class="text-muted small mb-0">Donation transactions received via bKash payment gateway will be logged here in real-time.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle border rounded-3 overflow-hidden">
                                <thead class="table-light small text-muted text-uppercase">
                                    <tr>
                                        <th>Date & Time</th>
                                        <th>bKash TRX ID</th>
                                        <th>Donor Details</th>
                                        <th>Amount</th>
                                        <th>Program / Cause</th>
                                        <th>Status</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var donation in Model.Donations)
                                    {
                                        <tr>
                                            <td class="small text-nowrap">
                                                <div class="fw-semibold text-dark">@donation.CreatedAt.ToString("MMM dd, yyyy")</div>
                                                <div class="text-muted" style="font-size: 0.75rem;">@donation.CreatedAt.ToString("hh:mm tt") UTC</div>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center gap-1.5">
                                                    <span class="badge rounded-pill px-2 py-1 text-white small" style="background-color: #e2136e; font-size: 0.72rem;">bKash</span>
                                                    <span class="fw-bold font-monospace text-dark small">@(donation.BkashTransactionId ?? "N/A")</span>
                                                </div>
                                                @if (!string.IsNullOrEmpty(donation.BkashWalletNumber))
                                                {
                                                    <div class="text-muted small font-monospace" style="font-size: 0.75rem;">Acc: @donation.BkashWalletNumber</div>
                                                }
                                            </td>
                                            <td>
                                                <div class="fw-bold text-dark">
                                                    @donation.DonorName
                                                    @if (donation.IsAnonymous)
                                                    {
                                                        <span class="badge bg-secondary-subtle text-secondary rounded-pill small ms-1" style="font-size: 0.68rem;">Anonymous Donor</span>
                                                    }
                                                </div>
                                                <div class="text-muted small d-flex align-items-center flex-wrap gap-2">
                                                    <span><i class="bi bi-phone me-1"></i>@donation.DonorPhone</span>
                                                    @if (!string.IsNullOrWhiteSpace(donation.DonorEmail))
                                                    {
                                                        <span><i class="bi bi-envelope me-1"></i>@donation.DonorEmail</span>
                                                    }
                                                </div>
                                            </td>
                                            <td class="text-nowrap">
                                                <span class="fw-bold text-success fs-6">৳@donation.Amount.ToString("N2")</span>
                                                <span class="text-muted small">@donation.Currency</span>
                                            </td>
                                            <td class="small">
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">
                                                    @donation.Purpose
                                                </span>
                                                @if (!string.IsNullOrWhiteSpace(donation.Message))
                                                {
                                                    <div class="text-muted text-truncate mt-1 fst-italic" style="max-width: 220px;" title="@donation.Message">
                                                        “@donation.Message”
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 d-inline-flex align-items-center gap-1">
                                                    <i class="bi bi-check-lg"></i>
                                                    <span>@donation.Status</span>
                                                </span>
                                            </td>
                                            <td class="text-end text-nowrap">
                                                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 d-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#donationDetailModal-@donation.Id">
                                                    <span>Details</span>
                                                    <i class="bi bi-box-arrow-up-right"></i>
                                                </button>
                                                <a asp-controller="Donation" asp-action="Receipt" asp-route-id="@donation.Id" target="_blank" class="btn btn-outline-secondary btn-sm rounded-pill px-2.5 d-inline-flex align-items-center gap-1" title="View Electronic Receipt">
                                                    <i class="bi bi-file-earmark-text"></i>
                                                    <span>Receipt</span>
                                                </a>
                                            </td>
                                        </tr>

                                        <!-- Modal for Donation Details -->
                                        <div class="modal fade" id="donationDetailModal-@donation.Id" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered modal-lg">
                                                <div class="modal-content rounded-4 border-0 shadow">
                                                    <div class="modal-header border-bottom-0 pb-0">
                                                        <div class="d-flex align-items-center gap-2">
                                                            <div class="bg-light p-2 rounded-3">
                                                                <span class="fw-bold" style="color: #e2136e;">bKash</span>
                                                            </div>
                                                            <div>
                                                                <h5 class="modal-title fw-bold text-dark mb-0">Donation Transaction Details</h5>
                                                                <div class="text-muted small">TRXID: <strong class="font-monospace text-dark">@(donation.BkashTransactionId ?? "N/A")</strong></div>
                                                            </div>
                                                        </div>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body py-3">
                                                        <div class="p-3 mb-3 rounded-3 text-center bg-light border">
                                                            <div class="text-muted small text-uppercase">Total Donation Amount</div>
                                                            <div class="display-6 fw-bold text-primary mb-0 font-monospace">৳@donation.Amount.ToString("N2") @donation.Currency</div>
                                                            <span class="badge bg-success rounded-pill px-3 py-1 mt-1">Payment Status: @donation.Status</span>
                                                        </div>

                                                        <div class="row g-3 small">
                                                            <div class="col-sm-6">
                                                                <div class="p-3 bg-light rounded-3">
                                                                    <div class="text-muted mb-1">Donor Name</div>
                                                                    <div class="fw-bold text-dark">
                                                                        @donation.DonorName
                                                                        @if (donation.IsAnonymous)
                                                                        {
                                                                            <span class="badge bg-secondary-subtle text-secondary ms-1">Anonymous</span>
                                                                        }
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="col-sm-6">
                                                                <div class="p-3 bg-light rounded-3">
                                                                    <div class="text-muted mb-1">Donor Mobile & Email</div>
                                                                    <div class="fw-bold text-dark font-monospace">@donation.DonorPhone</div>
                                                                    <div class="text-muted">@(donation.DonorEmail ?? "No email provided")</div>
                                                                </div>
                                                            </div>
                                                            <div class="col-sm-6">
                                                                <div class="p-3 bg-light rounded-3">
                                                                    <div class="text-muted mb-1">bKash Wallet Number</div>
                                                                    <div class="fw-bold text-dark font-monospace">@(donation.BkashWalletNumber ?? "N/A")</div>
                                                                </div>
                                                            </div>
                                                            <div class="col-sm-6">
                                                                <div class="p-3 bg-light rounded-3">
                                                                    <div class="text-muted mb-1">bKash Payment Ref ID</div>
                                                                    <div class="fw-bold text-dark font-monospace">@(donation.BkashPaymentId ?? "N/A")</div>
                                                                </div>
                                                            </div>
                                                            <div class="col-12">
                                                                <div class="p-3 bg-light rounded-3">
                                                                    <div class="text-muted mb-1">Supported Cause / Program</div>
                                                                    <div class="fw-bold text-dark">@donation.Purpose</div>
                                                                </div>
                                                            </div>
                                                            @if (!string.IsNullOrWhiteSpace(donation.Message))
                                                            {
                                                                <div class="col-12">
                                                                    <div class="p-3 bg-white border rounded-3">
                                                                        <div class="text-muted mb-1">Donor Message / Note:</div>
                                                                        <div class="fst-italic text-dark">“@donation.Message”</div>
                                                                    </div>
                                                                </div>
                                                            }
                                                            <div class="col-12">
                                                                <div class="text-muted" style="font-size: 0.78rem;">
                                                                    Recorded on: @donation.CreatedAt.ToString("MMMM dd, yyyy 'at' hh:mm:ss tt") UTC
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer border-top-0 pt-0">
                                                        <a asp-controller="Donation" asp-action="Receipt" asp-route-id="@donation.Id" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill px-3 d-inline-flex align-items-center gap-1">
                                                            <span>View Full Receipt</span>
                                                            <i class="bi bi-file-earmark-text"></i>
                                                        </a>
                                                        <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Close</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <!-- ================= TAB 7: MONTHLY VOLUNTEER RANKINGS ================= -->
                <div class="tab-pane fade @(activeTab == "rankings" ? "show active" : "")" id="rankings-tab-pane" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                        <div>
                            <h5 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                                <i class="bi bi-trophy text-warning"></i> Monthly Volunteer Performance Ranking & Reward System
                            </h5>
                            <p class="text-muted small mb-0">Automatic monthly performance leaderboards and fixed reward distribution for Educators (Edu Attir) and Local Guardians.</p>
                        </div>
                        <form method="get" asp-action="Dashboard" class="d-flex align-items-center gap-2 flex-wrap">
                            <input type="hidden" name="tab" value="rankings" />
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light text-muted border-end-0">Month</span>
                                <select name="month" class="form-select form-select-sm border-start-0" style="max-width: 140px;">
                                    @for (int m = 1; m <= 12; m++)
                                    {
                                        var monthName = new DateTime(2000, m, 1).ToString("MMMM");
                                        <option value="@m" selected="@(Model.Ranking.SelectedMonth == m)">@monthName</option>
                                    }
                                </select>
                            </div>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light text-muted border-end-0">Year</span>
                                <select name="year" class="form-select form-select-sm border-start-0" style="max-width: 100px;">
                                    @for (int y = DateTime.UtcNow.Year - 2; y <= DateTime.UtcNow.Year + 1; y++)
                                    {
                                        <option value="@y" selected="@(Model.Ranking.SelectedYear == y)">@y</option>
                                    }
                                </select>
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3 d-flex align-items-center gap-1.5">
                                <i class="bi bi-funnel"></i>
                                <span>Filter Period</span>
                            </button>
                        </form>
                    </div>

                    <!-- REWARD SYSTEM OVERVIEW BANNER -->
                    <div class="card border-0 shadow-sm rounded-4 mb-4 text-white overflow-hidden" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
                        <div class="card-body p-4">
                            <div class="row align-items-center g-4">
                                <div class="col-lg-5">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <span class="badge bg-warning text-dark fw-bold px-2.5 py-1 rounded-pill">
                                            <i class="bi bi-gift-fill me-1"></i> Reward Distribution
                                        </span>
                                        <span class="text-white-50 small">Fixed Monthly Rewards</span>
                                    </div>
                                    <h5 class="fw-bold text-white mb-2">Volunteer Rewards Policy</h5>
                                    <p class="text-light opacity-75 small mb-0">
                                        Top 3 performers in <strong>both categories</strong> (Educational Attractors / Educators and Local Guardians) receive guaranteed monthly rewards:
                                    </p>
                                </div>
                                <div class="col-lg-7">
                                    <div class="row g-2 text-center">
                                        <div class="col-4">
                                            <div class="p-3 rounded-3 border border-warning border-opacity-50" style="background: rgba(234, 179, 8, 0.12);">
                                                <div class="fs-4 mb-1">🥇</div>
                                                <div class="text-warning fw-bold small text-uppercase letter-spacing">1st Place</div>
                                                <div class="fs-5 fw-bolder text-white">10k</div>
                                                <div class="text-white-50 small" style="font-size: 0.75rem;">(৳10,000)</div>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="p-3 rounded-3 border border-secondary border-opacity-50" style="background: rgba(148, 163, 184, 0.12);">
                                                <div class="fs-4 mb-1">🥈</div>
                                                <div class="text-secondary-emphasis fw-bold small text-uppercase letter-spacing" style="color: #cbd5e1 !important;">2nd Place</div>
                                                <div class="fs-5 fw-bolder text-white">7k</div>
                                                <div class="text-white-50 small" style="font-size: 0.75rem;">(৳7,000)</div>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="p-3 rounded-3 border border-opacity-50" style="background: rgba(205, 127, 50, 0.15); border-color: rgba(205, 127, 50, 0.5) !important;">
                                                <div class="fs-4 mb-1">🥉</div>
                                                <div class="fw-bold small text-uppercase letter-spacing" style="color: #fdba74;">3rd Place</div>
                                                <div class="fs-5 fw-bolder text-white">4k</div>
                                                <div class="text-white-50 small" style="font-size: 0.75rem;">(৳4,000)</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @{
                        var selectedPeriodName = new DateTime(Model.Ranking.SelectedYear, Model.Ranking.SelectedMonth, 1).ToString("MMMM yyyy");
                    }

                    <!-- 1. EDUCATOR / EDU ATTIR RANKINGS SECTION -->
                    <div class="card border rounded-3 mb-4 shadow-none">
                        <div class="card-header bg-light py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                                    <span class="badge bg-primary text-white rounded-pill px-2.5 py-1">1</span>
                                    <span>Educator / Edu Attir Leaderboard — @selectedPeriodName @(Model.Ranking.IsMonthCompleted ? "(Final Standings)" : "(Live Standings)")</span>
                                </h6>
                                <div class="text-muted small mt-0.5">
                                    Ranked by monthly approved educational contents (Formula: <code>Monthly Lectures + Monthly Study Materials</code>)
                                </div>
                            </div>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1">
                                @Model.Ranking.EducatorRankings.Count Educators
                            </span>
                        </div>

                        <!-- EDUCATOR REWARD INFO STRIP -->
                        <div class="bg-primary-subtle px-3 py-2 border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-2 text-primary-emphasis small">
                                <i class="bi bi-award-fill text-primary fs-6"></i>
                                <span><strong>Educator Reward Scheme:</strong> 1st: <strong>10k (৳10,000)</strong> &bull; 2nd: <strong>7k (৳7,000)</strong> &bull; 3rd: <strong>4k (৳4,000)</strong> <span class="text-muted fst-italic">(Awarded at the end of the month)</span></span>
                            </div>
                            @if (Model.Ranking.IsMonthCompleted)
                            {
                                <span class="badge bg-success text-white rounded-pill px-2.5 py-0.5 small" style="font-size: 0.75rem;"><i class="bi bi-check-circle me-1"></i>Rewards Awarded</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark rounded-pill px-2.5 py-0.5 small" style="font-size: 0.75rem;"><i class="bi bi-clock-history me-1"></i>Awarded at Month-End</span>
                            }
                        </div>

                        <div class="card-body p-0">
                            @if (!Model.Ranking.EducatorRankings.Any())
                            {
                                <div class="p-4 text-center text-muted">
                                    <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                                    No educator accounts found in the system.
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light small text-muted text-uppercase">
                                            <tr>
                                                <th style="width: 80px;" class="text-center">Rank</th>
                                                <th>Educator</th>
                                                <th class="text-center">Approved Lectures (@selectedPeriodName)</th>
                                                <th class="text-center">Approved Materials (@selectedPeriodName)</th>
                                                <th class="text-center">Monthly Score</th>
                                                <th class="text-center">Monthly Reward @(Model.Ranking.IsMonthCompleted ? "(Awarded)" : "(At Month-End)")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.Ranking.EducatorRankings)
                                            {
                                                <tr>
                                                    <td class="text-center">
                                                        <span class="badge @(item.Rank == 1 ? "bg-warning text-dark" : item.Rank == 2 ? "bg-secondary text-white" : item.Rank == 3 ? "text-white" : "bg-light text-muted border") rounded-pill px-2.5 py-1 fw-bold" @(item.Rank == 3 ? "style=background-color:#cd7f32;" : "")>
                                                            #@item.Rank
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <div class="d-flex align-items-center gap-2.5">
                                                            @if (!string.IsNullOrWhiteSpace(item.User.Picture))
                                                            {
                                                                <img src="@CloudinaryService.GetAvatarUrl(item.User.Picture, 60)" 
                                                                     alt="@item.User.FullName" 
                                                                     class="rounded-circle border" 
                                                                     style="width: 36px; height: 36px; object-fit: cover;" />
                                                            }
                                                            else
                                                            {
                                                                <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center" 
                                                                     style="width: 36px; height: 36px; font-size: 0.85rem;">
                                                                    @(string.IsNullOrEmpty(item.User.FullName) ? "E" : item.User.FullName.Substring(0, 1).ToUpper())
                                                                </div>
                                                            }
                                                            <div>
                                                                <div class="fw-bold text-dark">@item.User.FullName</div>
                                                                <div class="text-muted small">@item.User.Email</div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1">
                                                            @item.MonthlyLecturesCount lectures
                                                        </span>
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill px-2.5 py-1">
                                                            @item.MonthlyMaterialsCount materials
                                                        </span>
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="badge bg-light text-dark border rounded-pill px-3 py-1.5 fw-bold fs-6">
                                                            @item.PerformanceScore
                                                        </span>
                                                    </td>
                                                    <td class="text-center">
                                                        @if (Model.Ranking.IsMonthCompleted)
                                                        {
                                                            @if (item.Rank == 1)
                                                            {
                                                                <span class="badge bg-warning text-dark border border-warning px-3 py-1.5 fw-bold">
                                                                    <i class="bi bi-trophy-fill me-1"></i>10k (৳10,000)
                                                                </span>
                                                            }
                                                            else if (item.Rank == 2)
                                                            {
                                                                <span class="badge bg-secondary text-white border border-secondary px-3 py-1.5 fw-bold">
                                                                    <i class="bi bi-award-fill me-1"></i>7k (৳7,000)
                                                                </span>
                                                            }
                                                            else if (item.Rank == 3)
                                                            {
                                                                <span class="badge text-white px-3 py-1.5 fw-bold" style="background-color: #cd7f32;">
                                                                    <i class="bi bi-award me-1"></i>4k (৳4,000)
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted small">—</span>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            @if (item.Rank <= 3)
                                                            {
                                                                <span class="badge bg-light text-muted border px-2.5 py-1 small" title="Reward will be awarded upon month completion">
                                                                    <i class="bi bi-clock-history me-1 text-secondary"></i>Pending Month-End
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted small">—</span>
                                                            }
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- 2. LOCAL GUARDIAN RANKINGS SECTION -->
                    <div class="card border rounded-3 shadow-none">
                        <div class="card-header bg-light py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                                    <span class="badge bg-success text-white rounded-pill px-2.5 py-1">2</span>
                                    <span>Local Guardian Leaderboard — @selectedPeriodName @(Model.Ranking.IsMonthCompleted ? "(Final Standings)" : "(Live Standings)")</span>
                                </h6>
                                <div class="text-muted small mt-0.5">
                                    Ranked by Student Enrollment (@((int)(Model.Ranking.Configuration.GuardianEnrollmentWeight * 100))% weight) and Average Student Progress (@((int)(Model.Ranking.Configuration.GuardianProgressWeight * 100))% weight)
                                </div>
                            </div>
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                @Model.Ranking.GuardianRankings.Count Local Guardians
                            </span>
                        </div>

                        <!-- LOCAL GUARDIAN REWARD INFO STRIP -->
                        <div class="bg-success-subtle px-3 py-2 border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-2 text-success-emphasis small">
                                <i class="bi bi-award-fill text-success fs-6"></i>
                                <span><strong>Local Guardian Reward Scheme:</strong> 1st: <strong>10k (৳10,000)</strong> &bull; 2nd: <strong>7k (৳7,000)</strong> &bull; 3rd: <strong>4k (৳4,000)</strong> <span class="text-muted fst-italic">(Awarded at the end of the month)</span></span>
                            </div>
                            @if (Model.Ranking.IsMonthCompleted)
                            {
                                <span class="badge bg-success text-white rounded-pill px-2.5 py-0.5 small" style="font-size: 0.75rem;"><i class="bi bi-check-circle me-1"></i>Rewards Awarded</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark rounded-pill px-2.5 py-0.5 small" style="font-size: 0.75rem;"><i class="bi bi-clock-history me-1"></i>Awarded at Month-End</span>
                            }
                        </div>

                        <div class="card-body p-0">
                            @if (!Model.Ranking.GuardianRankings.Any())
                            {
                                <div class="p-4 text-center text-muted">
                                    <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                                    No local guardian accounts found in the system.
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light small text-muted text-uppercase">
                                            <tr>
                                                <th style="width: 80px;" class="text-center">Rank</th>
                                                <th>Local Guardian</th>
                                                <th class="text-center">Enrolled / Active Students</th>
                                                <th class="text-center">Avg Student Progress</th>
                                                <th class="text-center">Overall Performance Score</th>
                                                <th class="text-center">Monthly Reward @(Model.Ranking.IsMonthCompleted ? "(Awarded)" : "(At Month-End)")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.Ranking.GuardianRankings)
                                            {
                                                <tr>
                                                    <td class="text-center">
                                                        <span class="badge @(item.Rank == 1 ? "bg-warning text-dark" : item.Rank == 2 ? "bg-secondary text-white" : item.Rank == 3 ? "text-white" : "bg-light text-muted border") rounded-pill px-2.5 py-1 fw-bold" @(item.Rank == 3 ? "style=background-color:#cd7f32;" : "")>
                                                            #@item.Rank
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <div class="d-flex align-items-center gap-2.5">
                                                            @if (!string.IsNullOrWhiteSpace(item.User.Picture))
                                                            {
                                                                <img src="@CloudinaryService.GetAvatarUrl(item.User.Picture, 60)" 
                                                                     alt="@item.User.FullName" 
                                                                     class="rounded-circle border" 
                                                                     style="width: 36px; height: 36px; object-fit: cover;" />
                                                            }
                                                            else
                                                            {
                                                                <div class="rounded-circle bg-success-subtle text-success fw-bold d-flex align-items-center justify-content-center" 
                                                                     style="width: 36px; height: 36px; font-size: 0.85rem;">
                                                                    @(string.IsNullOrEmpty(item.User.FullName) ? "G" : item.User.FullName.Substring(0, 1).ToUpper())
                                                                </div>
                                                            }
                                                            <div>
                                                                <div class="fw-bold text-dark">@item.User.FullName</div>
                                                                <div class="text-muted small">@item.User.Email</div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1">
                                                            @item.TotalAssignedStudents enrolled (@item.ActiveStudentsCount active)
                                                        </span>
                                                    </td>
                                                    <td class="text-center">
                                                        <div class="d-inline-flex align-items-center gap-2" style="min-width: 140px;">
                                                            <div class="progress flex-grow-1" style="height: 6px;">
                                                                <div class="progress-bar bg-success" role="progressbar" style="width: @item.AverageStudentProgress%" aria-valuenow="@item.AverageStudentProgress" aria-valuemin="0" aria-valuemax="100"></div>
                                                            </div>
                                                            <span class="small fw-semibold text-dark">@item.AverageStudentProgress%</span>
                                                        </div>
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="badge bg-light text-dark border rounded-pill px-3 py-1.5 fw-bold fs-6">
                                                            @item.PerformanceScore
                                                        </span>
                                                    </td>
                                                    <td class="text-center">
                                                        @if (Model.Ranking.IsMonthCompleted)
                                                        {
                                                            @if (item.Rank == 1)
                                                            {
                                                                <span class="badge bg-warning text-dark border border-warning px-3 py-1.5 fw-bold">
                                                                    <i class="bi bi-trophy-fill me-1"></i>10k (৳10,000)
                                                                </span>
                                                            }
                                                            else if (item.Rank == 2)
                                                            {
                                                                <span class="badge bg-secondary text-white border border-secondary px-3 py-1.5 fw-bold">
                                                                    <i class="bi bi-award-fill me-1"></i>7k (৳7,000)
                                                                </span>
                                                            }
                                                            else if (item.Rank == 3)
                                                            {
                                                                <span class="badge text-white px-3 py-1.5 fw-bold" style="background-color: #cd7f32;">
                                                                    <i class="bi bi-award me-1"></i>4k (৳4,000)
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted small">—</span>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            @if (item.Rank <= 3)
                                                            {
                                                                <span class="badge bg-light text-muted border px-2.5 py-1 small" title="Reward will be awarded upon month completion">
                                                                    <i class="bi bi-clock-history me-1 text-secondary"></i>Pending Month-End
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted small">—</span>
                                                            }
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
