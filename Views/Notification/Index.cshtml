@model List<Onudhabon.Models.Notification>

@{
    ViewData["Title"] = "Notifications - Onudhabon";
    var activeFilter = (string)(ViewBag.ActiveFilter ?? "all");
    var unreadCount = (int)(ViewBag.UnreadCount ?? 0);
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                <div>
                    <h3 class="fw-bold text-dark mb-1">🔔 Notifications</h3>
                    <p class="text-muted small mb-0">Stay updated on your submissions, approvals, and community interactions.</p>
                </div>
                @if (unreadCount > 0)
                {
                    <form asp-controller="Notification" asp-action="MarkNotificationsAsRead" method="post" id="markAllPageForm">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                            ✓ Mark all as read
                        </button>
                    </form>
                }
            </div>

            <!-- Filter tabs -->
            <div class="card border-0 shadow-sm rounded-4 p-2 bg-white mb-4">
                <div class="d-flex gap-2">
                    <a asp-action="Index" asp-route-filter="all" class="btn btn-sm rounded-pill px-3.5 @(activeFilter == "all" ? "btn-primary" : "btn-light text-muted")">
                        All
                    </a>
                    <a asp-action="Index" asp-route-filter="unread" class="btn btn-sm rounded-pill px-3.5 @(activeFilter == "unread" ? "btn-primary" : "btn-light text-muted")">
                        Unread @if (unreadCount > 0) { <span class="badge bg-danger rounded-pill ms-1">@unreadCount</span> }
                    </a>
                </div>
            </div>

            <!-- Notification List -->
            @if (!Model.Any())
            {
                <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
                    <div class="fs-1 text-muted mb-2">🎉</div>
                    <h5 class="fw-bold text-dark">No notifications yet</h5>
                    <p class="text-muted small mb-0">You're all caught up! New approval updates and forum reactions will appear here.</p>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-2.5">
                    @foreach (var n in Model)
                    {
                        var icon = n.Type switch
                        {
                            "LectureApproval" => "🎥",
                            "MaterialApproval" => "📄",
                            "StudentApproval" => "🎓",
                            "ForumApproval" => "💬",
                            "VolunteerApproval" => "🛡️",
                            "Like" => "👍",
                            "Dislike" => "👎",
                            "Comment" => "💬",
                            _ => "🔔"
                        };

                        var link = n.Type switch
                        {
                            "LectureApproval" => "/Lecture",
                            "MaterialApproval" => "/Material",
                            "StudentApproval" => "/Admin/Dashboard?tab=students",
                            "ForumApproval" or "Like" or "Dislike" or "Comment" => "/Forum",
                            "VolunteerApproval" => "/Account/Profile",
                            _ => "#"
                        };

                        <div class="card border-0 shadow-2xs rounded-4 p-3.5 @(n.IsRead ? "bg-white" : "bg-primary-subtle border border-primary-subtle") transition-all" id="notif-card-@n.Id">
                            <div class="d-flex align-items-start gap-3">
                                <div class="rounded-circle bg-white border d-flex align-items-center justify-content-center shadow-xs" style="width: 42px; height: 42px; font-size: 1.2rem; flex-shrink: 0;">
                                    @icon
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                        <div class="fw-semibold text-dark small mb-1">
                                            @(n.Post ?? "Notification update")
                                        </div>
                                        @if (!n.IsRead)
                                        {
                                            <span class="badge bg-primary rounded-pill px-2 py-0.5" style="font-size: 0.68rem;">NEW</span>
                                        }
                                    </div>
                                    <div class="d-flex align-items-center gap-3 mt-1">
                                        <small class="text-muted" style="font-size: 0.78rem;">🕒 @n.CreatedAt.ToString("MMM dd, yyyy • h:mm tt")</small>
                                        @if (link != "#")
                                        {
                                            <a href="@link" class="small text-primary fw-semibold text-decoration-none view-notif-link" data-notif-id="@n.Id">
                                                View details →
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            document.querySelectorAll('.view-notif-link').forEach(link => {
                link.addEventListener('click', async function () {
                    const id = this.getAttribute('data-notif-id');
                    if (id) {
                        try {
                            await fetch(`/Notification/MarkSingleNotificationAsRead/${id}`, {
                                method: 'POST',
                                headers: {
                                    'RequestVerificationToken': token,
                                    'X-Requested-With': 'XMLHttpRequest'
                                }
                            });
                        } catch (e) {
                            console.error(e);
                        }
                    }
                });
            });
        });
    </script>
}
