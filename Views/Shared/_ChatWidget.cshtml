<!-- Floating AI Chatbot Widget -->
<div id="ai-chat-widget" class="ai-chat-container">
    <!-- Floating Launcher Button -->
    <button id="toggle-chat-btn" class="chat-fab shadow-lg" type="button" aria-label="Open AI Assistant" title="Chat with Onudhabon AI">
        <!-- Bot Avatar Image (Visible when closed) -->
        <img src="/images/bot-avatar.svg" alt="Onudhabon AI" class="fab-icon fab-chat-icon rounded-circle shadow-sm" width="40" height="40" />
        <!-- Close Icon (Visible when open) -->
        <svg class="fab-icon fab-close-icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
        <!-- Status indicator badge -->
        <span class="fab-status-badge" title="AI Online"></span>
    </button>

    <!-- Chat Card Window -->
    <div id="chat-window" class="chat-window-card shadow-lg" style="display: none;">
        <!-- Header -->
        <div class="chat-header">
            <div class="chat-header-left">
                <div class="position-relative">
                    <img src="/images/bot-avatar.svg" alt="Onudhabon AI" class="bot-header-avatar rounded-circle" width="40" height="40" />
                    <span class="header-status-dot" title="Active"></span>
                </div>
                <div class="chat-header-info">
                    <div class="d-flex align-items-center gap-1.5">
                        <span class="chat-header-title">Onudhabon AI</span>
                        <span class="chat-header-badge">Bot</span>
                    </div>
                    <div class="chat-header-status">
                        <span class="status-live-beacon"></span>
                        <span>Learning Companion • Online</span>
                    </div>
                </div>
            </div>
            <div class="chat-header-actions">
                <button type="button" class="chat-header-btn" id="clear-chat-btn" title="Reset conversation" aria-label="Reset conversation">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path>
                        <path d="M21 3v5h-5"></path>
                        <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path>
                        <path d="M3 21v-5h5"></path>
                    </svg>
                </button>
                <button type="button" class="chat-header-btn" id="close-chat-btn" title="Minimize chat" aria-label="Minimize chat">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Chat Messages Body -->
        <div id="chat-body" class="chat-body">
            <!-- Initial Welcome Message Container with Bot Profile Picture -->
            <div id="initial-welcome-row" class="chat-msg-row bot-msg-row">
                <div class="bot-avatar-col">
                    <img src="/images/bot-avatar.svg" alt="Onudhabon AI" class="bot-avatar-img rounded-circle shadow-sm" width="34" height="34" />
                </div>
                <div class="msg-bubble-wrapper">
                    <div class="msg-sender-meta">
                        <span class="sender-name">Onudhabon AI</span>
                        <span class="sender-badge">Assistant</span>
                    </div>
                    <div class="chat-bubble bot-bubble">
                        <div class="mb-1"><strong>Hello! I'm your AI Academic Companion.</strong> 👋</div>
                        <div>I can answer your questions, help you navigate courses and materials, or guide you through the Onudhabon platform.</div>
                    </div>
                </div>
            </div>

            <!-- Quick Suggestion Chips -->
            <div id="chat-suggestions" class="chat-suggestions-container">
                <div class="suggestions-label">Quick Inquiries:</div>
                <div class="d-flex flex-wrap gap-1.5">
                    <button type="button" class="suggestion-chip" data-prompt="Where can I find recorded lectures?">
                        <span class="chip-icon">🎥</span> Recorded Lectures
                    </button>
                    <button type="button" class="suggestion-chip" data-prompt="Where can I find study materials?">
                        <span class="chip-icon">📄</span> Study Materials
                    </button>
                    <button type="button" class="suggestion-chip" data-prompt="How do I view my profile?">
                        <span class="chip-icon">👤</span> My Profile
                    </button>
                    <button type="button" class="suggestion-chip" data-prompt="What features does Onudhabon offer?">
                        <span class="chip-icon">💡</span> Platform Guide
                    </button>
                </div>
            </div>
        </div>

        <!-- Footer / Input Box -->
        <div class="chat-footer">
            <!-- Attached PDF Document Badge -->
            <div id="chat-pdf-badge" class="chat-pdf-badge" style="display: none;">
                <div class="chat-pdf-badge-info">
                    <span class="chat-pdf-icon">📄</span>
                    <span id="chat-pdf-name" class="chat-pdf-name"></span>
                    <span id="chat-pdf-words" class="chat-pdf-words"></span>
                </div>
                <button type="button" id="chat-pdf-remove-btn" class="chat-pdf-remove-btn" title="Remove attached PDF">&times;</button>
            </div>

            <form id="chat-form" class="chat-input-form" onsubmit="return false;">
                <div class="input-wrapper">
                    <input type="file" id="chat-pdf-input" accept=".pdf" style="display: none;" />
                    <button type="button" id="chat-attach-btn" class="chat-attach-btn" title="Attach PDF Document for AI Q&A" aria-label="Attach PDF">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path>
                        </svg>
                    </button>
                    <input type="text" id="chat-input" class="chat-input-field"
                           placeholder="Ask anything about courses, materials..."
                           autocomplete="off" maxlength="1000" />
                    <button type="button" id="chat-send-btn" class="chat-send-btn" title="Send message" aria-label="Send message">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="22" y1="2" x2="11" y2="13"></line>
                            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                        </svg>
                    </button>
                </div>
            </form>
            <div class="chat-footer-note">
                ⚡ Powered by Onudhabon AI • Attach PDF or press Enter to send
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="~/css/chat-widget.css" asp-append-version="true" />

<script>
    (function() {
        const STORAGE_HISTORY_KEY = 'onudhabon_chat_history';
        const STORAGE_OPEN_KEY = 'onudhabon_chat_open';
        const BOT_AVATAR_URL = '/images/bot-avatar.svg';

        const toggleBtn = document.getElementById('toggle-chat-btn');
        const closeBtn = document.getElementById('close-chat-btn');
        const clearBtn = document.getElementById('clear-chat-btn');
        const chatWindow = document.getElementById('chat-window');
        const sendBtn = document.getElementById('chat-send-btn');
        const chatInput = document.getElementById('chat-input');
        const chatBody = document.getElementById('chat-body');
        const suggestionsBox = document.getElementById('chat-suggestions');
        const welcomeRow = document.getElementById('initial-welcome-row');

        // Formats current time into a clean "12:15 PM" format
        function getCurrentTime() {
            const now = new Date();
            let hours = now.getHours();
            const minutes = now.getMinutes();
            const ampm = hours >= 12 ? 'PM' : 'AM';
            hours = hours % 12;
            hours = hours ? hours : 12;
            const strMinutes = minutes < 10 ? '0' + minutes : minutes;
            return hours + ':' + strMinutes + ' ' + ampm;
        }

        // Retrieve conversation history from sessionStorage
        function getHistory() {
            try {
                const stored = sessionStorage.getItem(STORAGE_HISTORY_KEY);
                return stored ? JSON.parse(stored) : [];
            } catch {
                return [];
            }
        }

        // Save conversation history to sessionStorage
        function saveHistory(history) {
            try {
                sessionStorage.setItem(STORAGE_HISTORY_KEY, JSON.stringify(history));
            } catch (e) {
                console.warn('Could not save chat history to sessionStorage', e);
            }
        }

        // Format bot text: bold, code, bullet points, numbered lists, and interactive action buttons
        function formatMessage(text) {
            if (!text) return '';

            // 1. Sanitize HTML
            let safe = text
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;');

            // 2. Bold: **text**
            safe = safe.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');

            // 3. Italic: *text*
            safe = safe.replace(/\*(.*?)\*/g, '<em>$1</em>');

            // 4. Inline code: `code`
            safe = safe.replace(/`([^`]+)`/g, '<code class="bot-inline-code">$1</code>');

            // 5. Markdown links: [Label](url) -> Interactive Navigation Action Pill
            safe = safe.replace(/\[(.*?)\]\((.*?)\)/g, function(match, label, url) {
                const cleanUrl = url.trim();
                if (cleanUrl.toLowerCase().startsWith('javascript:')) return label;
                return `<a href="${cleanUrl}" class="bot-nav-btn">
                                <span>${label}</span>
                                <svg class="bot-nav-arrow" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 8h10M9 4l4 4-4 4"/>
                                </svg>
                            </a>`;
            });

            // 6. Bullet points
            safe = safe.replace(/^\s*[-*]\s+(.*)$/gm, '• $1');

            // 7. Convert newlines to line breaks
            safe = safe.replace(/\n/g, '<br>');

            return safe;
        }

        // Append a message bubble to DOM with Bot profile picture
        function renderBubble(role, text, timeStr) {
            const isUser = role === 'user';
            const time = timeStr || getCurrentTime();
            const row = document.createElement('div');
            row.className = `chat-msg-row ${isUser ? 'user-msg-row' : 'bot-msg-row'}`;

            if (isUser) {
                row.innerHTML = `
                        <div class="msg-bubble-wrapper align-items-end">
                            <div class="chat-bubble user-bubble shadow-sm text-start">
                                ${escapeHtml(text)}
                            </div>
                            <div class="msg-time text-end">${time}</div>
                        </div>
                    `;
            } else {
                row.innerHTML = `
                        <div class="bot-avatar-col">
                            <img src="${BOT_AVATAR_URL}" alt="Onudhabon AI" class="bot-avatar-img rounded-circle shadow-sm" width="34" height="34" />
                        </div>
                        <div class="msg-bubble-wrapper">
                            <div class="msg-sender-meta">
                                <span class="sender-name">Onudhabon AI</span>
                                <span class="sender-badge">Assistant</span>
                            </div>
                            <div class="chat-bubble bot-bubble shadow-sm">
                                ${formatMessage(text)}
                            </div>
                            <div class="msg-time">${time}</div>
                        </div>
                    `;
            }

            chatBody.appendChild(row);
            scrollChatToBottom();
        }

        function escapeHtml(str) {
            return str
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;')
                .replace(/\n/g, '<br>');
        }

        function scrollChatToBottom() {
            setTimeout(() => {
                chatBody.scrollTop = chatBody.scrollHeight;
            }, 10);
        }

        // Restore chat state on page load from sessionStorage
        function restoreSession() {
            const history = getHistory();
            if (history.length > 0) {
                if (suggestionsBox) suggestionsBox.style.display = 'none';
                history.forEach(item => {
                    renderBubble(item.role, item.text, item.time);
                });
                scrollChatToBottom();
            }

            // Restore chat window open/closed state
            const wasOpen = sessionStorage.getItem(STORAGE_OPEN_KEY) === 'true';
            if (wasOpen) {
                chatWindow.style.display = 'flex';
                toggleBtn.classList.add('is-open');
                toggleBtn.setAttribute('title', 'Close AI Assistant');
            }
        }

        // Toggle chat window open/closed
        toggleBtn.addEventListener('click', () => {
            const isHidden = chatWindow.style.display === 'none' || !chatWindow.style.display;
            chatWindow.style.display = isHidden ? 'flex' : 'none';
            toggleBtn.classList.toggle('is-open', isHidden);
            toggleBtn.setAttribute('title', isHidden ? 'Close AI Assistant' : 'Chat with Onudhabon AI');
            sessionStorage.setItem(STORAGE_OPEN_KEY, isHidden ? 'true' : 'false');
            if (isHidden) {
                chatInput.focus();
                scrollChatToBottom();
            }
        });

        closeBtn.addEventListener('click', () => {
            chatWindow.style.display = 'none';
            toggleBtn.classList.remove('is-open');
            toggleBtn.setAttribute('title', 'Chat with Onudhabon AI');
            sessionStorage.setItem(STORAGE_OPEN_KEY, 'false');
        });

        // Close on Escape key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && chatWindow.style.display === 'flex') {
                chatWindow.style.display = 'none';
                toggleBtn.classList.remove('is-open');
                sessionStorage.setItem(STORAGE_OPEN_KEY, 'false');
            }
        });

        // PDF Attachment state & handling
        const pdfInput = document.getElementById('chat-pdf-input');
        const attachBtn = document.getElementById('chat-attach-btn');
        const pdfBadge = document.getElementById('chat-pdf-badge');
        const pdfNameSpan = document.getElementById('chat-pdf-name');
        const pdfWordsSpan = document.getElementById('chat-pdf-words');
        const pdfRemoveBtn = document.getElementById('chat-pdf-remove-btn');

        let currentAttachedPdfText = null;
        let currentAttachedPdfName = null;

        function clearAttachedPdf() {
            currentAttachedPdfText = null;
            currentAttachedPdfName = null;
            if (pdfBadge) pdfBadge.style.display = 'none';
            if (pdfNameSpan) pdfNameSpan.textContent = '';
            if (pdfWordsSpan) pdfWordsSpan.textContent = '';
            if (pdfInput) pdfInput.value = '';
            if (chatInput) chatInput.placeholder = 'Ask anything about courses, materials...';
        }

        if (pdfRemoveBtn) {
            pdfRemoveBtn.addEventListener('click', clearAttachedPdf);
        }

        if (attachBtn && pdfInput) {
            attachBtn.addEventListener('click', () => {
                pdfInput.click();
            });

            pdfInput.addEventListener('change', async () => {
                const file = pdfInput.files && pdfInput.files[0];
                if (!file) return;

                if (!file.name.toLowerCase().endsWith('.pdf')) {
                    alert('Please select a valid PDF file (.pdf).');
                    pdfInput.value = '';
                    return;
                }

                if (file.size > 25 * 1024 * 1024) {
                    alert('PDF file size must be 25MB or less.');
                    pdfInput.value = '';
                    return;
                }

                pdfBadge.style.display = 'flex';
                pdfNameSpan.textContent = `Analyzing ${file.name}...`;
                pdfWordsSpan.textContent = '';
                attachBtn.disabled = true;

                try {
                    const formData = new FormData();
                    formData.append('file', file);

                    const res = await fetch('/Chat/UploadPdfForChat', {
                        method: 'POST',
                        body: formData
                    });

                    const data = await res.json();
                    if (res.ok && data.success) {
                        currentAttachedPdfText = data.text;
                        currentAttachedPdfName = data.fileName;
                        pdfNameSpan.textContent = data.fileName;
                        pdfWordsSpan.textContent = `(${data.wordCount} words)`;
                        chatInput.placeholder = `Ask anything about ${data.fileName}...`;
                        chatInput.focus();
                    } else {
                        alert(data.message || 'Could not extract text from PDF.');
                        clearAttachedPdf();
                    }
                } catch (err) {
                    alert('Failed to process PDF: ' + err.message);
                    clearAttachedPdf();
                } finally {
                    attachBtn.disabled = false;
                }
            });
        }

        // Reset chat history
        if (clearBtn) {
            clearBtn.addEventListener('click', () => {
                if (confirm('Clear chat history and start a fresh session?')) {
                    sessionStorage.removeItem(STORAGE_HISTORY_KEY);
                    clearAttachedPdf();
                    // Remove all rendered message rows except the original welcome row
                    const rows = chatBody.querySelectorAll('.chat-msg-row:not(#initial-welcome-row)');
                    rows.forEach(r => r.remove());
                    if (suggestionsBox) {
                        suggestionsBox.style.display = 'block';
                    }
                    scrollChatToBottom();
                }
            });
        }

        // Handle suggestion chips
        if (suggestionsBox) {
            suggestionsBox.addEventListener('click', (e) => {
                const chip = e.target.closest('.suggestion-chip');
                if (chip && chip.dataset.prompt) {
                    chatInput.value = chip.dataset.prompt;
                    sendMessage();
                }
            });
        }

        async function sendMessage() {
            const text = chatInput.value.trim();
            if (!text) return;

            const timeNow = getCurrentTime();

            // Hide quick suggestions once user sends a message
            if (suggestionsBox) {
                suggestionsBox.style.display = 'none';
            }

            // Render and store user message
            renderBubble('user', text, timeNow);
            const history = getHistory();
            history.push({ role: 'user', text: text, time: timeNow });
            saveHistory(history);

            chatInput.value = '';
            chatInput.disabled = true;
            sendBtn.disabled = true;
            if (attachBtn) attachBtn.disabled = true;
            scrollChatToBottom();

            // Render typing indicator with Bot Profile Picture Icon
            const loadingRow = document.createElement('div');
            loadingRow.id = 'typing-indicator-row';
            loadingRow.className = 'chat-msg-row bot-msg-row';
            loadingRow.innerHTML = `
                    <div class="bot-avatar-col">
                        <img src="${BOT_AVATAR_URL}" alt="Onudhabon AI" class="bot-avatar-img rounded-circle shadow-sm" width="34" height="34" />
                    </div>
                    <div class="msg-bubble-wrapper">
                        <div class="msg-sender-meta">
                            <span class="sender-name">Onudhabon AI</span>
                            <span class="sender-badge" style="background-color: #f1f5f9; color: #64748b;">Thinking</span>
                        </div>
                        <div class="chat-bubble bot-bubble typing-bubble shadow-sm">
                            <span class="typing-dot"></span>
                            <span class="typing-dot"></span>
                            <span class="typing-dot"></span>
                        </div>
                    </div>
                `;
            chatBody.appendChild(loadingRow);
            scrollChatToBottom();

            try {
                // Send current message, PDF text, and recent history context to server
                const res = await fetch('/Chat/SendMessage', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        message: text,
                        history: history.slice(-6),
                        attachedPdfText: currentAttachedPdfText,
                        attachedPdfName: currentAttachedPdfName
                    })
                });

                const data = await res.json();
                loadingRow.remove();

                const botReply = data.reply || 'I apologize, but I could not generate a response. Please try again.';
                const replyTime = getCurrentTime();
                renderBubble('bot', botReply, replyTime);

                // Append bot reply to history
                history.push({ role: 'bot', text: botReply, time: replyTime });
                saveHistory(history);
            } catch (err) {
                loadingRow.remove();
                const errRow = document.createElement('div');
                errRow.className = 'chat-msg-row bot-msg-row';
                errRow.innerHTML = `
                        <div class="bot-avatar-col">
                            <img src="${BOT_AVATAR_URL}" alt="Onudhabon AI" class="bot-avatar-img rounded-circle shadow-sm" width="34" height="34" />
                        </div>
                        <div class="msg-bubble-wrapper">
                            <div class="msg-sender-meta">
                                <span class="sender-name">Onudhabon AI</span>
                                <span class="sender-badge" style="background-color: #fee2e2; color: #b91c1c;">Error</span>
                            </div>
                            <div class="chat-bubble bot-bubble error-bubble shadow-sm">
                                ⚠️ Unable to connect to the AI service. Please verify your connection or model service.
                            </div>
                        </div>
                    `;
                chatBody.appendChild(errRow);
            } finally {
                chatInput.disabled = false;
                sendBtn.disabled = false;
                if (attachBtn) attachBtn.disabled = false;
                chatInput.focus();
                scrollChatToBottom();
            }
        }

        sendBtn.addEventListener('click', sendMessage);
        chatInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendMessage();
            }
        });

        // Initialize session restore on page load
        restoreSession();
    })();
</script>