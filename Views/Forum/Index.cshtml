@model IEnumerable<Onudhabon.Models.ForumPost>
@using System.Security.Claims
@using Onudhabon.Models

@{
    ViewData["Title"] = "Community Forum";
    var userReactions = ViewBag.UserReactions as Dictionary<int, bool> ?? new Dictionary<int, bool>();
    var authorProfiles = ViewBag.AuthorProfiles as Dictionary<string, ForumAuthorDto> ?? new Dictionary<string, ForumAuthorDto>(StringComparer.OrdinalIgnoreCase);
    bool isAuthenticated = User.Identity != null && User.Identity.IsAuthenticated;
}

<div class="forum-page">
    <!-- Hero Section with Background Image -->
    <section class="forum-hero">
        <div class="forum-hero-overlay"></div>
        <div class="forum-hero-content">
            <div class="forum-hero-badge">
                <i class="bi bi-chat-dots-fill"></i>
                <span>Community Exchange</span>
            </div>
            <h1>Collaborate, Ask & Share</h1>
            <p>
                Connect with educators, volunteers, and local guardians across Bangladesh. 
                Exchange ideas, discuss curriculum questions, and empower students together.
            </p>
            <div>
                @if (isAuthenticated)
                {
                    <button type="button" class="btn btn-primary btn-sm px-4 py-2.5 rounded-pill fw-bold shadow-sm d-inline-flex align-items-center gap-2" style="background: linear-gradient(135deg, #1e3a8a 0%, #1d4ed8 100%); border: none;" data-bs-toggle="modal" data-bs-target="#createPostModal">
                        <i class="bi bi-plus-lg"></i>
                        <span>Start New Discussion</span>
                    </button>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Forum" class="btn btn-primary btn-sm px-4 py-2.5 rounded-pill fw-bold shadow-sm d-inline-flex align-items-center gap-2" style="background: linear-gradient(135deg, #1e3a8a 0%, #1d4ed8 100%); border: none;">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span>Login to Participate</span>
                    </a>
                }
            </div>
        </div>
    </section>

    <!-- Main Content Container -->
    <div class="container py-5" style="max-width: 900px;">
        <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
            <div>
                <h4 class="fw-bold text-dark mb-1">Recent Discussions</h4>
                <p class="text-muted small mb-0">Community posts from verified educators and guardians</p>
            </div>
            @if (isAuthenticated)
            {
                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3.5 py-1.5 d-inline-flex align-items-center gap-1.5" data-bs-toggle="modal" data-bs-target="#createPostModal">
                    <i class="bi bi-plus-lg"></i>
                    <span>New Post</span>
                </button>
            }
        </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Posts Feed -->
    <div class="d-flex flex-column gap-3">
        @if (!Model.Any())
        {
            <div class="text-center py-5 bg-light rounded-4 border">
                <h5 class="text-muted">No forum posts yet.</h5>
                <p class="text-muted small">Be the first to start a conversation!</p>
            </div>
        }
        else
        {
            foreach (var post in Model)
            {
                bool hasReaction = userReactions.TryGetValue(post.Id, out bool isLike);
                bool isLiked = hasReaction && isLike;
                bool isDisliked = hasReaction && !isLike;

                <div id="post-@post.Id" class="card border border-light-subtle rounded-3 shadow-sm p-4 bg-white hover-shadow transition">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                        <h4 class="fw-bold text-dark mb-0">@post.Title</h4>
                        @if (post.Status == "Pending" || post.Status == "pending" || string.IsNullOrEmpty(post.Status))
                        {
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2.5 py-1 text-nowrap d-inline-flex align-items-center gap-1">
                                <i class="bi bi-clock-history"></i>
                                <span>Pending Admin Approval</span>
                            </span>
                        }
                        else if (post.Status == "Declined" || post.Status == "declined")
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1 text-nowrap d-inline-flex align-items-center gap-1">
                                <i class="bi bi-x-circle-fill"></i>
                                <span>Declined</span>
                            </span>
                        }
                    </div>
                    
                    @{
                        authorProfiles.TryGetValue(post.Author ?? "", out var authorDto);
                        var authorInitial = authorDto?.Initial ?? (!string.IsNullOrEmpty(post.Author) ? post.Author.Substring(0, 1).ToUpper() : "U");
                    }
                    <div class="d-flex align-items-center gap-2.5 mb-3">
                        @if (authorDto != null && !string.IsNullOrWhiteSpace(authorDto.AvatarUrl))
                        {
                            <img src="@authorDto.AvatarUrl" 
                                 alt="@post.Author" 
                                 class="rounded-circle border cursor-pointer author-profile-trigger" 
                                 style="width: 42px; height: 42px; object-fit: cover;" 
                                 data-author="@post.Author" 
                                 role="button" 
                                 title="Click to view @post.Author's profile preview" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center cursor-pointer author-profile-trigger border border-primary-subtle" 
                                 style="width: 42px; height: 42px; font-size: 1.05rem;" 
                                 data-author="@post.Author" 
                                 role="button" 
                                 title="Click to view @post.Author's profile preview">
                                @authorInitial
                            </div>
                        }
                        <div>
                            <div class="d-flex align-items-center gap-1.5 flex-wrap">
                                <button type="button" 
                                        class="btn btn-link p-0 text-decoration-none fw-bold text-dark author-profile-trigger user-preview-name-btn" 
                                        data-author="@post.Author" 
                                        title="Click to view @post.Author's profile preview">
                                    @post.Author
                                </button>
                                @if (!string.IsNullOrEmpty(post.AuthorRole))
                                {
                                    <span class="badge @(post.AuthorRole == "Educator" ? "bg-primary-subtle text-primary border border-primary-subtle" : (post.AuthorRole == "Local Guardian" ? "bg-success-subtle text-success border border-success-subtle" : (post.AuthorRole == "Admin" ? "bg-danger-subtle text-danger border border-danger-subtle" : "bg-secondary-subtle text-secondary"))) rounded-pill" style="font-size: 0.72rem;">
                                        @post.AuthorRole
                                    </span>
                                }
                                @if (authorDto != null && authorDto.IsVerified)
                                {
                                    <i class="bi bi-patch-check-fill text-primary" title="Verified Member" style="font-size: 0.85rem;"></i>
                                }
                            </div>
                            <div class="text-muted" style="font-size: 0.78rem;">
                                <i class="bi bi-clock me-1"></i>@post.CreatedAt.ToString("M/d/yyyy, h:mm:ss tt")
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(post.Tags))
                    {
                        <div class="d-flex flex-wrap gap-1 mb-3">
                            @foreach (var tag in post.Tags.Split(' ', StringSplitOptions.RemoveEmptyEntries))
                            {
                                <span class="badge bg-primary text-white font-monospace px-2 py-1 rounded-2" style="font-weight: 500; font-size: 0.85rem;">@tag</span>
                            }
                        </div>
                    }

                    <p class="text-dark fs-6 mb-4" style="line-height: 1.6; white-space: pre-line;">@post.Content</p>

                    <div class="d-flex justify-content-between align-items-center border-top pt-3">
                        <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 py-1 fw-semibold toggle-details-btn d-inline-flex align-items-center gap-1.5" data-post-id="@post.Id">
                            <i class="bi bi-chat-dots"></i>
                            <span>View Details (<span id="reply-count-@post.Id">@post.Replies</span> replies)</span>
                        </button>

                        <div class="d-flex gap-2">
                            <button type="button" 
                                    class="btn @(isLiked ? "btn-success text-white" : "btn-outline-success") btn-sm rounded-3 px-3 py-1 fw-medium like-btn d-inline-flex align-items-center gap-1" 
                                    id="like-btn-@post.Id"
                                    data-post-id="@post.Id"
                                    data-is-active="@(isLiked ? "true" : "false")">
                                <i class="bi bi-hand-thumbs-up"></i>
                                <span>Like (<span id="like-count-@post.Id">@post.Likes</span>)</span>
                            </button>
                            <button type="button" 
                                    class="btn @(isDisliked ? "btn-danger text-white" : "btn-outline-danger") btn-sm rounded-3 px-3 py-1 fw-medium dislike-btn d-inline-flex align-items-center gap-1" 
                                    id="dislike-btn-@post.Id"
                                    data-post-id="@post.Id"
                                    data-is-active="@(isDisliked ? "true" : "false")">
                                <i class="bi bi-hand-thumbs-down"></i>
                                <span>Dislike (<span id="dislike-count-@post.Id">@post.Dislikes</span>)</span>
                            </button>
                        </div>
                    </div>

                    <!-- Details / Replies Accordion Section -->
                    <div id="details-section-@post.Id" class="mt-3 pt-3 border-top d-none">
                        <h6 class="fw-bold mb-3 text-secondary">Replies & Comments</h6>
                        
                        <div id="comments-list-@post.Id" class="d-flex flex-column gap-2 mb-3">
                            <div class="text-muted small">Loading comments...</div>
                        </div>

                        @if (isAuthenticated)
                        {
                            <div class="input-group">
                                <input type="text" id="comment-input-@post.Id" class="form-control rounded-start-3" placeholder="Write a reply..." />
                                <button type="button" class="btn btn-primary rounded-end-3 submit-comment-btn" data-post-id="@post.Id">Reply</button>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-light border small text-muted mb-0">
                                Please <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Forum" class="fw-semibold">log in</a> to leave a reply.
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>
</div>

<!-- Modal for New Post -->
@if (isAuthenticated)
{
    <div class="modal fade" id="createPostModal" tabindex="-1" aria-labelledby="createPostModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold" id="createPostModalLabel">Start a New Discussion</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="CreatePost" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body p-4">
                        <div class="alert alert-info py-2 px-3 small rounded-3 mb-3 d-flex align-items-center gap-2">
                            <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="flex-shrink-0">
                                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                                <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0"/>
                            </svg>
                            <span>Discussions are submitted for administrator moderation before being visible to everyone.</span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Title</label>
                            <input type="text" name="title" class="form-control rounded-3" placeholder="e.g. Physics Lecture Guidance" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Content</label>
                            <textarea name="content" class="form-control rounded-3" rows="4" placeholder="Share details about what you want to discuss..." required></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Tags (space separated)</label>
                            <input type="text" name="tags" class="form-control rounded-3" placeholder="e.g. #discussion #lectures" />
                        </div>
                    </div>
                    <div class="modal-footer border-top px-4 py-3">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4">Submit for Approval</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- User Profile Preview Modal -->
<div class="modal fade" id="userProfilePreviewModal" tabindex="-1" aria-labelledby="userProfileModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
            <!-- Modal Header Banner -->
            <div class="position-relative" style="background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%); height: 95px;">
                <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body px-4 pt-0 pb-4">
                <!-- Avatar & Badges -->
                <div class="d-flex justify-content-between align-items-end mb-3" style="margin-top: -48px;">
                    <div id="profileModalAvatarContainer" class="rounded-circle border border-3 border-white shadow bg-white overflow-hidden" style="width: 84px; height: 84px;">
                        <!-- Avatar populated via JS -->
                    </div>
                    <div id="profileModalRoleBadge" class="pb-1">
                        <!-- Role badge populated via JS -->
                    </div>
                </div>

                <!-- User Name & Location -->
                <div class="mb-3">
                    <h5 class="fw-bold text-dark mb-1 d-flex align-items-center gap-1.5" id="profileModalName">
                        <!-- Full Name populated via JS -->
                    </h5>
                    <div class="text-muted small d-flex align-items-center gap-1.5" id="profileModalMeta">
                        <!-- Location & meta populated via JS -->
                    </div>
                </div>

                <!-- Bio Section -->
                <div id="profileModalBioSection" class="p-3 bg-light rounded-3 mb-3 small d-none border">
                    <div class="text-muted fw-semibold mb-1" style="font-size: 0.72rem; letter-spacing: 0.04em;">ABOUT</div>
                    <div class="text-dark" id="profileModalBio" style="line-height: 1.55;"></div>
                </div>

                <!-- Profile Information Grid -->
                <div class="row g-2.5 small border-top pt-3">
                    <div class="col-6">
                        <div class="text-muted" style="font-size: 0.72rem; letter-spacing: 0.04em;">COMMUNITY ROLE</div>
                        <div class="fw-semibold text-dark" id="profileModalRole">—</div>
                    </div>
                    <div class="col-6">
                        <div class="text-muted" style="font-size: 0.72rem; letter-spacing: 0.04em;">LOCATION</div>
                        <div class="fw-semibold text-dark" id="profileModalLocation">—</div>
                    </div>
                    <div class="col-6">
                        <div class="text-muted" style="font-size: 0.72rem; letter-spacing: 0.04em;">QUALIFICATIONS</div>
                        <div class="fw-semibold text-dark" id="profileModalEducation">—</div>
                    </div>
                    <div class="col-6">
                        <div class="text-muted" style="font-size: 0.72rem; letter-spacing: 0.04em;">MEMBER SINCE</div>
                        <div class="fw-semibold text-dark" id="profileModalMemberSince">—</div>
                    </div>
                </div>

                <!-- Platform Activity Counters -->
                <div class="row g-2 text-center mt-3 pt-3 border-top">
                    <div class="col-6">
                        <div class="p-2.5 bg-light rounded-3 border">
                            <div class="fw-bold text-primary fs-5" id="profileModalPostCount">0</div>
                            <div class="text-muted" style="font-size: 0.72rem; letter-spacing: 0.03em;">FORUM POSTS</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2.5 bg-light rounded-3 border">
                            <div class="fw-bold text-success fs-5" id="profileModalLecturesCount">0</div>
                            <div class="text-muted" style="font-size: 0.72rem; letter-spacing: 0.03em;">LECTURES SHARED</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer bg-light border-0 py-2.5 px-4 justify-content-between">
                <span class="text-muted" style="font-size: 0.78rem;">
                    <i class="bi bi-shield-check text-primary me-1"></i> Onudhabon Community Verified
                </span>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<style>
    .cursor-pointer { cursor: pointer; }
    .user-preview-name-btn {
        transition: color 0.15s ease;
    }
    .user-preview-name-btn:hover {
        color: #1d4ed8 !important;
        text-decoration: underline !important;
    }
    .author-profile-trigger:hover {
        opacity: 0.92;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            var isAuthenticated = @(isAuthenticated ? "true" : "false");
            var loginUrl = '@Url.Action("Login", "Account", new { returnUrl = "/Forum" })';

            function escapeHtml(text) {
                if (!text) return '';
                return $('<div>').text(text).html();
            }

            // Auto open & scroll to post if hash URL is provided (e.g. #post-5)
            if (window.location.hash) {
                var targetPost = $(window.location.hash);
                if (targetPost.length) {
                    $('html, body').animate({
                        scrollTop: targetPost.offset().top - 80
                    }, 500);

                    targetPost.addClass('border-primary shadow');
                    var postIdFromHash = window.location.hash.replace('#post-', '');
                    var detailsDivFromHash = $('#details-section-' + postIdFromHash);
                    if (detailsDivFromHash.length) {
                        detailsDivFromHash.removeClass('d-none');
                        loadComments(postIdFromHash);
                    }
                }
            }

            function updateReactionUI(postId, likes, dislikes, userReaction) {
                $('#like-count-' + postId).text(likes);
                $('#dislike-count-' + postId).text(dislikes);

                var likeBtn = $('#like-btn-' + postId);
                var dislikeBtn = $('#dislike-btn-' + postId);

                if (userReaction === 'like') {
                    likeBtn.removeClass('btn-outline-success').addClass('btn-success text-white').attr('data-is-active', 'true');
                    dislikeBtn.removeClass('btn-danger text-white').addClass('btn-outline-danger').attr('data-is-active', 'false');
                } else if (userReaction === 'dislike') {
                    dislikeBtn.removeClass('btn-outline-danger').addClass('btn-danger text-white').attr('data-is-active', 'true');
                    likeBtn.removeClass('btn-success text-white').addClass('btn-outline-success').attr('data-is-active', 'false');
                } else {
                    // 'none' or undone
                    likeBtn.removeClass('btn-success text-white').addClass('btn-outline-success').attr('data-is-active', 'false');
                    dislikeBtn.removeClass('btn-danger text-white').addClass('btn-outline-danger').attr('data-is-active', 'false');
                }
            }

            // Toggle Details/Comments section
            $('.toggle-details-btn').click(function () {
                var postId = $(this).data('post-id');
                var detailsDiv = $('#details-section-' + postId);
                
                if (detailsDiv.hasClass('d-none')) {
                    detailsDiv.removeClass('d-none');
                    loadComments(postId);
                } else {
                    detailsDiv.addClass('d-none');
                }
            });

            // Load Comments
            function loadComments(postId) {
                var commentsList = $('#comments-list-' + postId);
                $.get('/Forum/GetComments', { postId: postId }, function (data) {
                    commentsList.empty();
                    if (!data || data.length === 0) {
                        commentsList.append('<div class="text-muted small italic">No replies yet. Be the first to reply!</div>');
                    } else {
                        $.each(data, function (i, c) {
                            var avatarHtml = '';
                            if (c.avatarUrl) {
                                avatarHtml = '<img src="' + c.avatarUrl + '" alt="' + escapeHtml(c.author) + '" class="rounded-circle border author-profile-trigger flex-shrink-0" style="width: 32px; height: 32px; object-fit: cover; cursor: pointer;" data-author="' + escapeHtml(c.author) + '" role="button" title="View profile preview" />';
                            } else {
                                avatarHtml = '<div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center author-profile-trigger flex-shrink-0" style="width: 32px; height: 32px; font-size: 0.8rem; cursor: pointer;" data-author="' + escapeHtml(c.author) + '" role="button" title="View profile preview">' + escapeHtml(c.initial || 'U') + '</div>';
                            }

                            var roleBadgeClass = 'bg-secondary-subtle text-secondary';
                            if (c.authorRole === 'Educator') roleBadgeClass = 'bg-primary-subtle text-primary border border-primary-subtle';
                            else if (c.authorRole === 'Local Guardian') roleBadgeClass = 'bg-success-subtle text-success border border-success-subtle';
                            else if (c.authorRole === 'Admin') roleBadgeClass = 'bg-danger-subtle text-danger border border-danger-subtle';

                            var authorRoleHtml = c.authorRole ? ' <span class="badge ' + roleBadgeClass + ' rounded-pill" style="font-size: 0.68rem;">' + escapeHtml(c.authorRole) + '</span>' : '';
                            var verifiedHtml = c.isVerified ? ' <i class="bi bi-patch-check-fill text-primary" title="Verified" style="font-size: 0.75rem;"></i>' : '';

                            var item = '<div class="p-2.5 bg-light rounded-3 border small">' +
                                '<div class="d-flex align-items-center gap-2 mb-1.5">' +
                                    avatarHtml +
                                    '<div class="flex-grow-1">' +
                                        '<div class="d-flex align-items-center gap-1.5 flex-wrap">' +
                                            '<button type="button" class="btn btn-link p-0 text-decoration-none fw-semibold text-dark author-profile-trigger user-preview-name-btn" data-author="' + escapeHtml(c.author) + '" title="View profile preview">' + escapeHtml(c.author) + '</button>' +
                                            authorRoleHtml +
                                            verifiedHtml +
                                            '<span class="text-muted fw-normal ms-auto" style="font-size: 0.72rem;">' + escapeHtml(c.createdAt) + '</span>' +
                                        '</div>' +
                                    '</div>' +
                                '</div>' +
                                '<div class="text-dark ps-4 ms-2" style="white-space: pre-wrap; word-break: break-word;">' + escapeHtml(c.content) + '</div>' +
                                '</div>';
                            commentsList.append(item);
                        });
                    }
                });
            }

            // Submit Reply Comment
            $('.submit-comment-btn').click(function () {
                var postId = $(this).data('post-id');
                var input = $('#comment-input-' + postId);
                var content = input.val().trim();
                if (!content) return;

                $.post('/Forum/AddComment', { postId: postId, content: content }, function (res) {
                    if (res.success) {
                        input.val('');
                        $('#reply-count-' + postId).text(res.replies);
                        loadComments(postId);
                    } else {
                        alert(res.message || 'Error adding reply.');
                    }
                });
            });

            // Like Action
            $(document).on('click', '.like-btn', function () {
                if (!isAuthenticated) {
                    window.location.href = loginUrl;
                    return;
                }

                var postId = $(this).data('post-id');
                var btn = $(this);
                btn.prop('disabled', true);

                $.post('/Forum/Like', { id: postId }, function (res) {
                    btn.prop('disabled', false);
                    if (res.requireLogin) {
                        window.location.href = res.redirectUrl || loginUrl;
                        return;
                    }
                    if (res.success) {
                        updateReactionUI(postId, res.likes, res.dislikes, res.userReaction);
                    }
                }).fail(function () {
                    btn.prop('disabled', false);
                });
            });

            // Dislike Action
            $(document).on('click', '.dislike-btn', function () {
                if (!isAuthenticated) {
                    window.location.href = loginUrl;
                    return;
                }

                var postId = $(this).data('post-id');
                var btn = $(this);
                btn.prop('disabled', true);

                $.post('/Forum/Dislike', { id: postId }, function (res) {
                    btn.prop('disabled', false);
                    if (res.requireLogin) {
                        window.location.href = res.redirectUrl || loginUrl;
                        return;
                    }
                    if (res.success) {
                        updateReactionUI(postId, res.likes, res.dislikes, res.userReaction);
                    }
                }).fail(function () {
                    btn.prop('disabled', false);
                });
            });

            // Profile Preview Modal Trigger
            $(document).on('click', '.author-profile-trigger', function (e) {
                e.preventDefault();
                var authorName = $(this).data('author');
                if (!authorName) return;

                var profileModalEl = document.getElementById('userProfilePreviewModal');
                var modal = bootstrap.Modal.getOrCreateInstance(profileModalEl);
                modal.show();

                // Reset & show loading placeholders
                $('#profileModalName').html('<span class="placeholder-glow"><span class="placeholder col-6"></span></span>');
                $('#profileModalAvatarContainer').html('<div class="w-100 h-100 d-flex align-items-center justify-content-center bg-light"><div class="spinner-border spinner-border-sm text-primary" role="status"></div></div>');
                $('#profileModalMeta').text('Loading profile preview...');
                $('#profileModalBioSection').addClass('d-none');
                $('#profileModalRoleBadge').empty();
                $('#profileModalRole').text('—');
                $('#profileModalLocation').text('—');
                $('#profileModalEducation').text('—');
                $('#profileModalMemberSince').text('—');
                $('#profileModalPostCount').text('—');
                $('#profileModalLecturesCount').text('—');

                $.get('/Forum/GetUserProfile', { author: authorName }, function (res) {
                    if (res && res.success && res.user) {
                        var u = res.user;

                        var verifiedBadge = u.isVerified ? ' <i class="bi bi-patch-check-fill text-primary" title="Verified Member"></i>' : '';
                        $('#profileModalName').html(escapeHtml(u.fullName) + verifiedBadge);

                        if (u.avatarUrl) {
                            $('#profileModalAvatarContainer').html('<img src="' + u.avatarUrl + '" alt="' + escapeHtml(u.fullName) + '" class="w-100 h-100" style="object-fit: cover;" />');
                        } else {
                            $('#profileModalAvatarContainer').html('<div class="w-100 h-100 bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center" style="font-size: 2rem;">' + escapeHtml(u.initial || 'U') + '</div>');
                        }

                        var roleBadgeClass = 'bg-secondary-subtle text-secondary';
                        if (u.role === 'Educator') roleBadgeClass = 'bg-primary-subtle text-primary border border-primary-subtle';
                        else if (u.role === 'Local Guardian') roleBadgeClass = 'bg-success-subtle text-success border border-success-subtle';
                        else if (u.role === 'Admin') roleBadgeClass = 'bg-danger-subtle text-danger border border-danger-subtle';

                        $('#profileModalRoleBadge').html('<span class="badge rounded-pill px-3 py-1.5 fw-semibold ' + roleBadgeClass + '">' + escapeHtml(u.role || 'Community Member') + '</span>');

                        var loc = [];
                        if (u.city) loc.push(u.city);
                        if (u.area) loc.push(u.area);
                        var locStr = loc.length > 0 ? loc.join(', ') : (u.location || 'Bangladesh');
                        $('#profileModalMeta').html('<i class="bi bi-geo-alt text-primary"></i> ' + escapeHtml(locStr));
                        $('#profileModalLocation').text(locStr);

                        $('#profileModalRole').text(u.role || 'Community Member');
                        $('#profileModalMemberSince').text(u.memberSince || '—');

                        var eduParts = [];
                        if (u.educationLevel) eduParts.push(u.educationLevel);
                        if (u.major) eduParts.push(u.major);
                        if (u.universityName) eduParts.push(u.universityName);
                        else if (u.institution) eduParts.push(u.institution);
                        $('#profileModalEducation').text(eduParts.length > 0 ? eduParts.join(' • ') : 'Not specified');

                        if (u.bio && u.bio.trim().length > 0) {
                            $('#profileModalBio').text(u.bio);
                            $('#profileModalBioSection').removeClass('d-none');
                        } else {
                            $('#profileModalBioSection').addClass('d-none');
                        }

                        $('#profileModalPostCount').text(u.totalPosts != null ? u.totalPosts : '0');
                        $('#profileModalLecturesCount').text(u.totalLectures != null ? u.totalLectures : '0');
                    } else {
                        $('#profileModalName').text(authorName);
                        $('#profileModalMeta').text('Community Member');
                        $('#profileModalAvatarContainer').html('<div class="w-100 h-100 bg-secondary-subtle text-secondary fw-bold d-flex align-items-center justify-content-center" style="font-size: 2rem;">' + authorName.substring(0, 1).toUpperCase() + '</div>');
                    }
                }).fail(function () {
                    $('#profileModalName').text(authorName);
                    $('#profileModalMeta').text('Community Member');
                });
            });
        });
    </script>
}
