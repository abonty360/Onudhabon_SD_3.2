@model Onudhabon_ISD.Models.StudentEnrollmentViewModel

@{
    ViewData["Title"] = "Enroll Student under Guardianship - Onudhabon";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3 rounded-pill">
                    ← Back to Enrolled Students
                </a>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <div class="text-center mb-4">
                    <div class="rounded-circle bg-primary-subtle text-primary d-inline-flex p-3 mb-2">
                        <svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                        </svg>
                    </div>
                    <h3 class="fw-bold text-dark">Enroll New Student</h3>
                    <p class="text-muted">Register a child under your local guardianship. Upload their legal guardian consent letter for verification.</p>
                </div>

                <!-- Info Alert -->
                <div class="alert alert-info border-0 rounded-4 d-flex align-items-start gap-2 mb-4 p-3" style="background-color: #e0f2fe; color: #0369a1;">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="flex-shrink-0 mt-0.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <div class="small">
                        <strong>Administrative Moderation:</strong> Enrolled students are set to <strong>Pending</strong> status until verified and approved by the platform administrator.
                    </div>
                </div>

                <form asp-action="Enroll" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-3"></div>

                    <!-- Hidden Guardianship Fields -->
                    <input type="hidden" asp-for="GuardianId" />
                    <input type="hidden" asp-for="GuardianName" />

                    <!-- Section 1: Student Information -->
                    <div class="border rounded-4 p-3.5 mb-4 bg-light">
                        <h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                            <span class="badge bg-primary rounded-circle" style="width: 24px; height: 24px; font-size: 0.8rem; line-height: 1.5;">1</span>
                            Student Information
                        </h5>

                        <div class="row g-3">
                            <!-- Student Full Name -->
                            <div class="col-md-7">
                                <label asp-for="FullName" class="form-label fw-semibold">Student Full Name *</label>
                                <input asp-for="FullName" class="form-control rounded-3" placeholder="e.g. Tanvir Ahmed" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>

                            <!-- Birth Certificate ID -->
                            <div class="col-md-5">
                                <label asp-for="BirthCertificateId" class="form-label fw-semibold">Birth Certificate ID *</label>
                                <input asp-for="BirthCertificateId" id="birthCertificateInput" class="form-control rounded-3" placeholder="e.g. 20152692518102345" />
                                <span asp-validation-for="BirthCertificateId" class="text-danger small"></span>
                                <div id="birthCertValidationMsg" class="text-danger small mt-1" style="display: none;"></div>
                            </div>

                            <!-- Class Level -->
                            <div class="col-md-6">
                                <label asp-for="ClassLevel" class="form-label fw-semibold">Class Level *</label>
                                <select asp-for="ClassLevel" id="classLevelSelect" class="form-select rounded-3">
                                    <option value="">Select Class</option>
                                    @for (int i = 1; i <= 12; i++)
                                    {
                                        <option value="@i">Class @i</option>
                                    }
                                </select>
                                <span asp-validation-for="ClassLevel" class="text-danger small"></span>
                            </div>

                            <!-- Enrollment Year -->
                            <div class="col-md-6">
                                <label asp-for="EnrollmentYear" class="form-label fw-semibold">Enrollment Year</label>
                                <input asp-for="EnrollmentYear" class="form-control rounded-3" placeholder="2026" />
                                <span asp-validation-for="EnrollmentYear" class="text-danger small"></span>
                            </div>

                            <!-- Hidden Subjects field (populated automatically) -->
                            <input type="hidden" asp-for="Subjects" id="subjectsInput" />

                            <!-- Dynamic Subject Badges Display -->
                            <div class="col-12" id="subjectsBadgeWrapper" style="display: none;">
                                <div class="p-3 bg-white border rounded-3 small">
                                    <div class="text-muted fw-semibold mb-2" style="font-size: 0.8rem;">Curriculum Subjects for this class:</div>
                                    <div id="subjectsBadges" class="d-flex flex-wrap gap-1.5"></div>
                                </div>
                            </div>

                            <!-- Residential Address -->
                            <div class="col-12">
                                <label asp-for="Address" class="form-label fw-semibold">Residential Address / Area</label>
                                <input asp-for="Address" class="form-control rounded-3" placeholder="e.g. Village: Sreepur, Union: Bormi, Gazipur" />
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Section 2: Parents Information -->
                    <div class="border rounded-4 p-3.5 mb-4 bg-light">
                        <h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                            <span class="badge bg-primary rounded-circle" style="width: 24px; height: 24px; font-size: 0.8rem; line-height: 1.5;">2</span>
                            Parents & Family Details
                        </h5>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="FatherName" class="form-label fw-semibold">Father's Name</label>
                                <input asp-for="FatherName" class="form-control rounded-3" placeholder="e.g. Md. Rafiqul Islam" />
                                <span asp-validation-for="FatherName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="MotherName" class="form-label fw-semibold">Mother's Name</label>
                                <input asp-for="MotherName" class="form-control rounded-3" placeholder="e.g. Nasima Begum" />
                                <span asp-validation-for="MotherName" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Section 3: Legal Guardian Consent Letter -->
                    <div class="border rounded-4 p-3.5 mb-4 bg-light">
                        <h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                            <span class="badge bg-primary rounded-circle" style="width: 24px; height: 24px; font-size: 0.8rem; line-height: 1.5;">3</span>
                            Legal Guardian Consent Document
                        </h5>

                        <div>
                            <label asp-for="ConsentLetterFile" class="form-label fw-semibold">Upload Consent Letter (PDF, PNG, JPG)</label>
                            <input asp-for="ConsentLetterFile" type="file" accept=".pdf,image/*" class="form-control form-control-lg rounded-3" />
                            <span class="text-muted small d-block mt-1">
                                Securely uploaded to Cloudinary <code>onudhabon/consent_letters</code>. Contains written permission from legal parent/guardian for Onudhabon enrollment.
                            </span>
                            <span asp-validation-for="ConsentLetterFile" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Section 4: Local Guardian Info Card -->
                    <div class="p-3 bg-white border rounded-4 mb-4 shadow-sm">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-success-subtle text-success p-2.5">
                                <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                                </svg>
                            </div>
                            <div>
                                <div class="fw-bold text-dark">Local Guardian: @(Model.GuardianName ?? User.Identity?.Name ?? "Local Guardian")</div>
                                <div class="text-muted small">You will oversee this student's learning roadmap, class completion, and guardianship communications.</div>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill shadow-sm">
                        Submit Student Enrollment (Status: Pending Approval)
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const classSelect = document.getElementById('classLevelSelect');
            const subjectsInput = document.getElementById('subjectsInput');
            const subjectsBadgeWrapper = document.getElementById('subjectsBadgeWrapper');
            const subjectsBadges = document.getElementById('subjectsBadges');
            const birthCertInput = document.getElementById('birthCertificateInput');
            const birthCertValidationMsg = document.getElementById('birthCertValidationMsg');

            function loadSubjectsForClass(classLevel) {
                if (!classLevel) {
                    subjectsInput.value = '';
                    subjectsBadgeWrapper.style.display = 'none';
                    subjectsBadges.innerHTML = '';
                    return;
                }

                fetch('/Student/GetClassPlanSubjects?classLevel=' + encodeURIComponent(classLevel))
                    .then(response => response.json())
                    .then(data => {
                        if (data && data.subjects && data.subjects.length > 0) {
                            subjectsInput.value = data.formatted;
                            subjectsBadges.innerHTML = '';
                            data.subjects.forEach(subject => {
                                const badge = document.createElement('span');
                                badge.className = 'badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1';
                                badge.textContent = subject;
                                subjectsBadges.appendChild(badge);
                            });
                            subjectsBadgeWrapper.style.display = 'block';
                        } else {
                            subjectsInput.value = 'General Curriculum';
                            subjectsBadgeWrapper.style.display = 'none';
                            subjectsBadges.innerHTML = '';
                        }
                    })
                    .catch(err => {
                        console.error('Failed to load class plan subjects:', err);
                    });
            }

            if (classSelect) {
                classSelect.addEventListener('change', function () {
                    loadSubjectsForClass(this.value);
                });

                // Auto-load if class level is already pre-selected
                if (classSelect.value) {
                    loadSubjectsForClass(classSelect.value);
                }
            }

            // Real-time unique validation for Birth Certificate ID
            if (birthCertInput) {
                birthCertInput.addEventListener('blur', function () {
                    const idVal = this.value.trim();
                    if (!idVal) {
                        birthCertValidationMsg.style.display = 'none';
                        return;
                    }

                    fetch('/Student/CheckBirthCertificateId?birthCertificateId=' + encodeURIComponent(idVal))
                        .then(response => response.json())
                        .then(data => {
                            if (data && !data.isUnique) {
                                birthCertValidationMsg.textContent = 'This Birth Certificate ID is already registered in the system.';
                                birthCertValidationMsg.style.display = 'block';
                            } else {
                                birthCertValidationMsg.style.display = 'none';
                            }
                        })
                        .catch(err => console.error('Birth cert check error:', err));
                });
            }
        });
    </script>
}
