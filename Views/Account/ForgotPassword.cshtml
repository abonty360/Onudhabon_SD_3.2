@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-card">
    <div class="auth-card-body">
        <div class="auth-header">
            <div class="auth-logo-wrapper">
                <img src="~/images/login_logo.png" alt="Onudhabon Logo" class="auth-logo" asp-append-version="true" />
            </div>
            <h1 class="auth-title">Reset Password</h1>
            <h2 class="auth-subtitle">Exploring Education</h2>
            <p class="auth-tagline">Enter your email address to receive a recovery link</p>
        </div>

        <form method="post" asp-action="ForgotPassword" asp-controller="Account">
            @Html.AntiForgeryToken()

            <div class="auth-form-group">
                <label class="auth-label">Email Address</label>
                <div class="auth-input-group">
                    <span class="auth-input-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="4"></circle>
                            <path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-3.92 7.94"></path>
                        </svg>
                    </span>
                    <input type="email" name="email" class="auth-input" placeholder="name@example.com" required />
                </div>
            </div>

            <button type="submit" class="auth-submit-btn mb-3">
                <span>Send Reset Link</span>
                <span class="auth-btn-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </span>
            </button>

            <div class="text-center mt-3">
                <a asp-action="Login" asp-controller="Account" class="auth-forgot-link">
                    &larr; Back to Login
                </a>
            </div>
        </form>
    </div>

    <div class="auth-card-footer">
        <a asp-action="Login" asp-controller="Account" class="auth-guest-link">
            <span>Return to Sign In</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
        </a>
    </div>
</div>
