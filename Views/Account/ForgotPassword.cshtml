@model Onudhabon.Models.ForgotPasswordViewModel

@{
    Layout = null;
    ViewData["Title"] = "Forgot Password - Onudhabon";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <style>
        .icon-badge {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
            color: #1d4ed8;
            margin-bottom: 16px;
        }
    </style>
</head>
<body>
    <div class="login-page-container">
        <div class="login-card" style="max-width: 460px;">
            <!-- Logo Section -->
            <div class="logo-section">
                <a asp-controller="Home" asp-action="Index" class="logo-link">
                    <img src="~/images/login_logo.png" asp-append-version="true" alt="Onudhabon Logo" class="logo-icon" />
                </a>
                <h1 class="app-title">Onudhabon</h1>
                <div class="subtitle">Exploring Education</div>
            </div>

            <div class="px-4 pt-1 pb-4 text-center">
                <div class="icon-badge shadow-sm">
                    <svg width="36" height="36" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                    </svg>
                </div>

                <h3 class="fw-bold text-dark mb-1">Forgot Password?</h3>
                <p class="text-secondary small mb-3">
                    Enter your registered email address and we'll send you a link to reset your password.
                </p>

                <!-- Error Alerts -->
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger d-flex align-items-center gap-2 text-start rounded-3 py-2 px-3 small mb-3" role="alert">
                        <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                            <path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 4.995z"/>
                        </svg>
                        <span>@TempData["ErrorMessage"]</span>
                    </div>
                }

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert alert-danger text-start rounded-3 py-2 px-3 small mb-3" role="alert">
                        <div asp-validation-summary="ModelOnly" class="mb-0"></div>
                    </div>
                }

                <!-- Forgot Password Form -->
                <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                    @Html.AntiForgeryToken()

                    <div class="form-group text-start">
                        <label asp-for="Email" class="form-label">Email Address</label>
                        <div class="input-icon-wrapper">
                            <span class="input-icon">
                                <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207" />
                                </svg>
                            </span>
                            <input asp-for="Email" class="auth-input" placeholder="name@example.com" autocomplete="email" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="validation-error-text"></span>
                    </div>

                    <button type="submit" class="btn-submit">
                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                        <span>Send Reset Link</span>
                    </button>
                </form>

                <div class="mt-4 pt-2">
                    <a asp-controller="Account" asp-action="Login" class="text-decoration-none small text-secondary me-3">
                        &larr; Return to Sign In
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="text-decoration-none small text-muted">
                        Browse as Guest
                    </a>
                </div>
            </div>
        </div>

        <div class="fixed-bottom-copyright">
            &copy; @DateTime.Now.Year Onudhabon. All rights reserved.
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
