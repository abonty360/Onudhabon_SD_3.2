    <!-- Client-Side Interactions -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Helper function to setup password toggle
            function setupPasswordToggle(toggleBtnId, inputId, eyeOpenId, eyeClosedId) {
                const toggleBtn = document.getElementById(toggleBtnId);
                const passwordInput = document.getElementById(inputId);
                const eyeOpen = document.getElementById(eyeOpenId);
                const eyeClosed = document.getElementById(eyeClosedId);

                if (toggleBtn && passwordInput) {
                    toggleBtn.addEventListener('click', function (e) {
                        e.preventDefault();
                        const isPassword = passwordInput.getAttribute('type') === 'password';
                        passwordInput.setAttribute('type', isPassword ? 'text' : 'password');

                        if (isPassword) {
                            eyeOpen.style.display = 'none';
                            eyeClosed.style.display = 'inline-block';
                            toggleBtn.setAttribute('aria-label', 'Hide password');
                        } else {
                            eyeOpen.style.display = 'inline-block';
                            eyeClosed.style.display = 'none';
                            toggleBtn.setAttribute('aria-label', 'Show password');
                        }
                    });
                }
            }

            setupPasswordToggle('toggleRegPwdBtn', 'regPassword', 'regEyeOpen', 'regEyeClosed');
            setupPasswordToggle('toggleRegConfirmPwdBtn', 'regConfirmPassword', 'regConfirmEyeOpen', 'regConfirmEyeClosed');

            // Profile photo input change handler
            const photoInput = document.getElementById('profilePhotoInput');
            const uploadMainText = document.getElementById('uploadMainText');
            const uploadSubText = document.getElementById('uploadSubText');

            if (photoInput && uploadMainText && uploadSubText) {
                photoInput.addEventListener('change', function () {
                    if (photoInput.files && photoInput.files.length > 0) {
                        const file = photoInput.files[0];
                        uploadMainText.textContent = file.name.length > 20 ? file.name.substring(0, 17) + '...' : file.name;
                        uploadSubText.textContent = (file.size / (1024 * 1024)).toFixed(2) + ' MB';
                    }
                });
            }

            // Certificate/Document upload and drag-drop handler
            const docInput = document.getElementById('certificateDocInput');
            const docUploadMainText = document.getElementById('docUploadMainText');
            const docUploadSubText = document.getElementById('docUploadSubText');
            const docDropZone = document.getElementById('docDropZone');

            if (docInput && docUploadMainText && docUploadSubText) {
                docInput.addEventListener('change', function () {
                    if (docInput.files && docInput.files.length > 0) {
                        const file = docInput.files[0];
                        docUploadMainText.textContent = file.name.length > 35 ? file.name.substring(0, 32) + '...' : file.name;
                        docUploadSubText.textContent = (file.size / (1024 * 1024)).toFixed(2) + ' MB (Selected - click to change)';
                    }
                });
            }

            if (docDropZone && docInput) {
                ['dragenter', 'dragover'].forEach(eventName => {
                    docDropZone.addEventListener(eventName, function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        docDropZone.classList.add('dragover');
                    });
                });
                ['dragleave', 'drop'].forEach(eventName => {
                    docDropZone.addEventListener(eventName, function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        docDropZone.classList.remove('dragover');
                    });
                });
                docDropZone.addEventListener('drop', function (e) {
                    if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
                        docInput.files = e.dataTransfer.files;
                        const event = new Event('change');
                        docInput.dispatchEvent(event);
                    }
                });
            }

            // ================= City to Region / Area Dynamic Cascade =================
            const cityRegions = {
                "Dhaka": [
                    "Dhanmondi", "Gulshan", "Banani", "Uttara", "Mirpur",
                    "Mohammadpur", "Bashundhara R/A", "Mohakhali", "Badda",
                    "Motijheel", "Old Dhaka (Puran Dhaka)", "Farmgate", "Shahbagh",
                    "Khilgaon", "Rampura", "Malibagh", "Lalmatia", "Shantinagar",
                    "Tejgaon", "Jatrabari", "Savar", "Keraniganj", "Cantonment",
                    "Uttarkhan / Dakshinkhan", "Other / Sub-area"
                ],
                "Sylhet": [
                    "Zindabazar", "Amberkhana", "Shibganj", "Upashahar", "Subidbazar",
                    "Lamabazar", "Kumarpara", "Mira Bazar", "Tilagarh", "Chowhatta",
                    "Kazirbazar", "Pathantula", "Shahjalal Upashahar", "Akhalia",
                    "Majortila", "Dargah Gate", "Kadamtoli", "South Surma",
                    "Beanibazar", "Golapganj", "Sreemangal", "Other / Sub-area"
                ],
                "Chittagong": [
                    "Agrabad", "Nasirabad", "GEC Circle", "Halishahar", "Panchlaish",
                    "Khulshi", "Chandgaon", "Kotwali", "Chawkbazar", "Muradpur",
                    "Bakalia", "Pahartali", "Patenga", "Bayezid Bostami",
                    "Lalkhan Bazar", "Oxygen", "Other / Sub-area"
                ],
                "Rajshahi": [
                    "Boalia", "Motihar", "Rajpara", "Shah Makhdum", "Kazihata",
                    "Upashahar", "Talaimari", "Shaheb Bazar", "Padma Residential",
                    "Binodpur", "Laxmipur", "Shihoroil", "Other / Sub-area"
                ],
                "Khulna": [
                    "Boyra", "Sonadanga", "Khalishpur", "Daulatpur", "Khan Jahan Ali",
                    "Shibbari", "Nirala", "Rupsha", "Tutpara", "Gollamari",
                    "Mujgunni", "Khulna Sadar", "Other / Sub-area"
                ],
                "Barisal": [
                    "Sadar Road", "Natullabad", "Rupatoli", "Brown Compound", "Alekanda",
                    "Band Road", "C&B Road", "Kaunia", "Launch Ghat", "Amanatganj",
                    "Chandmari", "Other / Sub-area"
                ],
                "Rangpur": [
                    "Jahaj Company More", "Modern More", "RK Road", "Dhap", "Lalbagh",
                    "Terminal", "Radhaballabh", "Senpara", "Kellaband",
                    "Shapla Chattar", "Rangpur Sadar", "Other / Sub-area"
                ],
                "Mymensingh": [
                    "Town Hall", "Ganginarpar", "Charpara", "Maskanda", "Notun Bazar",
                    "Krishtopur", "Shehara", "Sankipara", "Boundary Road",
                    "Kewatkhali", "Mymensingh Sadar", "Other / Sub-area"
                ]
            };

            const citySelect = document.getElementById('citySelect');
            const regionSelect = document.getElementById('regionSelect');
            const regionWrapper = document.getElementById('regionWrapper');
            const preselectedRegion = '@Html.Raw(Model?.RegionOrArea ?? "")';

            function populateRegions(city, selectedRegion) {
                if (!regionSelect) return;
                regionSelect.innerHTML = '';

                if (!city || !cityRegions[city]) {
                    const defaultOption = document.createElement('option');
                    defaultOption.value = '';
                    defaultOption.disabled = true;
                    defaultOption.selected = true;
                    defaultOption.textContent = 'Choose city first';
                    regionSelect.appendChild(defaultOption);
                    regionSelect.disabled = true;
                    if (regionWrapper) {
                        regionWrapper.classList.add('is-disabled');
                    }
                    return;
                }

                regionSelect.disabled = false;
                if (regionWrapper) {
                    regionWrapper.classList.remove('is-disabled');
                }

                const placeholderOption = document.createElement('option');
                placeholderOption.value = '';
                placeholderOption.disabled = true;
                placeholderOption.selected = !selectedRegion;
                placeholderOption.textContent = 'Choose region/area';
                regionSelect.appendChild(placeholderOption);

                const regions = cityRegions[city];
                let hasMatch = false;
                regions.forEach(function (r) {
                    const opt = document.createElement('option');
                    opt.value = r;
                    opt.textContent = r;
                    if (selectedRegion && selectedRegion === r) {
                        opt.selected = true;
                        hasMatch = true;
                    }
                    regionSelect.appendChild(opt);
                });

                if (selectedRegion && !hasMatch) {
                    const customOpt = document.createElement('option');
                    customOpt.value = selectedRegion;
                    customOpt.textContent = selectedRegion;
                    customOpt.selected = true;
                    regionSelect.appendChild(customOpt);
                }
            }

            if (citySelect && regionSelect) {
                citySelect.addEventListener('change', function () {
                    populateRegions(citySelect.value, null);
                    if (regionWrapper && regionWrapper.classList.contains('has-error')) {
                        regionWrapper.classList.remove('has-error');
                        const err = regionWrapper.parentElement.querySelector('.field-validation-error');
                        if (err) err.textContent = '';
                    }
                });

                // Initialize on load
                if (citySelect.value) {
                    populateRegions(citySelect.value, preselectedRegion);
                } else {
                    populateRegions('', null);
                }
            }

            // Dynamic error state clearing on input
            const inputs = document.querySelectorAll('.auth-input, .auth-select');
            inputs.forEach(function (input) {
                input.addEventListener('input', function () {
                    const wrapper = input.closest('.input-icon-wrapper');
                    if (wrapper && wrapper.classList.contains('has-error')) {
                        wrapper.classList.remove('has-error');
                        const errorSpan = wrapper.parentElement.querySelector('.field-validation-error');
                        if (errorSpan) {
                            errorSpan.textContent = '';
                        }
                    }
                });
            });

            // ================= Legal Modals Logic =================
            const termsModal = document.getElementById('termsModal');
            const privacyModal = document.getElementById('privacyModal');

            const openTermsLink = document.getElementById('openTermsLink');
            const openPrivacyLink = document.getElementById('openPrivacyLink');

            const closeTermsCrossBtn = document.getElementById('closeTermsCrossBtn');
            const understandTermsBtn = document.getElementById('understandTermsBtn');

            const closePrivacyCrossBtn = document.getElementById('closePrivacyCrossBtn');
            const understandPrivacyBtn = document.getElementById('understandPrivacyBtn');

            function openModal(modal) {
                if (!modal) return;
                modal.classList.add('is-active');
                document.body.style.overflow = 'hidden';
            }

            function closeModal(modal) {
                if (!modal) return;
                modal.classList.remove('is-active');
                if (!termsModal.classList.contains('is-active') && !privacyModal.classList.contains('is-active')) {
                    document.body.style.overflow = '';
                }
            }

            if (openTermsLink) {
                openTermsLink.addEventListener('click', function (e) {
                    e.preventDefault();
                    openModal(termsModal);
                });
            }

            if (openPrivacyLink) {
                openPrivacyLink.addEventListener('click', function (e) {
                    e.preventDefault();
                    openModal(privacyModal);
                });
            }

            if (closeTermsCrossBtn) {
                closeTermsCrossBtn.addEventListener('click', function () {
                    closeModal(termsModal);
                });
            }

            if (understandTermsBtn) {
                understandTermsBtn.addEventListener('click', function () {
                    closeModal(termsModal);
                });
            }

            if (closePrivacyCrossBtn) {
                closePrivacyCrossBtn.addEventListener('click', function () {
                    closeModal(privacyModal);
                });
            }

            if (understandPrivacyBtn) {
                understandPrivacyBtn.addEventListener('click', function () {
                    closeModal(privacyModal);
                });
            }

            // Close when clicking outside modal card
            [termsModal, privacyModal].forEach(function (modal) {
                if (!modal) return;
                modal.addEventListener('click', function (e) {
                    if (e.target === modal) {
                        closeModal(modal);
                    }
                });
            });

            // Close on Escape key
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    closeModal(termsModal);
                    closeModal(privacyModal);
                }
            });

            // Auto-open if query param or hash matches
            const urlParams = new URLSearchParams(window.location.search);
            const modalParam = (urlParams.get('modal') || window.location.hash.replace('#', '')).toLowerCase();
            if (modalParam === 'terms' || modalParam === 'termsmodal' || modalParam === 'terms-and-conditions') {
                openModal(termsModal);
            } else if (modalParam === 'privacy' || modalParam === 'privacymodal' || modalParam === 'privacy-policy') {
                openModal(privacyModal);
            }
        });
    </script>
</body>
</html>
