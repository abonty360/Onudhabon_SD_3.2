@model Onudhabon.Models.RegisterViewModel
@{
    // Standalone markup matching exact layout & design structure
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register - Onudhabon</title>
    <!-- Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Dedicated Auth Stylesheet -->
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body class="register-page">

    <div class="auth-wrapper register-wrapper">
        <!-- Main Registration Card -->
        <main class="auth-card" role="main">
            <div class="auth-card-body">
                
                <!-- Brand Header with Logo Asset -->
                <header class="auth-header">
                    <div class="auth-logo-wrapper">
                        <img src="~/images/login_logo.png" 
                             alt="Onudhabon Logo" 
                             class="auth-logo" 
                             asp-append-version="true" />
                    </div>
                    <h1 class="auth-title">Onudhabon</h1>
                    <h2 class="auth-subtitle">Exploring Education</h2>
                    <p class="auth-tagline">Join our community as an Educator or Local Guardian</p>
                </header>

                <!-- Floating Segmented Tabs -->
                <nav class="auth-tabs" role="tablist" aria-label="Authentication switch">
                    <a asp-action="Login" asp-controller="Account" class="auth-tab" role="tab" aria-selected="false">Login</a>
                    <a asp-action="Register" asp-controller="Account" class="auth-tab active" role="tab" aria-selected="true">Register</a>
                </nav>

                <!-- Inline Alerts: Model-Level Error Summary -->
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="auth-alert auth-alert-danger" role="alert">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                        <div asp-validation-summary="ModelOnly" class="d-inline"></div>
                    </div>
                }

                <!-- Registration Form -->
                <form asp-action="Register" 
                      asp-controller="Account" 
                      asp-route-returnUrl="@ViewData["ReturnUrl"]" 
                      method="post" 
                      enctype="multipart/form-data" 
                      id="registerForm" 
                      novalidate>
                    @Html.AntiForgeryToken()

                    <!-- ================= 1. Account & Credentials ================= -->
                    <div class="form-section-header first-section-header">
                        <div class="section-title-wrap">
                            <span class="section-badge">1</span>
                            <h3 class="section-title">Account & Credentials</h3>
                        </div>
                        <span class="section-subtitle">Basic info</span>
                    </div>

                    <div class="form-grid-2col">
                        <!-- Full Name (Full Width) -->
                        <div class="auth-form-group col-span-2">
                            <label asp-for="FullName" class="auth-label">Full Name <span class="required-star">*</span></label>
                            <div class="input-icon-wrapper @(ViewData.ModelState["FullName"]?.Errors.Count > 0 ? "has-error" : "")">
                                <span class="input-icon" aria-hidden="true">
                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="12" cy="7" r="4"></circle>
                                    </svg>
                                </span>
                                <input asp-for="FullName" 
                                       class="auth-input" 
                                       placeholder="e.g. Ayesha Rahman" 
                                       autocomplete="name" 
                                       required />
                            </div>
                            <span asp-validation-for="FullName" class="field-validation-error"></span>
                        </div>

                        <!-- Email Address -->
                        <div class="auth-form-group">
                            <label asp-for="Email" class="auth-label">Email Address <span class="required-star">*</span></label>
                            <div class="input-icon-wrapper @(ViewData.ModelState["Email"]?.Errors.Count > 0 ? "has-error" : "")">
                                <span class="input-icon" aria-hidden="true">
                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                        <polyline points="22,6 12,13 2,6"></polyline>
                                    </svg>
                                </span>
                                <input asp-for="Email" 
                                       type="email" 
                                       class="auth-input" 
                                       placeholder="name@example.com" 
                                       autocomplete="email" 
                                       required />
                            </div>
                            <span asp-validation-for="Email" class="field-validation-error"></span>
                        </div>

                        <!-- Phone Number -->
                        <div class="auth-form-group">
                            <label asp-for="PhoneNumber" class="auth-label">Phone Number <span class="required-star">*</span></label>
                            <div class="input-icon-wrapper @(ViewData.ModelState["PhoneNumber"]?.Errors.Count > 0 ? "has-error" : "")">
                                <span class="input-icon" aria-hidden="true">
                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                                    </svg>
                                </span>
                                <input asp-for="PhoneNumber" 
                                       type="tel" 
                                       class="auth-input" 
                                       placeholder="e.g. +880 1712–345678" 
                                       autocomplete="tel" 
                                       required />
                            </div>
                            <span asp-validation-for="PhoneNumber" class="field-validation-error"></span>
                        </div>

                        <!-- Role -->
                        <div class="auth-form-group">
                            <label asp-for="Role" class="auth-label">Role <span class="required-star">*</span></label>
                            <div class="input-icon-wrapper @(ViewData.ModelState["Role"]?.Errors.Count > 0 ? "has-error" : "")">
                                <span class="input-icon" aria-hidden="true">
                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="9" cy="7" r="4"></circle>
                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                    </svg>
                                </span>
                                <select asp-for="Role" class="auth-select" required>
                                    <option value="" disabled selected>Choose your role</option>
                                    <option value="Educator">Educator / Teacher</option>
                                    <option value="LocalGuardian">Local Guardian</option>
                                    <option value="Student">Student</option>
                                    <option value="Researcher">Researcher</option>
                                </select>
                                <span class="select-arrow-icon" aria-hidden="true">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="6 9 12 15 18 9"></polyline>
                                    </svg>
                                </span>
                            </div>
                            <span asp-validation-for="Role" class="field-validation-error"></span>
                        </div>

                        <!-- Profile Photo Dropzone -->
                        <div class="auth-form-group">
                            <label class="auth-label">Profile Photo</label>
                            <label for="profilePhotoInput" class="photo-upload-zone" id="photoDropZone">
                                <div class="upload-icon-badge">
                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                        <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                        <polyline points="21 15 16 10 5 21"></polyline>
                                    </svg>
                                </div>
                                <div class="upload-text-wrap">
                                    <span class="upload-main-text" id="uploadMainText">Upload Photo</span>
                                    <span class="upload-sub-text" id="uploadSubText">JPG, PNG, WebP</span>
                                </div>
                                <input type="file" 
                                       id="profilePhotoInput" 
                                       name="ProfilePhoto" 
                                       accept="image/png, image/jpeg, image/webp" 
                                       style="display:none;" />
                            </label>
                        </div>

                        <!-- Password -->
                        <div class="auth-form-group">
                            <label asp-for="Password" class="auth-label">Password <span class="required-star">*</span></label>
                            <div class="input-icon-wrapper @(ViewData.ModelState["Password"]?.Errors.Count > 0 ? "has-error" : "")">
                                <span class="input-icon" aria-hidden="true">
                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                    </svg>
                                </span>
                                <input asp-for="Password" 
                                       type="password" 
                                       id="regPassword" 
                                       class="auth-input" 
                                       placeholder="Min. 6 chars" 
                                       autocomplete="new-password" 
                                       required />
                                <button type="button" class="auth-toggle-pwd" id="toggleRegPwdBtn" title="Show/Hide Password" aria-label="Toggle password visibility">
                                    <svg id="regEyeOpen" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                        <circle cx="12" cy="12" r="3"></circle>
                                    </svg>
                                    <svg id="regEyeClosed" style="display: none;" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                        <line x1="1" y1="1" x2="23" y2="23"></line>
                                    </svg>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="field-validation-error"></span>
                        </div>

                        <!-- Confirm Password -->
                        <div class="auth-form-group">
                            <label asp-for="ConfirmPassword" class="auth-label">Confirm Password <span class="required-star">*</span></label>
                            <div class="input-icon-wrapper @(ViewData.ModelState["ConfirmPassword"]?.Errors.Count > 0 ? "has-error" : "")">
                                <span class="input-icon" aria-hidden="true">
                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                    </svg>
                                </span>
                                <input asp-for="ConfirmPassword" 
                                       type="password" 
                                       id="regConfirmPassword" 
                                       class="auth-input" 
                                       placeholder="Repeat password" 
                                       autocomplete="new-password" 
                                       required />
                                <button type="button" class="auth-toggle-pwd" id="toggleRegConfirmPwdBtn" title="Show/Hide Password" aria-label="Toggle password visibility">
                                    <svg id="regConfirmEyeOpen" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8z"></path>
                                        <circle cx="12" cy="12" r="3"></circle>
                                    </svg>
                                    <svg id="regConfirmEyeClosed" style="display: none;" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                        <line x1="1" y1="1" x2="23" y2="23"></line>
                                    </svg>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                        </div>
                    </div>

                    <!-- ================= 2. Personal & Location Information ================= -->
                    <div class="form-section-header">
                        <div class="section-title-wrap">
                            <span class="section-badge">2</span>
                            <h3 class="section-title">Personal & Location Information</h3>
                        </div>
                        <span class="section-subtitle">Identity & Address</span>
                    </div>

                    <div class="form-grid-2col">
                        <!-- Age -->
                        <div class="auth-form-group">
                            <label asp-for="Age" class="auth-label">Age</label>
                            <div class="input-icon-wrapper">
                                <span class="input-icon" aria-hidden="true">
                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                        <line x1="16" y1="2" x2="16" y2="6"></line>
                                        <line x1="8" y1="2" x2="8" y2="6"></line>
                                        <line x1="3" y1="10" x2="21" y2="10"></line>
                                    </svg>
                                </span>
                                <input asp-for="Age" 
                                       type="number" 
                                       min="10" 
                                       max="120" 
                                       class="auth-input" 
                                       placeholder="e.g. 24" />
                            </div>
                        </div>

                        <!-- NID / Birth Certificate No -->
                        <div class="auth-form-group">
                            <label asp-for="NidOrBirthCert" class="auth-label">NID / Birth Certificate No</label>
                            <div class="input-icon-wrapper">
                                <span class="input-icon" aria-hidden="true">
                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                                        <line x1="2" y1="10" x2="22" y2="10"></line>
                                    </svg>
                                </span>
                                <input asp-for="NidOrBirthCert" 
                                       class="auth-input" 
                                       placeholder="e.g. 19981234567890" />
                            </div>
                        </div>

                        <!-- City -->
                        <div class="auth-form-group">
                            <label asp-for="City" class="auth-label">City <span class="required-star">*</span></label>
                            <div class="input-icon-wrapper @(ViewData.ModelState["City"]?.Errors.Count > 0 ? "has-error" : "")">
                                <span class="input-icon" aria-hidden="true">
                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect>
                                        <line x1="9" y1="22" x2="9" y2="12"></line>
                                        <line x1="15" y1="22" x2="15" y2="12"></line>
                                        <line x1="9" y1="6" x2="9.01" y2="6"></line>
                                        <line x1="15" y1="6" x2="15.01" y2="6"></line>
                                        <line x1="9" y1="10" x2="9.01" y2="10"></line>
                                        <line x1="15" y1="10" x2="15.01" y2="10"></line>
                                    </svg>
                                </span>
                                <select asp-for="City" id="citySelect" class="auth-select" required>
                                    <option value="" disabled selected>Choose city</option>
                                    <option value="Dhaka">Dhaka</option>
                                    <option value="Chittagong">Chittagong</option>
                                    <option value="Rajshahi">Rajshahi</option>
                                    <option value="Khulna">Khulna</option>
                                    <option value="Barisal">Barisal</option>
                                    <option value="Sylhet">Sylhet</option>
                                    <option value="Rangpur">Rangpur</option>
                                    <option value="Mymensingh">Mymensingh</option>
                                </select>
                                <span class="select-arrow-icon" aria-hidden="true">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="6 9 12 15 18 9"></polyline>
                                    </svg>
                                </span>
                            </div>
                            <span asp-validation-for="City" class="field-validation-error"></span>
                        </div>

                        <!-- Region / Area -->
                        <div class="auth-form-group">
                            <label asp-for="RegionOrArea" class="auth-label">Region / Area <span class="required-star">*</span></label>
                            <div class="input-icon-wrapper @(ViewData.ModelState["RegionOrArea"]?.Errors.Count > 0 ? "has-error" : "")" id="regionWrapper">
                                <span class="input-icon" aria-hidden="true">
                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                        <circle cx="12" cy="10" r="3"></circle>
                                    </svg>
                                </span>
                                <select asp-for="RegionOrArea" id="regionSelect" class="auth-select" required disabled>
                                    <option value="" disabled selected>Choose city first</option>
                                </select>
                                <span class="select-arrow-icon" aria-hidden="true">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="6 9 12 15 18 9"></polyline>
                                    </svg>
                                </span>
                            </div>
                            <span asp-validation-for="RegionOrArea" class="field-validation-error"></span>
                        </div>

                        <!-- Detailed Address / Location (Full Width) -->
                        <div class="auth-form-group col-span-2">
                            <label asp-for="DetailedAddress" class="auth-label">Detailed Address / Location</label>
                            <div class="input-icon-wrapper">
                                <span class="input-icon" aria-hidden="true">
                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                                    </svg>
                                </span>
                                <input asp-for="DetailedAddress" 
                                       class="auth-input" 
                                       placeholder="House #, Road #, Area details..." />
                            </div>
                        </div>

                        <!-- Short Bio (Full Width) -->
                        <div class="auth-form-group col-span-2">
                            <label asp-for="ShortBio" class="auth-label">Short Bio</label>
                            <div class="input-icon-wrapper auth-textarea-wrapper">
                                <span class="input-icon textarea-icon" aria-hidden="true">
                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                    </svg>
                                </span>
                                <textarea asp-for="ShortBio" 
                                          class="auth-input auth-textarea" 
                                          rows="2" 
                                          placeholder="Tell us about how you'd like to support our community and learners."></textarea>
                            </div>
                            <span asp-validation-for="ShortBio" class="field-validation-error"></span>
                        </div>
                    </div>

                    <!-- ================= 3. Academic & Educational Background ================= -->
                    <div class="form-section-header">
                        <div class="section-title-wrap">
                            <span class="section-badge">3</span>
                            <h3 class="section-title">Academic & Educational Background</h3>
                        </div>
                        <span class="section-subtitle">Qualifications</span>
                    </div>

                    <div class="form-grid-2col">
                        <!-- Highest Education Level -->
                        <div class="auth-form-group">
                            <label asp-for="HighestEducationLevel" class="auth-label">Highest Education Level</label>
                            <div class="input-icon-wrapper">
                                <span class="input-icon" aria-hidden="true">
                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                                        <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                                    </svg>
                                </span>
                                <select asp-for="HighestEducationLevel" class="auth-select">
                                    <option value="" disabled selected>Select Education Level</option>
                                    <option value="Secondary">Secondary / SSC</option>
                                    <option value="HigherSecondary">Higher Secondary / HSC</option>
                                    <option value="Diploma">Diploma / Polytechnic</option>
                                    <option value="Bachelors">Bachelor's / Undergraduate</option>
                                    <option value="Masters">Master's / Postgraduate</option>
                                    <option value="Doctorate">Doctorate / PhD</option>
                                    <option value="Other">Other</option>
                                </select>
                                <span class="select-arrow-icon" aria-hidden="true">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="6 9 12 15 18 9"></polyline>
                                    </svg>
                                </span>
                            </div>
                            <span asp-validation-for="HighestEducationLevel" class="field-validation-error"></span>
                        </div>

                        <!-- Currently Enrolled / Studying? -->
                        <div class="auth-form-group">
                            <label asp-for="CurrentlyEnrolled" class="auth-label">Currently Enrolled / Studying?</label>
                            <div class="input-icon-wrapper">
                                <span class="input-icon" aria-hidden="true">
                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                                        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                                    </svg>
                                </span>
                                <select asp-for="CurrentlyEnrolled" class="auth-select">
                                    <option value="" disabled selected>Select Status</option>
                                    <option value="Yes">Currently Enrolled / Studying</option>
                                    <option value="Graduated">Graduated / Completed</option>
                                    <option value="NotEnrolled">Not Enrolled</option>
                                    <option value="OnLeave">On Leave / Gap Year</option>
                                </select>
                                <span class="select-arrow-icon" aria-hidden="true">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="6 9 12 15 18 9"></polyline>
                                    </svg>
