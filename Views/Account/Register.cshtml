    <!-- Modal: Privacy Policy -->
    <div class="legal-modal-backdrop" id="privacyModal" role="dialog" aria-modal="true" aria-labelledby="privacyModalTitle" tabindex="-1">
        <div class="legal-modal-card">
            <div class="legal-modal-header">
                <h3 class="legal-modal-title" id="privacyModalTitle">Privacy Policy</h3>
