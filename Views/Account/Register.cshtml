@model Onudhabon_ISD.Models.RegisterViewModel

@{
    Layout = null;
    ViewData["Title"] = "Create Account - Onudhabon";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <div class="login-page-container">
        <div class="login-card register-card">
            <!-- Logo Section -->
            <div class="logo-section">
                <a asp-controller="Home" asp-action="Index" class="logo-link">
                    <img src="~/images/login_logo.png" asp-append-version="true" alt="Onudhabon Logo" class="logo-icon" />
                </a>
                <h1 class="app-title">Onudhabon</h1>
                <div class="subtitle">Exploring Education</div>
                <p class="mission-text">Join our community as an Educator or Local Guardian</p>
            </div>

            <!-- Segmented Control Tabs -->
            <div class="tabs-container">
                <div class="tabs-segment">
                    <a asp-controller="Account" asp-action="Login" class="tab-btn">Login</a>
                    <a asp-controller="Account" asp-action="Register" class="tab-btn active">Register</a>
                </div>
            </div>

            <!-- Feedback Alerts -->
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <div class="alert-custom alert-danger" role="alert">
                    <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                        <path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 4.995z"/>
                    </svg>
                    <div asp-validation-summary="ModelOnly" class="mb-0"></div>
                </div>
            }

            <!-- Register Form -->
            <div class="form-panel">
                <form asp-controller="Account" asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" enctype="multipart/form-data" id="registerForm">
                    @Html.AntiForgeryToken()

                    <!-- SECTION 1: ACCOUNT & CREDENTIALS -->
                    <div class="form-section-header">
                        <span class="form-section-badge">1</span>
                        <span class="form-section-title">Account & Credentials</span>
                        <span class="form-section-subtitle">Basic info</span>
                    </div>

                    <!-- Full Name -->
                    <div class="form-group">
                        <label asp-for="FullName" class="form-label">
                            <span class="form-label-title">Full Name *</span>
                        </label>
                        <div class="input-icon-wrapper">
                            <span class="input-icon">
                                <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                            </span>
                            <input asp-for="FullName" class="auth-input" placeholder="e.g. Ayesha Rahman" autocomplete="name" />
                        </div>
                        <span asp-validation-for="FullName" class="validation-error-text"></span>
                    </div>

                    <!-- Contact: Email & Phone Number Row -->
                    <div class="form-row-2col">
                        <!-- Email Address -->
                        <div class="form-group">
                            <label asp-for="Email" class="form-label">
                                <span class="form-label-title">Email Address *</span>
                            </label>
                            <div class="input-icon-wrapper">
                                <span class="input-icon">
                                    <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                    </svg>
                                </span>
                                <input asp-for="Email" type="email" class="auth-input" placeholder="name@example.com" autocomplete="email" />
                            </div>
                            <span asp-validation-for="Email" class="validation-error-text"></span>
                        </div>

                        <!-- Phone Number -->
                        <div class="form-group">
                            <label asp-for="PhoneNumber" class="form-label">
                                <span class="form-label-title">Phone Number *</span>
                            </label>
                            <div class="input-icon-wrapper">
                                <span class="input-icon">
                                    <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                                    </svg>
                                </span>
                                <input asp-for="PhoneNumber" type="tel" class="auth-input" placeholder="e.g. +880 1712-345678" autocomplete="tel" />
                            </div>
                            <span asp-validation-for="PhoneNumber" class="validation-error-text"></span>
                        </div>
                    </div>

                    <!-- Role Selection & Profile Photo -->
                    <div class="form-row-2col">
                        <!-- Role Selection -->
                        <div class="form-group">
                            <label asp-for="Role" class="form-label">
                                <span class="form-label-title">Role *</span>
                            </label>
                            <div class="input-icon-wrapper">
                                <span class="input-icon">
                                    <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                                    </svg>
                                </span>
                                <select asp-for="Role" class="auth-select is-placeholder" id="roleSelect" onchange="updateSelectColor(this)">
                                    <option value="">Choose your role</option>
                                    <option value="Educator">Educator</option>
                                    <option value="Local Guardian">Local Guardian</option>
                                </select>
                            </div>
                            <span asp-validation-for="Role" class="validation-error-text"></span>
                        </div>

                        <!-- Profile Photo Upload -->
                        <div class="form-group">
                            <label asp-for="PictureFile" class="form-label">
                                <span class="form-label-title">Profile Photo</span>
                            </label>
                            <div class="avatar-preview-wrapper">
                                <img id="profilePreview" class="avatar-preview-img" alt="Preview" />
                                <div class="file-upload-box flex-grow-1">
                                    <input type="file" asp-for="PictureFile" class="file-upload-input" id="profilePicInput" accept="image/*" onchange="previewImage(this, 'profilePreview', 'profilePicText')" />
                                    <div class="file-upload-content">
                                        <div class="file-upload-icon">
                                            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                            </svg>
                                        </div>
                                        <div class="file-upload-text">
                                            <div class="file-upload-title" id="profilePicText">Upload Photo</div>
                                            <div class="file-upload-desc">JPG, PNG, WebP</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <span asp-validation-for="PictureFile" class="validation-error-text"></span>
                        </div>
                    </div>

                    <!-- Passwords Row -->
                    <div class="form-row-2col">
                        <!-- Password -->
                        <div class="form-group">
                            <label asp-for="Password" class="form-label">
                                <span class="form-label-title">Password *</span>
                            </label>
                            <div class="input-icon-wrapper">
                                <span class="input-icon">
                                    <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                    </svg>
                                </span>
                                <input asp-for="Password" type="password" id="regPasswordInput" class="auth-input" placeholder="Min. 6 chars" autocomplete="new-password" />
                                <button type="button" class="password-toggle-btn" onclick="togglePasswordVisibility('regPasswordInput', this)" aria-label="Toggle password visibility">
                                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                    </svg>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="validation-error-text"></span>
                        </div>

                        <!-- Confirm Password -->
                        <div class="form-group">
                            <label asp-for="ConfirmPassword" class="form-label">
                                <span class="form-label-title">Confirm Password *</span>
                            </label>
                            <div class="input-icon-wrapper">
                                <span class="input-icon">
                                    <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                                    </svg>
                                </span>
                                <input asp-for="ConfirmPassword" type="password" id="regConfirmPasswordInput" class="auth-input" placeholder="Repeat password" autocomplete="new-password" />
                                <button type="button" class="password-toggle-btn" onclick="togglePasswordVisibility('regConfirmPasswordInput', this)" aria-label="Toggle password visibility">
                                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                    </svg>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="validation-error-text"></span>
                        </div>
                    </div>

                    <!-- SECTION 2: PERSONAL & LOCATION DETAILS -->
                    <div class="form-section-header">
                        <span class="form-section-badge">2</span>
                        <span class="form-section-title">Personal & Location Information</span>
                        <span class="form-section-subtitle">Identity & Address</span>
                    </div>

                    <!-- Age & NID Number Row -->
                    <div class="form-row-2col">
                        <!-- Age -->
                        <div class="form-group">
                            <label asp-for="Age" class="form-label">
                                <span class="form-label-title">Age</span>
                            </label>
                            <div class="input-icon-wrapper">
                                <span class="input-icon">
                                    <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                    </svg>
                                </span>
                                <input asp-for="Age" type="number" min="10" max="120" class="auth-input" placeholder="e.g. 24" />
                            </div>
                            <span asp-validation-for="Age" class="validation-error-text"></span>
                        </div>

                        <!-- NID Number -->
                        <div class="form-group">
                            <label asp-for="NidNumber" class="form-label">
                                <span class="form-label-title">NID / Birth Certificate No</span>
                            </label>
                            <div class="input-icon-wrapper">
                                <span class="input-icon">
                                    <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2" />
                                    </svg>
                                </span>
                                <input asp-for="NidNumber" class="auth-input" placeholder="e.g. 19981234567890" />
                            </div>
                            <span asp-validation-for="NidNumber" class="validation-error-text"></span>
                        </div>
                    </div>

                    <!-- Location: City & Region/Area Dropdowns -->
                    <div class="form-row-2col">
                        <!-- City Dropdown -->
                        <div class="form-group">
                            <label asp-for="City" class="form-label">
                                <span class="form-label-title">City *</span>
                            </label>
                            <div class="input-icon-wrapper">
                                <span class="input-icon">
                                    <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                                    </svg>
                                </span>
                                <select asp-for="City" class="auth-select is-placeholder" id="citySelect" onchange="onCityChanged(this.value); updateSelectColor(this);">
                                    <option value="">Choose city</option>
                                    <option value="Dhaka">Dhaka</option>
                                    <option value="Chittagong">Chittagong</option>
                                    <option value="Sylhet">Sylhet</option>
                                    <option value="Barisal">Barisal</option>
                                    <option value="Khulna">Khulna</option>
                                    <option value="Rajshahi">Rajshahi</option>
                                    <option value="Rangpur">Rangpur</option>
                                    <option value="Mymensingh">Mymensingh</option>
                                    <option value="Comilla">Comilla</option>
                                    <option value="Gazipur">Gazipur</option>
                                    <option value="Narayanganj">Narayanganj</option>
                                </select>
                            </div>
                            <span asp-validation-for="City" class="validation-error-text"></span>
                        </div>

                        <!-- Region / Area Dropdown -->
                        <div class="form-group">
                            <label asp-for="Area" class="form-label">
                                <span class="form-label-title">Region / Area *</span>
                            </label>
                            <div class="input-icon-wrapper">
                                <span class="input-icon">
                                    <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                    </svg>
                                </span>
                                <select asp-for="Area" class="auth-select is-placeholder" id="areaSelect" onchange="updateSelectColor(this);">
                                    <option value="">Choose region/area</option>
                                    <option value="Mirpur">Mirpur</option>
                                    <option value="Uttara">Uttara</option>
                                    <option value="Mohakhali">Mohakhali</option>
                                    <option value="Dhanmondi">Dhanmondi</option>
                                    <option value="Gulshan">Gulshan</option>
                                    <option value="Banani">Banani</option>
                                    <option value="Mohammadpur">Mohammadpur</option>
                                    <option value="Bashundhara">Bashundhara</option>
                                    <option value="Badda">Badda</option>
                                    <option value="Motijheel">Motijheel</option>
                                    <option value="Farmgate">Farmgate</option>
                                    <option value="Old Dhaka">Old Dhaka</option>
                                </select>
                            </div>
                            <span asp-validation-for="Area" class="validation-error-text"></span>
                        </div>
                    </div>

                    <!-- Detailed Street / House Location -->
                    <div class="form-group">
                        <label asp-for="Location" class="form-label">
                            <span class="form-label-title">Detailed Address / Location</span>
                        </label>
                        <div class="input-icon-wrapper">
                            <span class="input-icon">
                                <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                                </svg>
                            </span>
                            <input asp-for="Location" class="auth-input" placeholder="e.g. House 45, Road 12, Block C" />
                        </div>
                        <span asp-validation-for="Location" class="validation-error-text"></span>
                    </div>

                    <!-- Bio -->
                    <div class="form-group">
                        <label asp-for="Bio" class="form-label">
                            <span class="form-label-title">Short Bio</span>
                        </label>
                        <div class="input-icon-wrapper textarea-wrapper">
                            <span class="input-icon">
                                <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                </svg>
                            </span>
                            <textarea asp-for="Bio" class="auth-textarea" rows="2" placeholder="Tell us a little bit about yourself, interests, or background..."></textarea>
                        </div>
                        <span asp-validation-for="Bio" class="validation-error-text"></span>
                    </div>

                    <!-- SECTION 3: ACADEMIC & EDUCATIONAL BACKGROUND -->
                    <div class="form-section-header">
                        <span class="form-section-badge">3</span>
                        <span class="form-section-title">Academic & Educational Background</span>
                        <span class="form-section-subtitle">Qualifications</span>
                    </div>

                    <!-- Education Level & Currently Studying -->
                    <div class="form-row-2col">
                        <!-- Education Level -->
                        <div class="form-group">
                            <label asp-for="EducationLevel" class="form-label">
                                <span class="form-label-title">Highest Education Level</span>
                            </label>
                            <div class="input-icon-wrapper">
                                <span class="input-icon">
                                    <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                                    </svg>
                                </span>
                                <select asp-for="EducationLevel" class="auth-select is-placeholder" onchange="updateSelectColor(this)">
                                    <option value="">Select Education Level</option>
                                    <option value="Secondary (SSC / O-Level)">Secondary (SSC / O-Level)</option>
                                    <option value="Higher Secondary (HSC / A-Level)">Higher Secondary (HSC / A-Level)</option>
                                    <option value="Undergraduate (Bachelor's)">Undergraduate (Bachelor's)</option>
                                    <option value="Postgraduate (Master's)">Postgraduate (Master's)</option>
                                    <option value="Doctorate (PhD)">Doctorate (PhD)</option>
                                    <option value="Diploma / Vocational">Diploma / Vocational</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                            <span asp-validation-for="EducationLevel" class="validation-error-text"></span>
                        </div>

                        <!-- Currently Studying -->
                        <div class="form-group">
                            <label asp-for="CurrentlyStudying" class="form-label">
                                <span class="form-label-title">Currently Enrolled / Studying?</span>
                            </label>
                            <div class="input-icon-wrapper">
                                <span class="input-icon">
                                    <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                                    </svg>
                                </span>
                                <select asp-for="CurrentlyStudying" class="auth-select is-placeholder" onchange="updateSelectColor(this)">
                                    <option value="">Select Status</option>
                                    <option value="Yes - Full Time Student">Yes - Full Time Student</option>
                                    <option value="Yes - Part Time Student">Yes - Part Time Student</option>
                                    <option value="No - Graduated / Employed">No - Graduated / Employed</option>
                                    <option value="No - Other">No - Other</option>
                                </select>
                            </div>
                            <span asp-validation-for="CurrentlyStudying" class="validation-error-text"></span>
                        </div>
                    </div>

                    <!-- Major / Department -->
                    <div class="form-group">
                        <label asp-for="Major" class="form-label">
                            <span class="form-label-title">Major / Department / Field of Study</span>
                        </label>
                        <div class="input-icon-wrapper">
                            <span class="input-icon">
                                <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                                </svg>
                            </span>
                            <input asp-for="Major" class="auth-input" placeholder="e.g. Computer Science, English, Business, Science..." />
                        </div>
                        <span asp-validation-for="Major" class="validation-error-text"></span>
                    </div>

                    <!-- University Name & Passing Year -->
                    <div class="form-row-2col">
                        <div class="form-group">
                            <label asp-for="UniversityName" class="form-label">
                                <span class="form-label-title">University / College</span>
                            </label>
                            <input asp-for="UniversityName" class="auth-input" placeholder="e.g. BUET, DU, NSU..." />
                            <span asp-validation-for="UniversityName" class="validation-error-text"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="UniversityPassingYear" class="form-label">
                                <span class="form-label-title">University Passing / Expected Year</span>
                            </label>
                            <input asp-for="UniversityPassingYear" class="auth-input" placeholder="e.g. 2024" />
                            <span asp-validation-for="UniversityPassingYear" class="validation-error-text"></span>
                        </div>
                    </div>

                    <!-- HSC Institute & Passing Year -->
                    <div class="form-row-2col">
                        <div class="form-group">
                            <label asp-for="HscInstitute" class="form-label">
                                <span class="form-label-title">HSC / College Institute</span>
                            </label>
                            <input asp-for="HscInstitute" class="auth-input" placeholder="e.g. Notre Dame College" />
                            <span asp-validation-for="HscInstitute" class="validation-error-text"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="HscPassingYear" class="form-label">
                                <span class="form-label-title">HSC Passing Year</span>
                            </label>
                            <input asp-for="HscPassingYear" class="auth-input" placeholder="e.g. 2020" />
                            <span asp-validation-for="HscPassingYear" class="validation-error-text"></span>
                        </div>
                    </div>

                    <!-- SSC Institute & Passing Year -->
                    <div class="form-row-2col">
                        <div class="form-group">
                            <label asp-for="SscInstitute" class="form-label">
                                <span class="form-label-title">SSC / School Institute</span>
                            </label>
                            <input asp-for="SscInstitute" class="auth-input" placeholder="e.g. Ideal School and College" />
                            <span asp-validation-for="SscInstitute" class="validation-error-text"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="SscPassingYear" class="form-label">
                                <span class="form-label-title">SSC Passing Year</span>
                            </label>
                            <input asp-for="SscPassingYear" class="auth-input" placeholder="e.g. 2018" />
                            <span asp-validation-for="SscPassingYear" class="validation-error-text"></span>
                        </div>
                    </div>

                    <!-- Certificate / Degree Document Upload -->
                    <div class="form-group">
                        <label asp-for="CertificatePictureFile" class="form-label">
                            <span class="form-label-title">Certificate / Student ID / Document</span>
                        </label>
                        <div class="file-upload-box">
                            <input type="file" asp-for="CertificatePictureFile" class="file-upload-input" id="certFileInput" accept="image/*,.pdf" onchange="updateFileName(this, 'certFileText')" />
                            <div class="file-upload-content">
                                <div class="file-upload-icon">
                                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                    </svg>
                                </div>
                                <div class="file-upload-text">
                                    <div class="file-upload-title" id="certFileText">Upload Certificate / Student ID / Degree Document</div>
                                    <div class="file-upload-desc">Optional verification document (PNG, JPG, PDF up to 10MB)</div>
                                </div>
                            </div>
                        </div>
                        <span asp-validation-for="CertificatePictureFile" class="validation-error-text"></span>
                    </div>

                    <!-- SECTION 4: MOTIVATION & AGREEMENT -->
                    <div class="form-section-header">
                        <span class="form-section-badge">4</span>
                        <span class="form-section-title">Community & Agreement</span>
                        <span class="form-section-subtitle">Motivation</span>
                    </div>

                    <!-- Why do you want to be a volunteer? -->
                    <div class="form-group">
                        <label asp-for="VolunteerReason" class="form-label">
                            <span class="form-label-title">Why do you want to join / volunteer?</span>
                        </label>
                        <div class="input-icon-wrapper textarea-wrapper">
                            <span class="input-icon">
                                <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                                </svg>
                            </span>
                            <textarea asp-for="VolunteerReason" class="auth-textarea" rows="3" placeholder="Share your motivation, skills, or reasons for volunteering and mentoring learners..."></textarea>
                        </div>
                        <span class="helper-text">Tell us about how you'd like to support our community and learners.</span>
                        <span asp-validation-for="VolunteerReason" class="validation-error-text"></span>
                    </div>

                    <!-- Terms and Conditions Checkbox -->
                    <div class="terms-agreement-wrapper">
                        <label class="custom-checkbox-label">
                            <input type="checkbox" asp-for="AgreeToTerms" id="agreeToTerms" />
                            <span>
                                I agree to the <a href="javascript:void(0)" class="terms-link" data-bs-toggle="modal" data-bs-target="#termsModal">Terms and Conditions</a> and acknowledge the <a href="javascript:void(0)" class="terms-link" data-bs-toggle="modal" data-bs-target="#termsModal">Privacy Policy</a> *
                            </span>
                        </label>
                        <span asp-validation-for="AgreeToTerms" class="validation-error-text"></span>
                    </div>

                    <button type="submit" class="btn-submit">
                        <span>Complete Registration</span>
                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                    </button>
                </form>
            </div>

            <!-- Guest Link -->
            <div class="guest-link-wrapper">
                <a asp-controller="Home" asp-action="Index" class="guest-link">
                    <span>Continue as Guest</span>
                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                </a>
            </div>
        </div>

        <div class="fixed-bottom-copyright">
            &copy; @DateTime.Now.Year Onudhabon. All rights reserved.
        </div>
    </div>

    <!-- Terms and Conditions Modal -->
    <div class="modal fade" id="termsModal" tabindex="-1" aria-labelledby="termsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title font-weight-bold" id="termsModalLabel">Terms & Conditions</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <h6>1. Account & Membership</h6>
                    <p>By creating an account on Onudhabon, you agree to provide true, accurate, and current information. Registered users including Educators and Local Guardians must abide by community safety principles.</p>

                    <h6>2. Role Responsibilities</h6>
                    <p><strong>Educators:</strong> Agree to provide legitimate learning guidance, uphold quality teaching, and adhere to academic ethics.<br />
                    <strong>Local Guardians:</strong> Oversee and support the educational activities of dependents under their supervision.</p>

                    <h6>3. Voluntary Contributions</h6>
                    <p>Users who offer voluntary assistance agree to provide mentorship and support with integrity in a non-commercial manner.</p>

                    <h6>4. Privacy & Safeguards</h6>
                    <p>We respect your privacy and protect your personal information in accordance with our data safety standards.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary btn-sm px-4" data-bs-dismiss="modal">I Understand</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script>
        const cityAreasMap = {
            "Dhaka": ["Mirpur", "Uttara", "Mohakhali", "Dhanmondi", "Gulshan", "Banani", "Mohammadpur", "Bashundhara", "Badda", "Motijheel", "Farmgate", "Old Dhaka", "Khilgaon", "Rampura", "Malibagh", "Shahbagh"],
            "Chittagong": ["Agrabad", "GEC Circle", "Nasirabad", "Khulshi", "Halishahar", "Panchlaish", "Kotwali", "Muradpur", "Chawkbazar", "Bahaddarhat"],
            "Sylhet": ["Zindabazar", "Amberkhana", "Subidbazar", "Upashahar", "Shibgonj", "Lamabazar", "Tilagarh", "Kumarpara", "Bandarbazar"],
            "Barisal": ["Sadar Road", "Natun Bazar", "Rupatali", "C&B Road", "Band Road", "Kashipur", "Amanatganj", "Chawkbazar", "Nobogram Road"],
            "Khulna": ["Boyra", "Sonadanga", "Khalishpur", "Daulatpur", "Shibbari", "Nirala", "Mujgunni", "Rupsha"],
            "Rajshahi": ["Motihar", "Boalia", "Kazihata", "Shaheb Bazar", "Upashahar", "Laxmipur", "Shirothoil", "Padma Residential"],
            "Rangpur": ["Jahaj Company Mor", "Modern Mor", "Dhap", "Medical Mor", "Lalbagh", "Kachari Bazar", "Rk Road"],
            "Mymensingh": ["Ganginar Par", "Charpara", "Town Hall", "Maskanda", "Kewatkhali", "Akua", "Boundary Road"],
            "Comilla": ["Kandirpar", "Badurtala", "Jhawtola", "Tomchom Bridge", "Shasongachha", "Police Line", "Paduar Bazar"],
            "Gazipur": ["Joydebpur", "Chowrasta", "Tongi", "Board Bazar", "Konabari", "Salna", "Chandana"],
            "Narayanganj": ["Chashara", "Tanbazar", "Fatullah", "Siddhirganj", "Kadam Rasul", "Bandar", "Madanpur"]
        };

        function togglePasswordVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            if (input.type === 'password') {
                input.type = 'text';
                btn.innerHTML = `
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                    </svg>`;
            } else {
                input.type = 'password';
                btn.innerHTML = `
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>`;
            }
        }

        function updateSelectColor(select) {
            if (!select) return;
            if (!select.value) {
                select.classList.add('is-placeholder');
                select.style.color = '#94a3b8';
            } else {
                select.classList.remove('is-placeholder');
                select.style.color = '#1e293b';
            }
        }

        function onCityChanged(selectedCity) {
            const areaSelect = document.getElementById('areaSelect');
            if (!areaSelect) return;

            const previousArea = areaSelect.value;
            areaSelect.innerHTML = '<option value="">Choose region/area</option>';

            let areas = [];
            if (selectedCity && cityAreasMap[selectedCity]) {
                areas = cityAreasMap[selectedCity];
            } else {
                areas = ["Mirpur", "Uttara", "Mohakhali", "Dhanmondi", "Gulshan", "Banani", "Mohammadpur", "Bashundhara", "Badda", "Motijheel", "Farmgate", "Old Dhaka"];
            }

            areas.forEach(function (area) {
                const opt = document.createElement('option');
                opt.value = area;
                opt.textContent = area;
                if (area === previousArea) {
                    opt.selected = true;
                }
                areaSelect.appendChild(opt);
            });

            updateSelectColor(areaSelect);
        }

        function previewImage(input, previewId, textId) {
            if (input.files && input.files[0]) {
                const file = input.files[0];
                const reader = new FileReader();
                reader.onload = function (e) {
                    const preview = document.getElementById(previewId);
                    if (preview) {
                        preview.src = e.target.result;
                        preview.style.display = 'block';
                    }
                };
                reader.readAsDataURL(file);

                const textElem = document.getElementById(textId);
                if (textElem) {
                    textElem.textContent = file.name;
                }
            }
        }

        function updateFileName(input, textId) {
            if (input.files && input.files[0]) {
                const textElem = document.getElementById(textId);
                if (textElem) {
                    textElem.textContent = input.files[0].name;
                }
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('select.auth-select').forEach(function (select) {
                updateSelectColor(select);
            });

            const citySelect = document.getElementById('citySelect');
            const initialArea = '@(Model?.Area ?? "")';
            if (citySelect) {
                if (citySelect.value) {
                    onCityChanged(citySelect.value);
                    const areaSelect = document.getElementById('areaSelect');
                    if (areaSelect && initialArea) {
                        areaSelect.value = initialArea;
                    }
                }
            }
        });

        // Prevent back-button from restoring register page from browser cache (BFCache)
        window.addEventListener('pageshow', function (event) {
            if (event.persisted || (window.performance && window.performance.getEntriesByType("navigation")[0]?.type === "back_forward")) {
                window.location.reload();
            }
        });

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <text>
            // If restored from browser memory cache while authenticated, immediately forward
            var userRole = '@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "")';
            if (userRole === 'Admin') {
                window.location.replace('/Admin/Dashboard');
            } else if (userRole === 'Local Guardian') {
                window.location.replace('/Student/Index');
            } else if (userRole === 'Educator') {
                window.location.replace('/Lecture/Index');
            } else {
                window.location.replace('/Home/Index');
            }
            </text>
        }
    </script>
</body>
</html>
