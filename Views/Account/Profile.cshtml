@model Onudhabon.Models.User
@inject Onudhabon.Services.ICloudinaryService CloudinaryService

@{
    ViewData["Title"] = $"{Model.FullName} - Institutional Profile";
}

<div class="container py-5">
    <!-- Status & Feedback Alerts -->
    <div id="profileAlertContainer">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4 d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                <div class="flex-grow-1">@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4 d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                <div class="flex-grow-1">@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <div class="row g-4">
        <!-- Left Sidebar: Formal Profile Identity Card -->
        <div class="col-lg-4">
            <div class="profile-sidebar-card">
                <!-- Top Brand Banner -->
                <div class="profile-sidebar-banner"></div>

                <!-- Avatar and Summary Header -->
                <div class="p-4 pt-0 text-center">
                    <div class="profile-avatar-wrapper mb-3" id="profileAvatarContainer">
                        @if (!string.IsNullOrWhiteSpace(Model.Picture))
                        {
                            <img src="@Model.Picture" 
                                 alt="@Model.FullName" 
                                 class="profile-avatar-img" 
                                 id="profileAvatarImg" />
                        }
                        else
                        {
                            <div class="profile-avatar-fallback mx-auto" id="profileAvatarFallback">
                                @(string.IsNullOrEmpty(Model.FullName) ? "U" : Model.FullName.Substring(0, 1).ToUpper())
                            </div>
                        }

                        <!-- Interactive Camera Overlay & Badge to Upload Photo -->
                        <div class="profile-avatar-overlay" data-bs-toggle="modal" data-bs-target="#updatePictureModal" role="button" title="Update Profile Picture">
                            <i class="bi bi-camera-fill"></i>
                            <span>Change</span>
                        </div>
                        <button type="button" 
                                class="profile-avatar-edit-badge" 
                                data-bs-toggle="modal" 
                                data-bs-target="#updatePictureModal" 
                                title="Update Profile Picture"
                                aria-label="Update Profile Picture">
                            <i class="bi bi-camera-fill"></i>
                        </button>
                    </div>

                    <h4 class="fw-bold text-dark mb-1">@Model.FullName</h4>
                    <p class="text-muted small mb-3">
                        <a href="mailto:@Model.Email" class="text-decoration-none text-muted">@Model.Email</a>
                    </p>

                    <!-- Institutional Badges -->
                    <div class="d-flex justify-content-center gap-2 mb-4 flex-wrap">
                        @if (Model.Role == "Educator")
                        {
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1.5 rounded-pill fw-semibold">
                                <i class="bi bi-mortarboard-fill me-1"></i> Educator
                            </span>
                        }
                        else if (Model.Role == "Local Guardian")
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1.5 rounded-pill fw-semibold">
                                <i class="bi bi-shield-check me-1"></i> Local Guardian
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary px-3 py-1.5 rounded-pill fw-semibold">
                                <i class="bi bi-person-badge me-1"></i> @Model.Role
                            </span>
                        }

                        @if (Model.VerificationStatus?.ToLower() == "verified")
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1.5 rounded-pill fw-semibold">
                                <i class="bi bi-patch-check-fill me-1"></i> Verified
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-1.5 rounded-pill fw-semibold text-dark">
                                <i class="bi bi-clock-history me-1"></i> @(Model.VerificationStatus ?? "Pending Review")
                            </span>
                        }
                    </div>

                    <!-- Meta Information Table -->
                    <div class="border-top pt-3 text-start">
                        <div class="profile-meta-row">
                            <span class="text-muted"><i class="bi bi-hash text-primary me-1"></i> User ID:</span>
                            <span class="fw-bold text-dark font-monospace">#@Model.Id</span>
                        </div>
                        <div class="profile-meta-row">
                            <span class="text-muted"><i class="bi bi-calendar-event text-primary me-1"></i> Member Since:</span>
                            <span class="fw-semibold text-dark">@Model.CreatedAt.ToString("MMMM dd, yyyy")</span>
                        </div>
                        <div class="profile-meta-row">
                            <span class="text-muted"><i class="bi bi-person-badge text-primary me-1"></i> Age:</span>
                            <span class="fw-semibold text-dark">@(Model.Age.HasValue ? $"{Model.Age} years" : "—")</span>
                        </div>
                    </div>

                    @if (Model.Role == "Educator")
                    {
                        <div class="border-top pt-3 mt-3 d-grid gap-2">
                            <a asp-controller="Lecture" asp-action="Upload" class="btn btn-primary btn-sm rounded-pill py-2 d-inline-flex align-items-center justify-content-center gap-1.5" style="background: linear-gradient(135deg, #1e3a8a 0%, #1d4ed8 100%); border: none;">
                                <i class="bi bi-camera-video"></i>
                                <span>Upload Lecture Video</span>
                            </a>
                            <a asp-controller="Material" asp-action="Upload" class="btn btn-outline-primary btn-sm rounded-pill py-2 d-inline-flex align-items-center justify-content-center gap-1.5">
                                <i class="bi bi-file-earmark-text"></i>
                                <span>Upload Study Material</span>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Main Column: Structured Information Cards -->
        <div class="col-lg-8">
            <!-- 1. Personal & Contact Information -->
            <div class="profile-section-card">
                <div class="profile-section-header">
                    <h5 class="profile-section-title">
                        <i class="bi bi-person-lines-fill text-primary"></i>
                        <span>Personal & Contact Information</span>
                    </h5>
                    <span class="badge bg-light text-secondary border rounded-pill px-3 py-1 font-monospace small">Verified Record</span>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="profile-data-tile">
                            <div class="profile-data-label">
                                <i class="bi bi-envelope"></i> Email Address
                            </div>
                            <div class="profile-data-value">@Model.Email</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="profile-data-tile">
                            <div class="profile-data-label">
                                <i class="bi bi-telephone"></i> Phone Number
                            </div>
                            <div class="profile-data-value font-monospace">@Model.PhoneNumber</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="profile-data-tile">
                            <div class="profile-data-label">
                                <i class="bi bi-geo-alt"></i> City
                            </div>
                            <div class="profile-data-value">@(string.IsNullOrWhiteSpace(Model.City) ? "—" : Model.City)</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="profile-data-tile">
                            <div class="profile-data-label">
                                <i class="bi bi-map"></i> Region / Area
                            </div>
                            <div class="profile-data-value">@(string.IsNullOrWhiteSpace(Model.Area) ? "—" : Model.Area)</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="profile-data-tile">
                            <div class="profile-data-label">
                                <i class="bi bi-house-door"></i> Detailed Address
                            </div>
                            <div class="profile-data-value">@(string.IsNullOrWhiteSpace(Model.Location) ? "—" : Model.Location)</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="profile-data-tile">
                            <div class="profile-data-label">
                                <i class="bi bi-card-text"></i> NID / Identification Number
                            </div>
                            <div class="profile-data-value font-monospace">@(string.IsNullOrWhiteSpace(Model.NidNumber) ? "—" : Model.NidNumber)</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. Academic & Educational Background -->
            <div class="profile-section-card">
                <div class="profile-section-header">
                    <h5 class="profile-section-title">
                        <i class="bi bi-mortarboard-fill text-primary"></i>
                        <span>Academic Qualifications & Background</span>
                    </h5>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 small">Accredited</span>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="profile-data-tile">
                            <div class="profile-data-label">
                                <i class="bi bi-award"></i> Highest Education Level
                            </div>
                            <div class="profile-data-value">@(string.IsNullOrWhiteSpace(Model.EducationLevel) ? "—" : Model.EducationLevel)</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="profile-data-tile">
                            <div class="profile-data-label">
                                <i class="bi bi-book"></i> Current Enrollment Status
                            </div>
                            <div class="profile-data-value">@(string.IsNullOrWhiteSpace(Model.CurrentlyStudying) ? "—" : Model.CurrentlyStudying)</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="profile-data-tile">
                            <div class="profile-data-label">
                                <i class="bi bi-journal-code"></i> Major / Department
                            </div>
                            <div class="profile-data-value">@(string.IsNullOrWhiteSpace(Model.Major) ? "—" : Model.Major)</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="profile-data-tile">
                            <div class="profile-data-label">
                                <i class="bi bi-building"></i> University / College
                            </div>
                            <div class="profile-data-value">
                                @(string.IsNullOrWhiteSpace(Model.UniversityName) ? "—" : Model.UniversityName)
                                @if (!string.IsNullOrWhiteSpace(Model.UniversityPassingYear))
                                {
                                    <span class="badge bg-light text-dark border font-monospace ms-1 small">Batch: @Model.UniversityPassingYear</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="profile-data-tile">
                            <div class="profile-data-label">
                                <i class="bi bi-bank"></i> HSC / College Institute
                            </div>
                            <div class="profile-data-value">
                                @(string.IsNullOrWhiteSpace(Model.HscInstitute) ? "—" : Model.HscInstitute)
                                @if (!string.IsNullOrWhiteSpace(Model.HscPassingYear))
                                {
                                    <span class="badge bg-light text-dark border font-monospace ms-1 small">@Model.HscPassingYear</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="profile-data-tile">
                            <div class="profile-data-label">
                                <i class="bi bi-building-check"></i> SSC / School Institute
                            </div>
                            <div class="profile-data-value">
                                @(string.IsNullOrWhiteSpace(Model.SscInstitute) ? "—" : Model.SscInstitute)
                                @if (!string.IsNullOrWhiteSpace(Model.SscPassingYear))
                                {
                                    <span class="badge bg-light text-dark border font-monospace ms-1 small">@Model.SscPassingYear</span>
                                }
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.CertificatePicture))
                    {
                        <div class="col-12 mt-2">
                            <div class="profile-credential-box">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-3 bg-white p-2.5 shadow-sm border text-primary d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; font-size: 1.3rem;">
                                        <i class="bi bi-file-earmark-check-fill text-primary"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark small">Verified Educational Credential / Certificate</div>
                                        <div class="text-muted small" style="font-size: 0.76rem;">Document securely verified and stored</div>
                                    </div>
                                </div>
                                <a href="@Model.CertificatePicture" target="_blank" class="btn btn-primary btn-sm rounded-pill px-3 py-1.5 d-inline-flex align-items-center gap-1.5" style="background: linear-gradient(135deg, #1e3a8a 0%, #1d4ed8 100%); border: none;">
                                    <i class="bi bi-box-arrow-up-right"></i>
                                    <span>View Credential</span>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- 3. Bio & Statement Card -->
            @if (!string.IsNullOrWhiteSpace(Model.Bio) || !string.IsNullOrWhiteSpace(Model.VolunteerReason))
            {
                <div class="profile-section-card">
                    <div class="profile-section-header">
                        <h5 class="profile-section-title">
                            <i class="bi bi-chat-left-quote-fill text-primary"></i>
                            <span>Statement & Community Motivation</span>
                        </h5>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Bio))
                    {
                        <div class="mb-3">
                            <div class="profile-data-label mb-2">
                                <i class="bi bi-person-lines-fill"></i> Personal Bio / Introduction
                            </div>
                            <div class="profile-statement-box">
                                @Model.Bio
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.VolunteerReason))
                    {
                        <div>
                            <div class="profile-data-label mb-2">
                                <i class="bi bi-heart-pulse"></i> Volunteer Motivation & Objective
                            </div>
                            <div class="profile-statement-box">
                                @Model.VolunteerReason
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal: Update Profile Picture -->
<div class="modal fade" id="updatePictureModal" tabindex="-1" aria-labelledby="updatePictureModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
            <div class="modal-header bg-light border-bottom px-4 py-3">
                <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2" id="updatePictureModalLabel">
                    <i class="bi bi-camera-fill text-primary"></i>
                    <span>Update Profile Picture</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="updateProfilePicForm" asp-controller="Account" asp-action="UpdateProfilePicture" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <!-- Dynamic Alert Inside Modal -->
                    <div id="modalAlert" class="alert alert-danger rounded-3 d-none mb-3 small" role="alert"></div>

                    <!-- Hidden File Input -->
                    <input type="file" 
                           id="profilePictureInput" 
                           name="profilePicture" 
                           accept="image/png,image/jpeg,image/jpg,image/webp,image/gif" 
                           class="d-none" />

                    <!-- Drag & Drop / Click Upload Box (Omitted once picture is selected) -->
                    <div class="profile-pic-dropzone mb-3" id="profileDropzone">
                        <div class="mb-2">
                            <i class="bi bi-cloud-arrow-up-fill text-primary fs-1"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">Click to browse or drag & drop photo here</h6>
                        <p class="text-muted small mb-0">Supported formats: JPG, PNG, WEBP, GIF (Max 5 MB)</p>
                    </div>

                    <!-- Live Image Preview Container (Shown only after a picture is selected) -->
                    <div id="previewContainer" class="text-center p-3 rounded-4 bg-light border d-none mb-3">
                        <div class="small fw-semibold text-muted mb-2">Selected Photo Preview (Original Size):</div>
                        <div class="p-2 bg-white rounded-3 border d-inline-block shadow-sm mb-2" style="max-width: 100%;">
                            <img id="imagePreview" src="#" alt="Preview" class="profile-pic-preview-img" />
                        </div>
                        <div class="d-flex align-items-center justify-content-center gap-2 mt-2 flex-wrap">
                            <span id="selectedFileName" class="badge bg-secondary-subtle text-secondary border font-monospace small text-truncate" style="max-width: 180px;"></span>
                            <span id="selectedFileSize" class="badge bg-light text-dark border small"></span>
                            <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 py-1 text-decoration-none small fw-semibold" id="btnChangePhoto">
                                <i class="bi bi-arrow-repeat me-1"></i> Change Photo
                            </button>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Picture))
                    {
                        <div class="d-flex align-items-center justify-content-between p-2.5 rounded-3 bg-light border small text-muted mt-2" id="currentPhotoInfoBox">
                            <span><i class="bi bi-image me-1 text-primary"></i> Current Photo</span>
                            <a href="@Model.Picture" target="_blank" class="text-primary text-decoration-none fw-semibold d-inline-flex align-items-center gap-1">
                                <span>View original full size</span>
                                <i class="bi bi-box-arrow-up-right small"></i>
                            </a>
                        </div>
                    }
                </div>
                <div class="modal-footer bg-light border-top px-4 py-3 d-flex justify-content-between">
                    <div>
                        @if (!string.IsNullOrWhiteSpace(Model.Picture))
                        {
                            <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1.5 d-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#removePictureModal" id="modalRemoveBtn">
                                <i class="bi bi-trash"></i>
                                <span>Remove Photo</span>
                            </button>
                        }
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 d-inline-flex align-items-center gap-2" id="btnSubmitPicture" disabled>
                            <span class="spinner-border spinner-border-sm d-none" id="uploadSpinner" role="status" aria-hidden="true"></span>
                            <i class="bi bi-check-lg" id="btnSubmitIcon"></i>
                            <span id="btnSubmitText">Save & Upload</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Remove Profile Picture Confirmation -->
<div class="modal fade" id="removePictureModal" tabindex="-1" aria-labelledby="removePictureModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
            <div class="modal-header bg-danger-subtle border-bottom border-danger-subtle px-4 py-3">
                <h5 class="modal-title fw-bold text-danger d-flex align-items-center gap-2" id="removePictureModalLabel">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span>Remove Photo</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="removeProfilePicForm" asp-controller="Account" asp-action="RemoveProfilePicture" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4 text-center">
                    <p class="text-secondary mb-0">Are you sure you want to remove your profile picture? Your profile will revert to your default initial avatar.</p>
                </div>
                <div class="modal-footer bg-light border-top px-4 py-3 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-3 d-inline-flex align-items-center gap-1.5" id="btnConfirmRemovePic">
                        <span class="spinner-border spinner-border-sm d-none" id="removeSpinner" role="status" aria-hidden="true"></span>
                        <i class="bi bi-trash" id="btnRemoveIcon"></i>
                        <span id="btnRemoveText">Remove</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const dropzone = document.getElementById('profileDropzone');
            const fileInput = document.getElementById('profilePictureInput');
            const previewContainer = document.getElementById('previewContainer');
            const imagePreview = document.getElementById('imagePreview');
            const selectedFileName = document.getElementById('selectedFileName');
            const selectedFileSize = document.getElementById('selectedFileSize');
            const btnChangePhoto = document.getElementById('btnChangePhoto');
            const btnSubmitPicture = document.getElementById('btnSubmitPicture');
            const btnSubmitText = document.getElementById('btnSubmitText');
            const btnSubmitIcon = document.getElementById('btnSubmitIcon');
            const uploadSpinner = document.getElementById('uploadSpinner');
            const modalAlert = document.getElementById('modalAlert');
            const updateForm = document.getElementById('updateProfilePicForm');
            const updateModalEl = document.getElementById('updatePictureModal');

            const maxFileSize = 5 * 1024 * 1024; // 5 MB
            const allowedTypes = ['image/jpeg', 'image/png', 'image/webp', 'image/gif'];
            const allowedExtensions = ['.jpg', '.jpeg', '.png', '.webp', '.gif'];

            function showModalError(msg) {
                modalAlert.textContent = msg;
                modalAlert.classList.remove('d-none');
            }

            function clearModalError() {
                modalAlert.textContent = '';
                modalAlert.classList.add('d-none');
            }

            function formatBytes(bytes) {
                if (bytes < 1024) return bytes + ' B';
                if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
                return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
            }

            function validateFile(file) {
                clearModalError();
                if (!file) return false;

                const fileName = file.name.toLowerCase();
                const hasValidExt = allowedExtensions.some(ext => fileName.endsWith(ext));
                const hasValidType = allowedTypes.includes(file.type) || file.type.startsWith('image/');

                if (!hasValidExt || !hasValidType) {
                    showModalError('Invalid file format. Please choose a JPG, PNG, WEBP, or GIF image.');
                    return false;
                }

                if (file.size > maxFileSize) {
                    showModalError('File size (' + formatBytes(file.size) + ') exceeds the 5 MB limit.');
                    return false;
                }

                return true;
            }

            function handleFile(file) {
                if (!validateFile(file)) {
                    fileInput.value = '';
                    dropzone.classList.remove('d-none');
                    previewContainer.classList.add('d-none');
                    btnSubmitPicture.disabled = true;
                    return;
                }

                const reader = new FileReader();
                reader.onload = function (e) {
                    imagePreview.src = e.target.result;
                    selectedFileName.textContent = file.name;
                    selectedFileSize.textContent = formatBytes(file.size);

                    // Omit the redundant drag & upload box after picture selection
                    dropzone.classList.add('d-none');
                    previewContainer.classList.remove('d-none');
                    btnSubmitPicture.disabled = false;
                };
                reader.readAsDataURL(file);
            }

            if (dropzone) {
                dropzone.addEventListener('click', () => fileInput.click());

                dropzone.addEventListener('dragover', (e) => {
                    e.preventDefault();
                    dropzone.classList.add('drag-over');
                });

                ['dragleave', 'dragend'].forEach(type => {
                    dropzone.addEventListener(type, () => dropzone.classList.remove('drag-over'));
                });

                dropzone.addEventListener('drop', (e) => {
                    e.preventDefault();
                    dropzone.classList.remove('drag-over');
                    if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
                        fileInput.files = e.dataTransfer.files;
                        handleFile(e.dataTransfer.files[0]);
                    }
                });
            }

            if (fileInput) {
                fileInput.addEventListener('change', function () {
                    if (this.files && this.files.length > 0) {
                        handleFile(this.files[0]);
                    }
                });
            }

            if (btnChangePhoto) {
                btnChangePhoto.addEventListener('click', () => fileInput.click());
            }

            // Reset modal state when closed
            if (updateModalEl) {
                updateModalEl.addEventListener('hidden.bs.modal', function () {
                    clearModalError();
                    fileInput.value = '';
                    dropzone.classList.remove('d-none');
                    previewContainer.classList.add('d-none');
                    btnSubmitPicture.disabled = true;
                    uploadSpinner.classList.add('d-none');
                    btnSubmitIcon.classList.remove('d-none');
                    btnSubmitText.textContent = 'Save & Upload';
                });
            }

            function showFlashAlert(message, type = 'success') {
                const container = document.getElementById('profileAlertContainer');
                if (!container) return;

                const icon = type === 'success' ? 'bi-check-circle-fill text-success' : 'bi-exclamation-triangle-fill text-danger';
                const alertHtml = `
                    <div class="alert alert-${type} alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4 d-flex align-items-center gap-2" role="alert">
                        <i class="bi ${icon} fs-5"></i>
                        <div class="flex-grow-1">${message}</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>`;
                container.innerHTML = alertHtml;
                container.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }

            // AJAX Form Submit for Profile Picture Upload
            if (updateForm) {
                updateForm.addEventListener('submit', async function (e) {
                    e.preventDefault();

                    const file = fileInput.files && fileInput.files[0];
                    if (!validateFile(file)) {
                        return;
                    }

                    // Set button to loading state
                    btnSubmitPicture.disabled = true;
                    uploadSpinner.classList.remove('d-none');
                    btnSubmitIcon.classList.add('d-none');
                    btnSubmitText.textContent = 'Uploading...';
                    clearModalError();

                    const formData = new FormData(updateForm);

                    try {
                        const response = await fetch(updateForm.action, {
                            method: 'POST',
                            body: formData,
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });

                        const result = await response.json();

                        if (result.success) {
                            const newUrl = result.pictureUrl || result.rawUrl;
                            const container = document.getElementById('profileAvatarContainer');

                            // Update profile avatar image or replace fallback initial
                            let avatarImg = document.getElementById('profileAvatarImg');
                            const fallback = document.getElementById('profileAvatarFallback');

                            if (avatarImg) {
                                avatarImg.src = newUrl + (newUrl.includes('?') ? '&' : '?') + 't=' + new Date().getTime();
                            } else if (fallback && container) {
                                avatarImg = document.createElement('img');
                                avatarImg.id = 'profileAvatarImg';
                                avatarImg.className = 'profile-avatar-img';
                                avatarImg.alt = '@Model.FullName';
                                avatarImg.src = newUrl;
                                container.replaceChild(avatarImg, fallback);
                            }

                            // Update navbar avatar if present
                            const navbarContainer = document.getElementById('navbarAvatarContainer');
                            if (navbarContainer) {
                                navbarContainer.innerHTML = `<img src="${newUrl}" alt="@Model.FullName" class="rounded-circle border border-2 border-white" style="width: 32px; height: 32px; object-fit: cover;" />`;
                            }

                            // Close modal
                            const modalInstance = bootstrap.Modal.getInstance(updateModalEl);
                            if (modalInstance) {
                                modalInstance.hide();
                            }

                            showFlashAlert(result.message || 'Profile picture updated successfully!', 'success');
                        } else {
                            showModalError(result.message || 'Failed to upload profile picture. Please try again.');
                            btnSubmitPicture.disabled = false;
                            uploadSpinner.classList.add('d-none');
                            btnSubmitIcon.classList.remove('d-none');
                            btnSubmitText.textContent = 'Save & Upload';
                        }
                    } catch (err) {
                        console.error('Upload error:', err);
                        updateForm.submit();
                    }
                });
            }

            // AJAX Form Submit for Remove Profile Picture
            const removeForm = document.getElementById('removeProfilePicForm');
            const removeModalEl = document.getElementById('removePictureModal');
            const btnConfirmRemove = document.getElementById('btnConfirmRemovePic');
            const removeSpinner = document.getElementById('removeSpinner');
            const btnRemoveIcon = document.getElementById('btnRemoveIcon');
            const btnRemoveText = document.getElementById('btnRemoveText');

            if (removeForm) {
                removeForm.addEventListener('submit', async function (e) {
                    e.preventDefault();

                    btnConfirmRemove.disabled = true;
                    removeSpinner.classList.remove('d-none');
                    btnRemoveIcon.classList.add('d-none');
                    btnRemoveText.textContent = 'Removing...';

                    const formData = new FormData(removeForm);

                    try {
                        const response = await fetch(removeForm.action, {
                            method: 'POST',
                            body: formData,
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });

                        const result = await response.json();

                        if (result.success) {
                            const fallbackInitial = result.fallbackInitial || '@(string.IsNullOrEmpty(Model.FullName) ? "U" : Model.FullName.Substring(0, 1).ToUpper())';
                            const container = document.getElementById('profileAvatarContainer');
                            const avatarImg = document.getElementById('profileAvatarImg');

                            if (avatarImg && container) {
                                const fallbackDiv = document.createElement('div');
                                fallbackDiv.id = 'profileAvatarFallback';
                                fallbackDiv.className = 'profile-avatar-fallback mx-auto';
                                fallbackDiv.textContent = fallbackInitial;
                                container.replaceChild(fallbackDiv, avatarImg);
                            }

                            // Update navbar avatar to initial
                            const navbarContainer = document.getElementById('navbarAvatarContainer');
                            if (navbarContainer) {
                                navbarContainer.innerHTML = `<div class="rounded-circle bg-white text-primary fw-bold d-flex align-items-center justify-content-center shadow-sm" style="width: 32px; height: 32px; font-size: 0.85rem;">${fallbackInitial}</div>`;
                            }

                            // Close modal
                            const modalInstance = bootstrap.Modal.getInstance(removeModalEl);
                            if (modalInstance) {
                                modalInstance.hide();
                            }

                            showFlashAlert(result.message || 'Profile picture removed successfully.', 'success');
                        } else {
                            alert(result.message || 'Failed to remove profile picture.');
                        }
                    } catch (err) {
                        console.error('Remove picture error:', err);
                        removeForm.submit();
                    } finally {
                        btnConfirmRemove.disabled = false;
                        removeSpinner.classList.add('d-none');
                        btnRemoveIcon.classList.remove('d-none');
                        btnRemoveText.textContent = 'Remove';
                    }
                });
            }
        });
    </script>
}
