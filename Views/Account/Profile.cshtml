@model Onudhabon_ISD.Models.User
@inject Onudhabon_ISD.Services.ICloudinaryService CloudinaryService

@{
    ViewData["Title"] = $"{Model.FullName} - User Profile";
}

<div class="container py-5">
    <div class="row g-4">
        <!-- Left Sidebar: Profile Card -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4">
                <div class="position-relative d-inline-block mx-auto mb-3">
                    @if (!string.IsNullOrWhiteSpace(Model.Picture))
                    {
                        <img src="@CloudinaryService.GetAvatarUrl(Model.Picture, 180)" 
                             alt="@Model.FullName" 
                             class="rounded-circle shadow-sm border border-3 border-primary" 
                             style="width: 130px; height: 130px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center mx-auto shadow-sm" 
                             style="width: 130px; height: 130px; font-size: 2.8rem; border: 3px solid var(--bs-primary);">
                            @(string.IsNullOrEmpty(Model.FullName) ? "U" : Model.FullName.Substring(0, 1).ToUpper())
                        </div>
                    }
                </div>

                <h4 class="fw-bold text-dark mb-1">@Model.FullName</h4>
                <p class="text-muted small mb-2"><a href="mailto:@Model.Email" class="text-decoration-none text-muted">@Model.Email</a></p>

                <div class="d-flex justify-content-center gap-2 mb-3 flex-wrap">
                    @if (Model.Role == "Educator")
                    {
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1.5 rounded-pill fs-6">
                            Educator
                        </span>
                    }
                    else if (Model.Role == "Local Guardian")
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1.5 rounded-pill fs-6">
                            Local Guardian
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-secondary px-3 py-1.5 rounded-pill fs-6">
                            @Model.Role
                        </span>
                    }

                    <span class="badge @(Model.VerificationStatus?.ToLower() == "verified" ? "bg-success" : "bg-warning text-dark") px-2.5 py-1.5 rounded-pill">
                        @(Model.VerificationStatus ?? "Pending")
                    </span>
                </div>

                <div class="border-top pt-3 text-start small">
                    <div class="d-flex justify-content-between py-1.5 border-bottom">
                        <span class="text-muted">User ID:</span>
                        <span class="fw-semibold">#@Model.Id</span>
                    </div>
                    <div class="d-flex justify-content-between py-1.5 border-bottom">
                        <span class="text-muted">Member Since:</span>
                        <span class="fw-semibold">@Model.CreatedAt.ToString("MMM dd, yyyy")</span>
                    </div>
                    <div class="d-flex justify-content-between py-1.5">
                        <span class="text-muted">Age:</span>
                        <span class="fw-semibold">@(Model.Age.HasValue ? $"{Model.Age} years" : "—")</span>
                    </div>
                </div>

                @if (Model.Role == "Educator")
                {
                    <div class="border-top pt-3 mt-2 d-grid gap-2">
                        <a asp-controller="Lecture" asp-action="Upload" class="btn btn-primary btn-sm rounded-pill py-2">
                            + Upload Lecture Video
                        </a>
                        <a asp-controller="Material" asp-action="Upload" class="btn btn-outline-primary btn-sm rounded-pill py-2">
                            + Upload Study Material
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- Right Main Column: Full Details -->
        <div class="col-lg-8">
            <!-- Contact & Location Card -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">Personal & Contact Information</h5>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="text-muted small">Email Address</div>
                        <div class="fw-semibold text-dark">@Model.Email</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Phone Number</div>
                        <div class="fw-semibold font-monospace text-dark">@Model.PhoneNumber</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">City</div>
                        <div class="fw-semibold text-dark">@Model.City</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Region / Area</div>
                        <div class="fw-semibold text-dark">@Model.Area</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Detailed Address</div>
                        <div class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(Model.Location) ? "—" : Model.Location)</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">NID / Identification Number</div>
                        <div class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(Model.NidNumber) ? "—" : Model.NidNumber)</div>
                    </div>
                </div>
            </div>

            <!-- Academic & Educational Background Card -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">Academic & Educational Qualifications</h5>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="text-muted small">Highest Education Level</div>
                        <div class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(Model.EducationLevel) ? "—" : Model.EducationLevel)</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Currently Enrolled / Studying</div>
                        <div class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(Model.CurrentlyStudying) ? "—" : Model.CurrentlyStudying)</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Major / Department</div>
                        <div class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(Model.Major) ? "—" : Model.Major)</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">University / College</div>
                        <div class="fw-semibold text-dark">
                            @(string.IsNullOrWhiteSpace(Model.UniversityName) ? "—" : Model.UniversityName)
                            @(!string.IsNullOrWhiteSpace(Model.UniversityPassingYear) ? $" (Batch: {Model.UniversityPassingYear})" : "")
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">HSC / College Institute</div>
                        <div class="fw-semibold text-dark">
                            @(string.IsNullOrWhiteSpace(Model.HscInstitute) ? "—" : Model.HscInstitute)
                            @(!string.IsNullOrWhiteSpace(Model.HscPassingYear) ? $" ({Model.HscPassingYear})" : "")
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">SSC / School Institute</div>
                        <div class="fw-semibold text-dark">
                            @(string.IsNullOrWhiteSpace(Model.SscInstitute) ? "—" : Model.SscInstitute)
                            @(!string.IsNullOrWhiteSpace(Model.SscPassingYear) ? $" ({Model.SscPassingYear})" : "")
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.CertificatePicture))
                    {
                        <div class="col-12 border-top pt-2">
                            <div class="text-muted small mb-1">Attached Certificate / Education Document:</div>
                            <div class="d-flex align-items-center gap-2">
                                <a href="@Model.CertificatePicture" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                    📄 View Document on Cloudinary
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Bio & Community Card -->
            @if (!string.IsNullOrWhiteSpace(Model.Bio) || !string.IsNullOrWhiteSpace(Model.VolunteerReason))
            {
                <div class="card border-0 shadow-sm rounded-4 p-4">
                    <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">About & Volunteer Motivation</h5>
                    @if (!string.IsNullOrWhiteSpace(Model.Bio))
                    {
                        <div class="mb-3">
                            <div class="text-muted small">Bio</div>
                            <p class="mb-0 text-dark">@Model.Bio</p>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.VolunteerReason))
                    {
                        <div>
                            <div class="text-muted small">Motivation for Joining / Volunteering</div>
                            <p class="mb-0 text-dark">@Model.VolunteerReason</p>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
