@model Onudhabon.Models.LoginViewModel
@{
    // Standalone markup without shared layout header/footer
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Onudhabon</title>
    <!-- Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Dedicated Login Stylesheet -->
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body class="login-page">

    <div class="auth-wrapper">
        <!-- Main Authentication Card -->
        <main class="auth-card" role="main">
            <div class="auth-card-body">
                
                <!-- Brand Header with Logo Asset -->
                <header class="auth-header">
                    <div class="auth-logo-wrapper">
                        <img src="~/images/login_logo.png" 
                             alt="Onudhabon Logo" 
                             class="auth-logo" 
                             asp-append-version="true" />
                    </div>
                    <h1 class="auth-title">Onudhabon</h1>
                    <h2 class="auth-subtitle">Exploring Education</h2>
                    <p class="auth-tagline">Join our mission to explore education</p>
                </header>

                <!-- Floating Tab Switcher -->
                <nav class="auth-tabs" role="tablist" aria-label="Authentication switch">
                    <a asp-action="Login" asp-controller="Account" class="auth-tab active" role="tab" aria-selected="true">Login</a>
                    <a asp-action="Register" asp-controller="Account" class="auth-tab" role="tab" aria-selected="false">Register</a>
                </nav>

                <!-- Inline Alerts: Success Message -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="auth-alert auth-alert-success" role="alert">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                        <span>@TempData["SuccessMessage"]</span>
                    </div>
                }

                <!-- Inline Alerts: Model-Level Error Summary -->
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="auth-alert auth-alert-danger" role="alert">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                        <div asp-validation-summary="ModelOnly" class="d-inline"></div>
                    </div>
                }

                <!-- Login Form -->
                <form asp-action="Login" 
                      asp-controller="Account" 
                      asp-route-returnUrl="@ViewData["ReturnUrl"]" 
                      method="post" 
                      id="loginForm" 
                      novalidate>
                    @Html.AntiForgeryToken()

                    <!-- Email or Username Field with Input Icon Wrapper -->
                    <div class="auth-form-group">
                        <label asp-for="UsernameOrEmail" class="auth-label">Email or Username</label>
                        <div class="input-icon-wrapper @(ViewData.ModelState["UsernameOrEmail"]?.Errors.Count > 0 ? "has-error" : "")" id="userWrapper">
                            <span class="input-icon" aria-hidden="true">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="4"></circle>
                                    <path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-3.92 7.94"></path>
                                </svg>
                            </span>
                            <input asp-for="UsernameOrEmail" 
                                   class="auth-input" 
                                   placeholder="name@example.com or username" 
                                   autocomplete="username" 
                                   aria-required="true" 
                                   required />
                        </div>
                        <span asp-validation-for="UsernameOrEmail" class="field-validation-error"></span>
                    </div>

                    <!-- Password Field with Input Icon Wrapper & Visibility Toggle -->
                    <div class="auth-form-group">
                        <label asp-for="Password" class="auth-label">Password</label>
                        <div class="input-icon-wrapper @(ViewData.ModelState["Password"]?.Errors.Count > 0 ? "has-error" : "")" id="pwdWrapper">
                            <span class="input-icon" aria-hidden="true">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                </svg>
                            </span>
                            <input asp-for="Password" 
                                   type="password" 
                                   class="auth-input" 
                                   id="passwordInput" 
                                   placeholder="Enter your password" 
                                   autocomplete="current-password" 
                                   aria-required="true" 
                                   required />
                            <!-- Password Reveal Button -->
                            <button type="button" 
                                    class="auth-toggle-pwd" 
                                    id="togglePasswordBtn" 
                                    title="Show/Hide Password" 
                                    aria-label="Toggle password visibility">
                                <svg id="eyeOpenIcon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                                <svg id="eyeClosedIcon" style="display: none;" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                    <line x1="1" y1="1" x2="23" y2="23"></line>
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="field-validation-error"></span>
                    </div>

                    <!-- Remember Me & Forgot Password Options -->
                    <div class="auth-options">
                        <label class="auth-remember-wrap" for="rememberMeCheckbox">
                            <input asp-for="RememberMe" id="rememberMeCheckbox" type="checkbox" class="auth-checkbox" />
                            <span>Remember me</span>
                        </label>
                        <a asp-action="ForgotPassword" asp-controller="Account" class="auth-forgot-link">Forgot password?</a>
                    </div>

                    <!-- Submit Button ("Sign In ->") -->
                    <button type="submit" class="auth-submit-btn" id="submitBtn">
                        <span>Sign In</span>
                        <span class="auth-btn-icon" aria-hidden="true">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                <polyline points="12 5 19 12 12 19"></polyline>
                            </svg>
                        </span>
                    </button>
                </form>
            </div>

            <!-- Card Bottom Action: Continue as Guest -->
            <footer class="auth-card-footer">
                <form asp-action="GuestLogin" asp-controller="Account" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="auth-guest-link">
                        <span>Continue as Guest</span>
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </button>
                </form>
            </footer>
        </main>

        <!-- Standalone Page Copyright -->
        <footer class="auth-copyright">
            &copy; 2026 Onudhabon. All rights reserved.
        </footer>
    </div>

    <!-- Conditional Popup / Modal (ViewBag.ModalMessage) -->
    @if (ViewBag.ModalMessage != null)
    {
        <div class="modal-backdrop-custom" id="conditionalModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle" tabindex="-1">
            <div class="modal-card-custom">
                <div class="modal-icon-badge">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                </div>
                <h3 class="modal-card-title" id="modalTitle">Authentication Notice</h3>
                <p class="modal-card-message">@ViewBag.ModalMessage</p>
                <button type="button" class="modal-btn-dismiss" id="dismissModalBtn">Dismiss</button>
            </div>
        </div>
    }

    <!-- Client-Side Interactions -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // 1. Password Visibility Toggle
            const toggleBtn = document.getElementById('togglePasswordBtn');
            const passwordInput = document.getElementById('passwordInput');
            const eyeOpen = document.getElementById('eyeOpenIcon');
            const eyeClosed = document.getElementById('eyeClosedIcon');

            if (toggleBtn && passwordInput) {
                toggleBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    const isPassword = passwordInput.getAttribute('type') === 'password';
                    passwordInput.setAttribute('type', isPassword ? 'text' : 'password');

                    if (isPassword) {
                        eyeOpen.style.display = 'none';
                        eyeClosed.style.display = 'inline-block';
                        toggleBtn.setAttribute('aria-label', 'Hide password');
                    } else {
                        eyeOpen.style.display = 'inline-block';
                        eyeClosed.style.display = 'none';
                        toggleBtn.setAttribute('aria-label', 'Show password');
                    }
                });
            }

            // 2. Conditional Popup Modal Dismissal
            const modalBackdrop = document.getElementById('conditionalModal');
            const dismissBtn = document.getElementById('dismissModalBtn');

            function closeModal() {
                if (modalBackdrop) {
                    modalBackdrop.style.opacity = '0';
                    modalBackdrop.style.transition = 'opacity 0.2s ease';
                    setTimeout(function () {
                        modalBackdrop.remove();
                    }, 200);
                }
            }

            if (dismissBtn) {
                dismissBtn.addEventListener('click', closeModal);
            }

            if (modalBackdrop) {
                modalBackdrop.addEventListener('click', function (e) {
                    if (e.target === modalBackdrop) {
                        closeModal();
                    }
                });

                document.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape') {
                        closeModal();
                    }
                });
            }

            // 3. Dynamic error state clearing on user typing
            const inputs = document.querySelectorAll('.auth-input');
            inputs.forEach(function (input) {
                input.addEventListener('input', function () {
                    const wrapper = input.closest('.input-icon-wrapper');
                    if (wrapper && wrapper.classList.contains('has-error')) {
                        wrapper.classList.remove('has-error');
                        const errorSpan = wrapper.parentElement.querySelector('.field-validation-error');
                        if (errorSpan) {
                            errorSpan.textContent = '';
                        }
                    }
                });
            });
        });
    </script>
</body>
</html>
