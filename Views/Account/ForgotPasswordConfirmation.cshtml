@{
    Layout = null;
    ViewData["Title"] = "Reset Link Sent - Onudhabon";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/png" href="~/images/tab_logo.png" asp-append-version="true" />
    <link rel="shortcut icon" type="image/png" href="~/images/tab_logo.png" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/images/tab_logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <style>
        .icon-badge {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #dcfce7 0%, #bbf7d0 100%);
            color: #16a34a;
            margin-bottom: 16px;
        }
    </style>
</head>
<body>
    <div class="login-page-container">
        <div class="login-card" style="max-width: 460px;">
            <!-- Logo Section -->
            <div class="logo-section">
                <a asp-controller="Home" asp-action="Index" class="logo-link">
                    <img src="~/images/login_logo.png" asp-append-version="true" alt="Onudhabon Logo" class="logo-icon" />
                </a>
                <h1 class="app-title">Onudhabon</h1>
                <div class="subtitle">Exploring Education</div>
            </div>

            <div class="px-4 pt-1 pb-4 text-center">
                <div class="icon-badge shadow-sm">
                    <svg width="36" height="36" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                </div>

                <h3 class="fw-bold text-dark mb-2">Check Your Email</h3>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success d-flex align-items-start gap-2 text-start rounded-3 py-2 px-3 small mb-3" role="alert">
                        <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16" class="flex-shrink-0 mt-0">
                            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                        </svg>
                        <span>@TempData["SuccessMessage"]</span>
                    </div>
                }

                <p class="text-secondary small mb-3" style="line-height: 1.6;">
                    If an account exists for the email you entered, you'll receive a password reset link shortly. 
                    The link will be valid for <strong>1 hour</strong>.
                </p>

                <div class="p-3 rounded-3 border mb-3" style="background-color: #f8fafc;">
                    <div class="d-flex align-items-start gap-2 text-start">
                        <svg width="18" height="18" fill="none" stroke="#64748b" stroke-width="2" viewBox="0 0 24 24" class="flex-shrink-0 mt-0">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span class="text-muted small">Don't see the email? Check your spam or junk folder. Make sure you entered the correct email address.</span>
                    </div>
                </div>

                <div class="d-flex flex-column gap-2">
                    <a asp-controller="Account" asp-action="Login" class="btn-submit text-decoration-none">
                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
                        </svg>
                        <span>Return to Sign In</span>
                    </a>
                </div>

                <div class="mt-3 pt-2 border-top">
                    <a asp-controller="Account" asp-action="ForgotPassword" class="text-decoration-none small text-secondary">
                        Didn't receive the email? Try again
                    </a>
                </div>
            </div>
        </div>

        <div class="fixed-bottom-copyright">
            &copy; @DateTime.Now.Year Onudhabon. All rights reserved.
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
